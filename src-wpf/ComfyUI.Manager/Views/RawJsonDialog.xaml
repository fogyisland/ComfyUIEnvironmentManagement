<Window x:Class="ComfyUI.Manager.Views.RawJsonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitHub API 原始响应"
        Width="700" Height="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource OnSurfaceBrush}">
    <DockPanel Margin="8">
        <!-- 顶部标题 + 节点标识(让用户知道是哪个 entry 的 JSON) -->
        <Border DockPanel.Dock="Top" Padding="0,0,0,8" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="📄 GitHub API 原始响应" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="调试用 — 整段 JSON 持久化在 nodelist_details.raw_json 列。"
                           FontSize="10" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- 底部关闭按钮 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="CloseButton" Content="关闭" Click="CloseButton_Click"
                    Padding="14,4" Style="{StaticResource MaterialButton}" IsCancel="True"/>
        </StackPanel>

        <!-- 只读 JSON viewer,Consolas 等宽字体 + 双向滚动条 + 选中文本可 Ctrl+C 复制 -->
        <TextBox x:Name="JsonTextBox"
                 FontFamily="Consolas, Courier New, monospace" FontSize="11"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" AcceptsReturn="True"
                 Background="{DynamicResource BackgroundBrush}"
                 Foreground="{DynamicResource OnSurfaceBrush}"
                 BorderBrush="{DynamicResource OutlineBrush}"/>
    </DockPanel>
</Window>
