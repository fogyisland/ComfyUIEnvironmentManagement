<Window x:Class="ComfyUI.Manager.Views.FirstRunWizard.FirstRunWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ComfyUIManagement 首次配置"
        Width="700" Height="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource BackgroundBrush}">
        <!-- v1.0.0.x (2026-09-05):wizard 跟随主题 ——
             用户原话"当处于暗黑模式的时候 wizard 也必须是暗黑,否则设置看不清"。
             Window.Background 绑 BackgroundBrush(主题色),white mode 白底,black mode #1E1E1E 黑底。
             TextBlock/TextBox/PasswordBox 已通过 Theme.xaml implicit style 绑主题色,
             这里再设 Window Background 完整覆盖。 -->
    <Window.Resources>
        <!-- Step indicator bold via DataTrigger(用 SemiBold 兜底避免编译期 converter 缺失)-->
        <Style x:Key="StepLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <!-- v1.0.0.x (2026-09-03) T34:每个 path 字段的 hint label 样式 ——
             小号字 + 浅色,显示「为什么是这个目录」(从 VM property doc comment 镜像) -->
        <Style x:Key="PathHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Step indicator -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="① 欢迎">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource StepLabelStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWelcome}" Value="True">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="→  ② Python / Git">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource StepLabelStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPythonGit}" Value="True">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="→  ③ Envs/Nodes">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource StepLabelStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaths1EnvNodes}" Value="True">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="→  ④ Models/Workflows">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource StepLabelStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaths2ModelsWorkflows}" Value="True">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="→  ⑤ Templates/Log">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource StepLabelStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaths3SystemLog}" Value="True">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="→  ⑥ 完成">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource StepLabelStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConfirm}" Value="True">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- Step content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- Step 1: Welcome -->
                <StackPanel Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="欢迎使用 ComfyUIManagement"
                               FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
                        这是首次启动,请设置安装根目录(ComfyUIManagement 把环境、模型、节点数据放在这里)。
                    </TextBlock>
                    <TextBlock Text="安装根目录:" Margin="0,8,0,4"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="浏览..."
                                Margin="6,0,0,0" Padding="10,4"
                                Click="OnBrowseInstallPath"/>
                        <TextBox Text="{Binding InstallPath, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <!-- v1.0.0.x (2026-09-05):绿色软件路径提示 — 默认已填 program 所在目录,
                         用户确认路径正确后才能 Next。如果用户从压缩包解压后搬了文件夹,默认路径
                         可能已失效(原地址变 broken symlink / 旧路径),红色提示要求核对一下。 -->
                    <TextBlock Text="请确认当前的程序运行是否正确"
                               Foreground="Red" FontWeight="SemiBold"
                               Margin="0,8,0,4" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- v1.0.0.x (2026-09-05) Step 2: Python + Git 合并到一个页面
                     用户原话"在第二步骤写入 python /git 两个步骤 否则容易造成用户误解"。
                     两个 runtime 工具(解释器 + 版本控制)同一页面更直观,用户一次确认两个 path。
                     IsPythonGit = CurrentStep == PythonGit。 -->
                <StackPanel Visibility="{Binding IsPythonGit, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="配置 Python 解释器与 Git 程序"
                               FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
                        Python 用于创建环境,Git 用于克隆 ComfyUI 模板源码。两者默认都自动算到程序目录下(Embeded/python、Embeded/git-portable),确认或 Browse 改。
                    </TextBlock>

                    <!-- Python 子节 -->
                    <TextBlock Text="Python 解释器路径:" FontWeight="SemiBold" Margin="0,8,0,4"/>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="浏览..."
                                Margin="6,0,0,0" Padding="10,4"
                                Click="OnBrowsePythonPath"/>
                        <TextBox Text="{Binding PythonPath, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <TextBlock Margin="0,0,0,12">
                        <Run Text="Python 状态: "/>
                        <Run Text="{Binding IsPythonValid, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>

                    <!-- Git 子节 -->
                    <TextBlock Text="Git 程序路径(留空走系统 PATH):" FontWeight="SemiBold" Margin="0,8,0,4"/>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="浏览..."
                                Margin="6,0,0,0" Padding="10,4"
                                Click="OnBrowseGitPath"/>
                        <TextBox Text="{Binding GitPath, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <TextBlock Margin="0,0,0,4">
                        <Run Text="Git 状态: "/>
                        <Run Text="{Binding IsGitValid, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>

                <!-- v1.0.0.x (2026-09-03) T34:Step 3 Envs + Nodes(4 个 path) -->
                <StackPanel Visibility="{Binding IsPaths1EnvNodes, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="环境与节点目录"
                               FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
                        这 4 个目录管理「用户创建的环境 + 节点」。每个 path 留默认即可,稍后可在 Settings 改。
                    </TextBlock>

                    <TextBlock Text="EnvsDir" FontWeight="SemiBold"/>
                    <TextBlock Text="用户创建的 env 根目录,每个 env 一个子目录。EnvCreatorService 在这创建 env。"
                               Style="{StaticResource PathHintStyle}"/>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="浏览..."
                                Margin="6,0,0,0" Padding="10,4"
                                Click="OnBrowseEnvsDir"/>
                        <TextBox Text="{Binding EnvsDir, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>

                    <TextBlock Text="GlobalNodesDir" FontWeight="SemiBold"/>
                    <TextBlock Text="全局已下载节点存储,供 env 间共享(Catalog 下载 default target)。"
                               Style="{StaticResource PathHintStyle}"/>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="浏览..."
                                Margin="6,0,0,0" Padding="10,4"
                                Click="OnBrowseGlobalNodesDir"/>
                        <TextBox Text="{Binding GlobalNodesDir, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>

                    <TextBlock Text="LocalNodeDirectory" FontWeight="SemiBold"/>
                    <TextBlock Text="Catalog 单节点下载 default(单 node 模式)。跟 LocalNodesDirectory(批量)区分。"
                               Style="{StaticResource PathHintStyle}"/>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="浏览..."
                                Margin="6,0,0,0" Padding="10,4"
                                Click="OnBrowseLocalNodeDirectory"/>
                        <TextBox Text="{Binding LocalNodeDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>

                    <TextBlock Text="LocalNodesDirectory" FontWeight="SemiBold"/>
                    <TextBlock Text="本地常用节点批量安装的源(env 行「装本地常用」按钮)。EnvListVM.InstallLocalNodesCommand 复制源。"
                               Style="{StaticResource PathHintStyle}"/>
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="浏览..."
                                Margin="6,0,0,0" Padding="10,4"
                                Click="OnBrowseLocalNodesDirectory"/>
                        <TextBox Text="{Binding LocalNodesDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                </StackPanel>

                <!-- v1.0.0.x (2026-09-03) T34:Step 4 Models + Workflows(2 个 path) -->
                <StackPanel Visibility="{Binding IsPaths2ModelsWorkflows, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="模型与工作流目录"
                               FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
                        模型是 env-create 时的 junction 挂载点 + ModelMarketplace 下载 target;Workflow 是 env-start 后 fire-and-forget 同步目的地。
                    </TextBlock>

                    <TextBlock Text="DefaultModelsDirectory" FontWeight="SemiBold"/>
                    <TextBlock Text="env-create junction 挂载点 + ModelMarketplace 下载 default。user extra_model_paths.yaml 也从这读。"
                               Style="{StaticResource PathHintStyle}"/>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="浏览..."
                                Margin="6,0,0,0" Padding="10,4"
                                Click="OnBrowseDefaultModelsDirectory"/>
                        <TextBox Text="{Binding DefaultModelsDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>

                    <TextBlock Text="WorkflowsDirectory" FontWeight="SemiBold"/>
                    <TextBlock Text="env-start 后 fire-and-forget 同步到的 user/default/workflows/。WorkflowMarketplace 下载 default。"
                               Style="{StaticResource PathHintStyle}"/>
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="浏览..."
                                Margin="6,0,0,0" Padding="10,4"
                                Click="OnBrowseWorkflowsDirectory"/>
                        <TextBox Text="{Binding WorkflowsDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                </StackPanel>
                    <!-- v1.0.0.x (2026-09-05) feat/nodelist-redesign:节点列表目录 -->
                    <TextBlock Text="NodelistDirectory" FontWeight="SemiBold"/>
                    <TextBlock Text="含 custom-node-list.json 的根目录。下载的默认仓库 + 增量入库的源都在这里。"
                               Style="{StaticResource PathHintStyle}"/>
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="浏览..."
                                Margin="6,0,0,0" Padding="10,4"
                                Click="OnBrowseNodelistDirectory"/>
                        <TextBox Text="{Binding NodelistDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialTextBox}"/>
                    </DockPanel>

                <!-- v1.0.0.x (2026-09-03) T34:Step 5 System Template + Log(2 个 path) -->
                <StackPanel Visibility="{Binding IsPaths3SystemLog, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="系统模板与日志目录"
                               FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
                        系统模板是 git clone 下来的 ComfyUI / Forge / OpenVoice 等源码;日志目录是 env-start 状态面板的日志文件父目录。
                    </TextBlock>

                    <TextBlock Text="SystemTemplateLibraryDir" FontWeight="SemiBold"/>
                    <TextBlock Text="clone 下来的模板源码(ComfyUI / Forge / OpenVoice 等)存这。TemplateSourceUpdater 走它。"
                               Style="{StaticResource PathHintStyle}"/>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="浏览..."
                                Margin="6,0,0,0" Padding="10,4"
                                Click="OnBrowseSystemTemplateLibraryDir"/>
                        <TextBox Text="{Binding SystemTemplateLibraryDir, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>

                    <TextBlock Text="LogDirectory" FontWeight="SemiBold"/>
                    <TextBlock Text="日志父目录,EnvStartStatus 日志写 Logs/&lt;envId&gt;.log。SettingsDefaults.Apply 自动建 Logs/。"
                               Style="{StaticResource PathHintStyle}"/>
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="浏览..."
                                Margin="6,0,0,0" Padding="10,4"
                                Click="OnBrowseLogDirectory"/>
                        <TextBox Text="{Binding LogDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                </StackPanel>

                <!-- Step 6: Confirm -->
                <StackPanel Visibility="{Binding IsConfirm, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="即将完成配置"
                               FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                        请确认以下设置,完成后 ComfyUIManagement 将启动主界面。空字段会用内置默认 seed。
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0">
                        <Run Text="安装根目录: "/><Run Text="{Binding InstallPath, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0">
                        <Run Text="Python 解释器: "/><Run Text="{Binding PythonPath, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0">
                        <Run Text="EnvsDir: "/><Run Text="{Binding EnvsDir, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0">
                        <Run Text="LogDirectory: "/><Run Text="{Binding LogDirectory, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Nav buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="80" Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"/>
            <Button Content="上一步" Width="80" Margin="0,0,8,0"
                    Command="{Binding BackCommand}"/>
            <Button Content="下一步" Width="80" Margin="0,0,8,0"
                    Command="{Binding NextCommand}"/>
            <Button Content="完成" Width="80"
                    Command="{Binding FinishCommand}"/>
        </StackPanel>
    </Grid>
</Window>
