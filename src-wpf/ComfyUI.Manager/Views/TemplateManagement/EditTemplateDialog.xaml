<Window x:Class="ComfyUI.Manager.Views.TemplateManagement.EditTemplateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ComfyUI.Manager.ViewModels"
        Title="编辑模板"
        Width="600" Height="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <!-- v1.0.0 T10 note: G12 (built-in Kind=ReadOnly when editing existing) is
         deferred to T12 polish. The ComboBox below is always editable in T10;
         the CanSave validator + duplicate-kind check in EditTemplateDialogViewModel
         prevents bad data. T12 will bind IsReadOnly to Mode + IsBuiltIn flag. -->
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Margin" Value="0,8,0,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="名称" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Kind (内置 ComfyUI / A1111 只读)" Style="{StaticResource LabelStyle}"/>
                <ComboBox IsEditable="True"
                          Text="{Binding Kind, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBoxItem Content="ComfyUI"/>
                    <ComboBoxItem Content="A1111"/>
                </ComboBox>

                <TextBlock Text="模板源目录 (项目相对路径或绝对路径)" Style="{StaticResource LabelStyle}"/>
                <DockPanel>
                    <Button Content="浏览..." DockPanel.Dock="Right" Margin="4,0,0,0"
                            Click="BrowseLocalSourceDir_Click"/>
                    <TextBox Text="{Binding LocalSourceDir, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>

                <TextBlock Text="启动脚本" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding EntryScript, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="启动参数 (支持 {port} 占位符)" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding EntryArgs, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="60"/>

                <TextBlock Text="模型子目录" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding ModelsSubdir, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="用户附加参数 (启动时附加)" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding UserExtraArgs, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="60"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Width="80" Margin="0,0,8,0"
                    IsCancel="True" Click="Cancel_Click"/>
            <Button Content="保存" Width="80"
                    Command="{Binding SaveCommand}"
                    IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
