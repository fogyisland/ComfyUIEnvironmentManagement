<Window x:Class="ComfyUI.Manager.Views.TemplateManagement.EditTemplateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ComfyUI.Manager.ViewModels"
        xmlns:models="clr-namespace:ComfyUI.Manager.Models"
        Title="编辑模板"
        Width="600" Height="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <!-- Spec §5/§9 G12: ComboBox.IsEditable 绑 VM 的 IsKindEditable —
         Add 模式始终可编辑;Edit built-in 模板(ComfyUI)时禁止改 Kind,
         防止用户改坏 ComfyUI env 的 entry-script/launcher logic。
         v1.0.0.x: A1111 模板已下线,Kind 选项只剩 ComfyUI。 -->

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Margin" Value="0,8,0,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="名称" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding KindReadOnlyHint}"
                               Foreground="{DynamicResource OutlineBrush}"
                               VerticalAlignment="Center" Margin="8,8,0,0"
                               FontStyle="Italic"/>
                    <TextBlock Text="Kind (内置 ComfyUI 只读)" Style="{StaticResource LabelStyle}"/>
                </DockPanel>
                <ComboBox IsEditable="{Binding IsKindEditable}"
                          Text="{Binding Kind, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBoxItem Content="ComfyUI"/>
                </ComboBox>

                <TextBlock Text="模板来源类型" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="SourceKindCombo"
                          SelectionChanged="SourceKindCombo_SelectionChanged">
                    <ComboBoxItem Content="本地目录" Tag="{x:Static models:TemplateSourceKind.Local}"/>
                    <ComboBoxItem Content="GitHub 仓库" Tag="{x:Static models:TemplateSourceKind.GitHub}"/>
                </ComboBox>

                <!-- Local mode: LocalSourceDir + Browse -->
                <StackPanel Visibility="{Binding SourceKind, Converter={StaticResource EnumEqualsVisibility}, ConverterParameter=Local}">
                    <TextBlock Text="模板源目录 (项目相对路径或绝对路径)" Style="{StaticResource LabelStyle}"/>
                    <DockPanel>
                        <Button Content="浏览..." DockPanel.Dock="Right" Margin="4,0,0,0"
                                Click="BrowseLocalSourceDir_Click"/>
                        <TextBox Text="{Binding LocalSourceDir, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                </StackPanel>

                <!-- GitHub mode: GitHubRepoUrl + readonly LocalSourceDir preview -->
                <StackPanel Visibility="{Binding SourceKind, Converter={StaticResource EnumEqualsVisibility}, ConverterParameter=GitHub}">
                    <TextBlock Text="GitHub 仓库 URL (http/https/git@)" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding GitHubRepoUrl, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="本地目录 (自动从 URL 派生,只读)" Margin="0,8,0,4" FontStyle="Italic"/>
                    <TextBox Text="{Binding LocalSourceDir, Mode=OneWay}" IsReadOnly="True" Background="#F0F0F0"/>
                </StackPanel>

                <!-- v1.0.0.x: Meta 元数据手动编辑 — 每行 key=value,空 value 允许,
                     没 = 的行忽略。常见 key: category/description/author/repo/notes。
                     TextBox 高度 5 行,AcceptsReturn=True 允许回车换行。 -->
                <TextBlock Text="Meta 元数据 (每行 key=value,空行忽略)" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding MetaRaw, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="Consolas" FontSize="12"
                         MinHeight="100" MaxHeight="160"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         ToolTip="每行一个 key=value,例如:&#xa;category=图像生成&#xa;description=描述文本&#xa;author=作者名"/>

                <!-- v1.0.0.x simplification: 启动脚本/启动参数/模型子目录/用户附加参数 已从此对话框移除。
                     这些字段保留在 TemplateConfig 数据模型(已有 settings.json entry_script/entry_args/
                     models_subdir/user_extra_args 仍可被 EnvCreator/ProcessLauncher/ModelSymlinker 读取),
                     只是 UI 不可编辑。如需修改,请直接编辑 settings.json 或后续版本提供高级模式。 -->
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Width="80" Margin="0,0,8,0"
                    IsCancel="True" Click="Cancel_Click"/>
            <Button Content="保存" Width="80"
                    Command="{Binding SaveCommand}"
                    IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
