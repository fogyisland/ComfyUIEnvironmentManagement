<UserControl x:Class="ComfyUI.Manager.Views.TemplateManagement.TemplateManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ComfyUI.Manager.ViewModels"
             xmlns:controls="clr-namespace:ComfyUI.Manager.Controls"
             xmlns:models="clr-namespace:ComfyUI.Manager.Models"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:TemplateManagementViewModel}">
    <!--
    v1.0.0.x: 加底部 Console 面板 — 镜像 v0.6.18.4 BulkUpdateView 风格
    (SurfaceBrush/OutlineBrush/CornerRadius 6 + Consolas monospace + ✕ 关闭)。
    显示当前下载/更新的 git clone stdout 实时输出。
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="模板管理" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Content="+ 添加模板" DockPanel.Dock="Right"
                    Command="{Binding AddCommand}"
                    HorizontalAlignment="Right"/>
        </DockPanel>

        <!-- Card list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Templates}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="12" CornerRadius="6"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="1"
                                Background="{DynamicResource SurfaceBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Row 0: Name + SourceKindBadge + LocalDirMissing badge + Verified badge (single line, full width) -->
                                <DockPanel Grid.Row="0" Grid.Column="0">
                                    <!-- v1.0.0.x (2026-08-31): 「已验证 可运行」绿色 ✓ badge ——
                                         项目方 end-to-end 验证过的模板(目前只 ComfyUI / Forge)。
                                         Verified=true 才显示;项目方 only,EditTemplateDialog 不暴露
                                         Checkbox(用户决策 AskUserQuestion 2026-08-31)。
                                         SuccessBrush 已在 Palette.Light.xaml #2E7D32 / Dark.xaml #4CAF50
                                         主题感知(对比 amber #F59E0B 是硬编码)。DockPanel.Dock="Right"
                                         第一个声明 → 最右边,跟 amber badge / "[GitHub]" 并排 -->
                                    <Border DockPanel.Dock="Right" Margin="6,0,0,0"
                                            Padding="6,2" CornerRadius="3"
                                            Background="{DynamicResource SuccessBrush}"
                                            Visibility="{Binding Verified, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                                            ToolTip="项目方已验证此模板可正常运行(env-create + 启动 + 接口可达)">
                                        <TextBlock Text="✓ 已验证 可运行" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                    <!-- v1.0.0.x:本地目录状态 — GitHub 模板(Whisper / CoquiTTS / Bark)
                                         首次使用前没 git clone 时显琥珀色 badge 提醒用户点 「下载与更新」。
                                         SourceKindBadge 之前。v1.0.0.x #630: 颜色 #D32F2F 红 →
                                         #F59E0B 琥珀 — "未下载" 不是错误,红色让用户误以为坏了。 -->
                                    <Border DockPanel.Dock="Right" Margin="6,0,0,0"
                                            Padding="6,2" CornerRadius="3"
                                            Background="#F59E0B"
                                            Visibility="{Binding LocalDirMissing, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                                            ToolTip="模板源码未下载 — 点「下载与更新」按钮把源码 git clone 到本地">
                                        <TextBlock Text="{x:Static models:TemplateConfig.LocalDirBadgeHint}"
                                                   Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SourceKindBadge}" Margin="8,0,0,0"
                                               FontSize="12" Foreground="{DynamicResource OutlineBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>

                                <!-- Row 1: Kind -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4,0,0">
                                    <Run Text="Kind: "/><Run Text="{Binding Kind}"/>
                                </TextBlock>
                                <!-- Row 2: Source -->
                                <TextBlock Grid.Row="2" Grid.Column="0">
                                    <Run Text="Source: "/><Run Text="{Binding LocalSourceDir}"/>
                                </TextBlock>
                                <!-- Row 3: Entry -->
                                <TextBlock Grid.Row="3" Grid.Column="0">
                                    <Run Text="Entry: "/><Run Text="{Binding EntryScript}"/><Run Text=" "/><Run Text="{Binding EntryArgs}"/>
                                </TextBlock>
                                <!-- Row 4: Models -->
                                <TextBlock Grid.Row="4" Grid.Column="0">
                                    <Run Text="Models: "/><Run Text="{Binding ModelsSubdir}"/>
                                </TextBlock>

                                <!-- v1.0.0.x hotfix: 改 Row 5 分隔 + 4 按钮一行,避免横向溢出导致
                                     buttons 渲染在 1300px 窗口右外侧(UIA 仍能 report 但视觉 + 鼠标点击拿不到)。
                                     用 WrapPanel 横排,4 个按钮总宽 ≈ 313px 完全容得下,Window 改大也不会溢出。
                                     Margin 12,8,0,8 让按钮组跟上方文本分隔但贴左边,UI 更紧凑 -->
                                <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="下载与更新" Margin="0,0,4,0" Padding="8,4"
                                            ToolTip="目标目录不存在则 git clone,存在则 wipe + clone (相当于 git pull)。只动源码,不涉及 env/node。"
                                            Visibility="{Binding CanUpdateSource, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.DownloadOrUpdateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="更新源码" Margin="0,0,4,0" Padding="8,4"
                                            ToolTip="仅 wipe + clone (相当于 git pull)。如果目标目录不存在,会报错 — 用「下载与更新」替代。"
                                            Visibility="{Binding CanUpdateSource, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.UpdateSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="编辑" Margin="0,0,4,0" Padding="8,4"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="删除" Margin="0" Padding="8,4"
                                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- v1.0.0.x #590: Console 面板抽取到 Controls/ConsolePanel.xaml — terminal 深灰底浅字风格。
             IsConsoleVisible 绑 VM 三态:!_userHiddenConsole && ConsoleLog.Count > 0。
             新点击模板时 _userHiddenConsole 复位 false → 面板自动出现;用户点 ✕ 后
             ClearConsoleLog() 清空 + 设 _userHiddenConsole=true → 面板隐藏。
             Auto-scroll 由 ConsolePanel 内部订阅 Lines.CollectionChanged → ScrollToEnd。 -->
        <controls:ConsolePanel Grid.Row="2" Margin="0,8,0,0"
                               Lines="{Binding ConsoleLog}"
                               Title="Console"
                               ConsoleCloseRequested="OnConsoleCloseRequested"
                               Visibility="{Binding IsConsoleVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
    </Grid>
</UserControl>
