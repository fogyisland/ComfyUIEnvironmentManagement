<UserControl x:Class="ComfyUI.Manager.Views.ModelMarketplaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ComfyUI.Manager.ViewModels"
             xmlns:models="clr-namespace:ComfyUI.Manager.Models"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ModelMarketplaceViewModel}"
             Background="{DynamicResource WindowBackgroundBrush}">
  <!--
    v0.6.20 T8:模型市场 view — 镜像 v0.6.19 WorkflowMarketplaceView toolbar / filter chips /
    card grid / console 4-row 布局,卡片内容 = ModelEntry (title + Kind badge pill +
    NsfwKind badge pill + per-version CheckBox 多选)。

    DataContext 由 MainViewModel 在 section 切换时绑成 ModelMarketplaceViewModel。
    3 个 T7 converter (`ModelKindBadgeBrush` / `ModelNsfwBadgeBrush` / `ModelNsfwBadgeText`)
    在 Theme.xaml 注册为 StaticResource,view 必须放在 Application.Resources 加载后
    (StaFact 内 WpfTestResources.EnsureLoaded 链路)。

    Filter chips 用 Click event (而不是 IsChecked 双向绑) — 原因:KindFilters ObservableCollection
    项是 ModelKind enum 值,转换 IsChecked TwoWay 走 IValueConverter.ConvertBack 时
    需要"当前 IsChecked bool + 哪个 kind"哪个信息,DataTrigger 在 ItemsControl 场景
    难以干净拉到。Code-behind 一行 Click handler 跟 enum tag 直接绑 — 更简单。
  -->
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- header "模型下载" -->
      <RowDefinition Height="Auto"/>  <!-- search row:搜索框 + 搜索按钮 + 下载选中 + 选中数 -->
      <RowDefinition Height="Auto"/>  <!-- filter strip:kind chips + source radio -->
      <RowDefinition Height="Auto"/>  <!-- v0.6.22+:sort + period filter chips(CivitAI only,HF 隐藏) -->
      <RowDefinition Height="Auto"/>  <!-- v0.6.22+:baseModel chip strip(CivitAI only,HF 隐藏) -->
      <RowDefinition Height="*"/>     <!-- card grid -->
      <RowDefinition Height="Auto"/>  <!-- console -->
    </Grid.RowDefinitions>

    <!-- v0.6.22+:header "模型下载" — 大字标题,让用户一眼看清当前 view 的用途。
         前置背景无 card,简单 TextBlock + 字号 20 Bold + OnSurfaceBrush 即可。-->
    <TextBlock Grid.Row="0" Text="模型下载"
               FontSize="20" FontWeight="Bold"
               Margin="0,0,0,10"
               Foreground="{DynamicResource OnSurfaceBrush}" />

    <!-- v0.6.22+:Search row — 整条操作栏从左到右:[搜索框] [搜索] [下载选中] [选中:N 贴右] [加载更多] [已加载:N]。
         之前用 DockPanel LastChildFill=True + 全 Dock=Right,TextBox 作为 last child
         撑满剩余空间 + Width=360 限制 → 视觉上 TextBox 虽在最左但 Margin="8,0,0,0" 偏 8px,
         中间大片空白 + 按钮贴右远,读起来不像个整体操作条(用户 2026-08-20 反馈
         "搜索框不是左对齐,界面有些问题")。
         改成 StackPanel Horizontal 顺序排列 → TextBox 贴 position(0,0),按钮紧跟其后,
         选中:N 用 DockPanel.Dock=Right 推到最右,左右对齐都明确。
         取消 刷新 按钮(用户 2026-08-20 反馈"刷新在这里看不懂作用")。
         Per-source "使用代理" CheckBox 已删除(proxy 走 Settings 页统一管理)。
         加载更多 + 已加载计数 是 v0.6.22+ 新增的分页 UI(用户 2026-08-20 反馈
         "针对分页的数据是否有做")。-->
    <DockPanel Grid.Row="1" Margin="0,0,0,8">
      <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
        <Run Text="选中: " />
        <Run Text="{Binding SelectedVersions.Count, Mode=OneWay}" FontWeight="Bold" />
      </TextBlock>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBox Width="360"
                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                 VerticalContentAlignment="Center"
                 Background="{DynamicResource SurfaceBrush}"
                 BorderBrush="{DynamicResource OutlineBrush}"
                 BorderThickness="1"
                 ToolTip="输入模型名称,按 Enter 或点右侧 搜索 按钮">
          <TextBox.InputBindings>
            <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
          </TextBox.InputBindings>
        </TextBox>
        <Button Content="搜索"
                Command="{Binding SearchCommand}"
                Margin="8,0,0,0" Padding="14,4" />
        <Button Content="下载选中"
                Command="{Binding DownloadSelectedCommand}"
                Margin="8,0,0,0" Padding="14,4" />
        <!-- v0.6.22+:页码式分页 — 上一页走本地缓存,下一页缓存到底时自动补拉一页。
             页数按「筛选后」的条数算:勾 kind chip / 关 NSFW 会立刻重算页数并跳回第 1 页。-->
        <Button Content="« 上一页"
                Command="{Binding PrevPageCommand}"
                Margin="12,0,0,0" Padding="12,4"
                ToolTip="回到上一页(本地缓存,不重新请求)" />
        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0"
                   Foreground="{DynamicResource OnSurfaceBrush}" FontSize="12">
          <Run Text="第 " />
          <Run Text="{Binding CurrentPageNumber, Mode=OneWay}" FontWeight="Bold" />
          <Run Text=" / " />
          <Run Text="{Binding TotalPages, Mode=OneWay}" />
          <Run Text=" 页" />
        </TextBlock>
        <Button Content="下一页 »"
                Command="{Binding NextPageCommand}"
                Margin="8,0,0,0" Padding="12,4"
                ToolTip="下一页(缓存不足时自动向来源多拉一页)" />
        <!-- 筛选后的条数 — 跟页数同源,勾筛选后跟着变小。-->
        <TextBlock VerticalAlignment="Center" Margin="12,0,0,0"
                   Foreground="{DynamicResource OutlineBrush}" FontSize="11">
          <Run Text="共 " />
          <Run Text="{Binding TotalFilteredCount, Mode=OneWay}" />
          <Run Text=" 条" />
        </TextBlock>
        <!-- v0.6.22+:Console 显隐 toggle 按钮 — 已隐藏时显示 "显示 Console",可见时显示 "隐藏 Console"。
             让用户在 ✕ 后还能再开(之前 ✕ 后只能等下次 RefreshAsync 重置 _userHiddenConsole)。
             用户 2026-08-20 反馈"Console 在这个界面也是需要可以隐藏"。-->
        <Button Content="Console"
                Command="{Binding ToggleConsoleVisibilityCommand}"
                Margin="12,0,0,0" Padding="14,4"
                ToolTip="显示 / 隐藏 Console 面板(跟 ✕ 等价,但能再开)" />
      </StackPanel>
    </DockPanel>

    <!-- v0.6.22+:类型筛选 row — kind chips + source 单选 radio + NSFW 过滤 CheckBox。
         Source radio 保留(功能必要),per-source "使用代理" CheckBox 已删除。
         NSFW 过滤 CheckBox 位于 kind chips 后、source radio 前(用户 2026-08-20 反馈)。
         Proxy 设置改走 Settings → 模型市场 段。-->
    <DockPanel Grid.Row="2" Margin="0,0,0,8" LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="源" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold" />
        <RadioButton Content="CivitAI" GroupName="ActiveSource"
                     Tag="{x:Static models:ModelSourceKind.CivitAi}"
                     IsChecked="{Binding ActiveSource, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=CivitAi}"
                     Click="OnSourceRadioClicked"
                     Margin="4,0,0,0" VerticalAlignment="Center" />
        <RadioButton Content="HuggingFace" GroupName="ActiveSource"
                     Tag="{x:Static models:ModelSourceKind.HuggingFace}"
                     IsChecked="{Binding ActiveSource, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=HuggingFace}"
                     Click="OnSourceRadioClicked"
                     Margin="12,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
      <ItemsControl x:Name="KindFilterHost" ItemsSource="{Binding KindFilters}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ToggleButton x:Name="KindChip" Content="{Binding}" Margin="2" Padding="8,4"
                          Tag="{Binding}"
                          Click="OnKindChipClicked" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <!-- v0.6.22+:NSFW 过滤 CheckBox — 默认勾选(显示全部),取消勾选 = 只显示 SFW。
           位置在 kind chips 末尾之后(分隔 8px margin),跟 source radio 区分开。-->
      <CheckBox Content="显示 NSFW"
                IsChecked="{Binding IncludeNsfw}"
                Margin="12,0,0,0" VerticalAlignment="Center"
                ToolTip="取消勾选只显示 SFW 模型(Mature/NSFW 隐藏)" />
    </DockPanel>

    <!-- v0.6.22+:Sort + Period filter row — CivitAI API 参数(用户 2026-08-20 反馈
         "搜索似乎只传关键词")。HF source 不支持这两个参数,整行 Visibility 折叠。
         两段 chip strip:左 "排序"(5 个 sort 选项)+ "时间窗"(5 个 period 选项)。
         chip 风格跟 kind chips 一致(ToggleButton 群组单选语义) — 用 Click handler
         直接 set VM.ActiveSort/ActivePeriod,setter 自动 fire-and-forget RefreshAsync。
         选中状态通过 DataTrigger 高亮(IsChecked + ActiveSort 比较)。-->
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8"
                Visibility="{Binding ActiveSource, Converter={StaticResource EnumEqualsVisibility},
                                     ConverterParameter=CivitAi}">
      <TextBlock Text="排序" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold" />
      <ItemsControl x:Name="SortFilterHost" ItemsSource="{Binding SortOptions}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ToggleButton x:Name="SortChip" Content="{Binding}" Margin="2" Padding="8,4"
                          Tag="{Binding}"
                          Click="OnSortChipClicked">
              <ToggleButton.Style>
                <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                  <Style.Triggers>
                    <DataTrigger Value="True">
                      <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource EnumEqualsMultiConverter}">
                          <Binding />
                          <Binding Path="DataContext.ActiveSort"
                          RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        </MultiBinding>
                      </DataTrigger.Binding>
                      <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                      <Setter Property="Foreground" Value="White" />
                      <Setter Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ToggleButton.Style>
            </ToggleButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="时间窗" VerticalAlignment="Center" Margin="16,0,8,0" FontWeight="Bold" />
      <ItemsControl x:Name="PeriodFilterHost" ItemsSource="{Binding PeriodOptions}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ToggleButton x:Name="PeriodChip" Content="{Binding}" Margin="2" Padding="8,4"
                          Tag="{Binding}"
                          Click="OnPeriodChipClicked">
              <ToggleButton.Style>
                <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                  <Style.Triggers>
                    <DataTrigger Value="True">
                      <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource EnumEqualsMultiConverter}">
                          <Binding />
                          <Binding Path="DataContext.ActivePeriod"
                          RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        </MultiBinding>
                      </DataTrigger.Binding>
                      <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                      <Setter Property="Foreground" Value="White" />
                      <Setter Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ToggleButton.Style>
            </ToggleButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- v0.6.22+:BaseModel chip strip — CivitAI 专用(用户 2026-08-20 反馈"模型参数是不是
         也可以传递?也就是 base model 列出常规可用的 Model 类型")。HF source 不支持 baseModel
         API 参数,整行 Visibility 折叠;切到 CivitAI 时显示 21 个常用 baseModel chip
         (SD 1.5 / SDXL / Flux / Pony / SD 3.5 / Wan Video ...)。WrapPanel 让选项过多时自动
         换行(2-3 行)。chip 风格跟 sort/period 一致(ToggleButton 单选 + DataTrigger 高亮)。
         默认 "All" 选中表示不过滤(不附加 baseModels= URL 参数);切到具体 baseModel 触发
         setter 自动 fire-and-forget RefreshAsync。-->
    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8"
                Visibility="{Binding ActiveSource, Converter={StaticResource EnumEqualsVisibility},
                                     ConverterParameter=CivitAi}">
      <TextBlock Text="基础模型" VerticalAlignment="Top" Margin="0,4,8,0" FontWeight="Bold" />
      <ItemsControl x:Name="BaseModelFilterHost" ItemsSource="{Binding BaseModelOptions}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel MaxWidth="1000" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ToggleButton x:Name="BaseModelChip" Content="{Binding}" Margin="2" Padding="8,4"
                          Tag="{Binding}"
                          Click="OnBaseModelChipClicked">
              <ToggleButton.Style>
                <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                  <Style.Triggers>
                    <DataTrigger Value="True">
                      <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource EnumEqualsMultiConverter}">
                          <Binding />
                          <Binding Path="DataContext.ActiveBaseModel"
                          RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        </MultiBinding>
                      </DataTrigger.Binding>
                      <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                      <Setter Property="Foreground" Value="White" />
                      <Setter Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ToggleButton.Style>
            </ToggleButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- v0.6.22++:2-per-row landscape card grid + loading overlay + empty state overlay。
         v0.6.22 T6 早期是 3-per-row portrait 340×540(用户 2026-08-20 反馈"一行 3 个,
         后面大段留白")。v0.6.22++ 反向改:landscape 540×220(2.45:1 宽高比,用户 2026-08-21
         反馈"卡片图的内容,目前存在太长的问题,实际的模型是否可以以小卡片图方式展现,
         当前卡片其实应该是宽度比高度大")。
         卡片 = Grid 2 列:左 120 缩略图 + 右 * 信息列(badges + title + author · baseModel
         + description 2 行 + 版本列表)。
         Border Width=1104 = 2 × (540 + Margin 6×2) = 2 × 552 = 1104px 固定 2 列布局。
         窗口 < 1104 时 ScrollViewer 触发水平滚动条。
         镜像 WorkflowMarketplaceView (lines 177-294) 的 3-层 overlay 结构:
         第 1 层 ScrollViewer(Border 容器)+ 第 2 层 loading 半透明黑 overlay
         + 第 3 层 empty state overlay — 后画覆盖前面。-->
    <Grid Grid.Row="5">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto"
                    IsEnabled="{Binding NotIsBusy}">
        <Border HorizontalAlignment="Center" Width="1104">
          <ItemsControl ItemsSource="{Binding Models}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type models:ModelEntry}">
                <!-- v0.6.22++:landscape card(540×220, 2.45:1 宽高比)+ 小缩略图 120×200 在左侧。
                     用户 2026-08-21 反馈"卡片图的内容,目前存在太长的问题,实际的模型是否
                     可以以小卡片图方式展现,当前卡片其实应该是宽度比高度大"——
                     把 hero 图缩成左侧小缩略图,右侧紧凑放标题/作者/简介/版本列表,
                     视觉重心从"图片 → 文字信息"。
                     Border Width=1104 = 2 × (540 + 12 margin) — 固定 2 列,窗口 ≥1104 不滚动。
                     Grid 2 列:左 120 缩略图 + 右 * 内容列。
                     ToolTip 仍显示完整 Description(hover 整个 Border)。-->
                <Border Width="540" Height="220" Margin="6" Padding="10" CornerRadius="8"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="1"
                        ToolTip="{Binding Description}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="120" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- 左:小缩略图 120×200 — 替代原来 340×200 hero 图,腾出 220 px 给文字信息列 -->
                    <Border Grid.Column="0" Height="200" CornerRadius="6"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="1">
                      <Image Source="{Binding PreviewImageUrl}" Stretch="UniformToFill" />
                    </Border>
                    <!-- 右:信息列 StackPanel,水平居左垂直居顶 -->
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                      <!-- 第 1 行:Kind + NSFW badge + 版本数(右对齐)— 单行高 22px -->
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                          <Border CornerRadius="4" Padding="6,2" Margin="0,0,4,0"
                                  Background="{Binding Kind, Converter={StaticResource ModelKindBadgeBrush}}">
                            <TextBlock Text="{Binding Kind}" Foreground="White" FontSize="11" />
                          </Border>
                          <Border CornerRadius="4" Padding="6,2"
                                  Background="{Binding NsfwKind, Converter={StaticResource ModelNsfwBadgeBrush}}">
                            <TextBlock Text="{Binding NsfwKind, Converter={StaticResource ModelNsfwBadgeText}}"
                                       Foreground="White" FontSize="11" />
                          </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{DynamicResource OutlineBrush}">
                          <Run Text="{Binding Versions.Count, Mode=OneWay}" />
                          <Run Text=" 个版本" />
                        </TextBlock>
                      </Grid>
                      <!-- 标题 — FontSize 15 bold,MaxHeight=36(2 行),CharacterEllipsis 截断 -->
                      <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15"
                                 TextWrapping="Wrap" MaxHeight="36"
                                 TextTrimming="CharacterEllipsis"
                                 Margin="0,6,0,0"
                                 Foreground="{DynamicResource OnSurfaceBrush}" />
                      <!-- 作者 + baseModel — 1 行,小灰字 -->
                      <TextBlock FontSize="11" Margin="0,2,0,0"
                                 Foreground="{DynamicResource OutlineBrush}"
                                 TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Author, Mode=OneWay, TargetNullValue=未知}" />
                        <Run Text=" · " />
                        <Run Text="{Binding BaseModel, Mode=OneWay, TargetNullValue=未指定}" />
                      </TextBlock>
                      <!-- 简介 — FontSize 11,MaxHeight=30(2 行),过长 hover Border ToolTip 看完整 HTML -->
                      <TextBlock Text="{Binding Description}"
                                 FontSize="11" MaxHeight="30"
                                 TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                 Margin="0,2,0,0"
                                 Foreground="{DynamicResource OutlineBrush}" />
                      <!-- 版本列表 — 紧凑单行 ☐ Name · Size + 📋 复制,无 border 包裹,占剩余 ~90px 高 -->
                      <ItemsControl ItemsSource="{Binding Versions}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type models:ModelVersionEntry}">
                            <Grid Margin="0,2">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <CheckBox Content="{Binding Name}" FontSize="12"
                                          Foreground="{DynamicResource OnSurfaceBrush}"
                                          VerticalAlignment="Center"
                                          Command="{Binding DataContext.ToggleVersionSelectionCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}" />
                                <TextBlock FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource OutlineBrush}"
                                           TextTrimming="CharacterEllipsis">
                                  <Run Text="{Binding PrimaryFileName, Mode=OneWay}" />
                                  <Run Text=" · " />
                                  <Run Text="{Binding SizeDisplay, Mode=OneWay}" />
                                </TextBlock>
                              </StackPanel>
                              <Button Grid.Column="1" Content="📋"
                                      Padding="4,0" Margin="2,0,0,0"
                                      VerticalAlignment="Center"
                                      ToolTip="复制下载链接到剪贴板"
                                      Command="{Binding DataContext.CopyDownloadUrlCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
      </ItemsControl>
        </Border>
      </ScrollViewer>

      <!-- v0.6.22+:Loading overlay — IsBusy=true 时半透明黑底覆盖整个卡片区域,
           ProgressBar 居中显示进度,文字 "加载中…" 提示。ScrollViewer IsEnabled=false
           已禁用卡片交互(防双击重复触发 SearchCommand),overlay 是视觉反馈。-->
      <Grid Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
            Background="#80000000">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <ProgressBar IsIndeterminate="True" Width="200" Height="6" />
          <TextBlock Text="加载中…" HorizontalAlignment="Center" Margin="0,12,0,0"
                     Foreground="{DynamicResource OnSurfaceBrush}" />
        </StackPanel>
      </Grid>

      <!-- v0.6.22+:Empty state overlay — Models.Count==0 且不在加载时显示,
           镜像 WorkflowMarketplaceView (line 281) 同款 UX。
           "—" 视觉占位 + "未找到匹配模型" 提示 + "重新刷新" MaterialButton 兜底入口
           (用户切 HuggingFace 后空结果 / 关键词无匹配都能看到)。-->
      <Grid Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="—" FontSize="48" Opacity="0.4"
                     Foreground="{DynamicResource OutlineBrush}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="未找到匹配模型" FontSize="14"
                     Foreground="{DynamicResource OnSurfaceBrush}"
                     Margin="0,8,0,0" HorizontalAlignment="Center" />
          <Button Content="重新刷新" Command="{Binding RefreshCommand}"
                  Margin="0,12,0,0"
                  Style="{StaticResource MaterialButton}" />
        </StackPanel>
      </Grid>
    </Grid>

    <!-- Console panel (3-state visibility) -->
    <Border Grid.Row="6" Margin="0,8,0,0" Padding="0"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="1" CornerRadius="6"
            Visibility="{Binding IsConsoleVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="12,8,8,4">
          <Button DockPanel.Dock="Right" Content="✕"
                  Command="{Binding HideConsoleCommand}"
                  ToolTip="关闭 Console(下次 Start 时自动重新打开)" />
          <Button DockPanel.Dock="Right" Content="清空"
                  Command="{Binding ClearConsoleLogCommand}"
                  Margin="0,0,4,0" />
          <TextBlock VerticalAlignment="Center" FontWeight="Bold" FontSize="13"
                     Foreground="{DynamicResource OnSurfaceBrush}">
            <Run Text="Console" />
            <Run Text="  " />
            <Run Text="{Binding ConsoleLog.Count, Mode=OneWay}" FontSize="11"
                 Foreground="{DynamicResource OutlineBrush}" />
            <Run Text=" 行" FontSize="11" Foreground="{DynamicResource OutlineBrush}" />
          </TextBlock>
        </DockPanel>
        <ScrollViewer Grid.Row="1" Height="160" Margin="8,0,8,8"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding ConsoleLog}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"
                           TextWrapping="NoWrap"
                           Foreground="{DynamicResource OnSurfaceBrush}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
