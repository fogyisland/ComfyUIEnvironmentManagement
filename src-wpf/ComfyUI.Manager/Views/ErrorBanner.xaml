<UserControl x:Class="ComfyUI.Manager.Views.ErrorBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- v0.6.9 T9 fix:Storyboard 从 XAML Resources 搬到 code-behind 构造 — Theme.xaml
         的 MotionDuration*Ms 是 sys:Double,不能直接给 Duration property(要 Duration 类型)。
         code-behind 用 MotionSettings.DurationSlideBanner (TimeSpan→Duration 隐式转换)构造,
         既绕开 type mismatch,又尊重 G9 (MotionSettings.IsAnimationEnabled)。 -->
    <Border x:Name="RootBorder"
            Background="Transparent"
            Opacity="1">
        <Border.RenderTransform>
            <TranslateTransform Y="0" />
        </Border.RenderTransform>
        <ItemsControl ItemsSource="{Binding Entries}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource ErrorBrush}"
                            Padding="8" Margin="2" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="{Binding Code}"
                                       FontWeight="Bold"
                                       Foreground="White" />
                            <TextBlock Text="{Binding Message}"
                                       Foreground="White"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>