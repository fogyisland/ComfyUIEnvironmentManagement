<UserControl x:Class="ComfyUI.Manager.Views.EnvironmentListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ComfyUI.Manager.Views"
             xmlns:vm="clr-namespace:ComfyUI.Manager.ViewModels"
             xmlns:controls="clr-namespace:ComfyUI.Manager.Controls">
    <DockPanel>
        <!-- 顶部:section 标题 + 工具栏 (Grid 3 列:标题 | spacer | 操作) -->
        <Grid DockPanel.Dock="Top" Margin="12,12,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="环境管理"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource OnSurfaceBrush}" />
                <TextBlock Text="{Binding Environments.Count, StringFormat='共 {0} 个环境'}"
                           FontSize="11" Foreground="{DynamicResource OutlineBrush}"
                           Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="刷新" Command="{Binding RefreshCommand}"
                        Style="{StaticResource MaterialButton}" />
                <Button Content="+ 新建环境" Command="{Binding CreateCommand}"
                        Style="{StaticResource MaterialButton}" Margin="6,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- 状态面板(启动 / 装依赖 / 卸载基础环境) -->
        <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,12">
            <!-- 启动状态 -->
            <Border Padding="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding StartStatus.IsVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                <StackPanel DataContext="{Binding StartStatus}">
                    <!-- v1.0.0.x #590:Console 抽取 — title + ✕ 关闭按钮交给 Controls/ConsolePanel
                         (terminal 深灰底浅字风格);面板不再 auto-hide,关闭后可通过
                          env 行 "再次打开" 命令重新显示。 -->
                    <TextBlock Text="{Binding CurrentStageText}" FontSize="16" Margin="0,4"
                               Foreground="{DynamicResource OnSurfaceBrush}" />
                    <ItemsControl ItemsSource="{Binding Stages}" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="2,0" Padding="6,2" CornerRadius="3"
                                        Background="{DynamicResource OutlineBrush}">
                                    <TextBlock Text="{Binding}"
                                               Foreground="{DynamicResource OnPrimaryBrush}"
                                               FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <controls:ConsolePanel Title="{Binding Title}"
                                           Lines="{Binding LogLines}"
                                           ConsoleCloseRequested="OnStartStatusCloseClicked"
                                           Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}"
                               Margin="0,4,0,0" FontWeight="Bold"
                               Visibility="{Binding Error, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}" />
                </StackPanel>
            </Border>

            <!-- 装依赖状态 -->
            <Border Margin="0,6,0,0" Padding="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding RequirementsStatus.IsVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                <StackPanel DataContext="{Binding RequirementsStatus}">
                    <TextBlock Text="{Binding StatusText}" FontSize="14" Margin="0,4"
                               Foreground="{DynamicResource OnSurfaceBrush}" TextWrapping="Wrap" />
                    <controls:ConsolePanel Title="装依赖状态"
                                           Lines="{Binding LogLines}"
                                           ConsoleCloseRequested="OnRequirementsStatusCloseClicked"
                                           Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}"
                               Margin="0,4,0,0" FontWeight="Bold" TextWrapping="Wrap"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                </StackPanel>
            </Border>

            <!-- 卸载基础环境状态 -->
            <Border Padding="12" Margin="0,6,0,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding BaseEnvUninstallStatus.IsVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                <StackPanel DataContext="{Binding BaseEnvUninstallStatus}">
                    <controls:ConsolePanel Title="卸载基础环境"
                                           Lines="{Binding LogLines}"
                                           ConsoleCloseRequested="OnBaseEnvUninstallStatusCloseClicked"
                                           Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}"
                               Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding Error, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}" />
                </StackPanel>
            </Border>

            <!-- v1.0.0.x:Forge BED inline 状态面板 — Forge env 行点「安装基础环境」时跳过
            PickerDialog + BaseEnvProgressDialog,直接 dispatch ForgeBaseEnvInstaller 跑 0-5
            全套,这里显示进度。镜像 RequirementsStatus 单阶段面板 pattern(SurfaceBrush +
            OutlineBrush + BoolToVisibility + ConsoleCloseRequested ✕)。
            仅 TemplateKind=="Forge" 的 env 触发;其它 env 走原 BaseEnvUninstallStatus 路径。 -->
            <Border Margin="0,6,0,0" Padding="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding BaseEnvStatus.IsVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                <StackPanel DataContext="{Binding BaseEnvStatus}">
                    <TextBlock Text="{Binding StatusText}" FontSize="14" Margin="0,4"
                               Foreground="{DynamicResource OnSurfaceBrush}" TextWrapping="Wrap" />
                    <controls:ConsolePanel Title="Forge 基础环境安装状态"
                                           Lines="{Binding LogLines}"
                                           ConsoleCloseRequested="OnBaseEnvStatusCloseClicked"
                                           Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}"
                               Margin="0,4,0,0" FontWeight="Bold" TextWrapping="Wrap"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                </StackPanel>
            </Border>

            <!-- v0.6.11+ T4:ComfyUI Manager 状态 — 镜像 RequirementsStatus 单阶段
            inline 面板(同 SurfaceBrush / OutlineBrush / CornerRadius + BoolToVisibility
            converter),✕ 按钮走 ConsolePanel 内部 ConsoleCloseRequested → code-behind
            事件 OnComfyUiManagerStatusCloseClicked。完成 → 2s 自动 Hide;失败 → 等用户手动关。 -->
            <Border Margin="0,6,0,0" Padding="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding ComfyUiManagerStatus.IsVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                <StackPanel DataContext="{Binding ComfyUiManagerStatus}">
                    <TextBlock Text="{Binding StatusText}" FontSize="14" Margin="0,4"
                               Foreground="{DynamicResource OnSurfaceBrush}" TextWrapping="Wrap" />
                    <controls:ConsolePanel Title="ComfyUI Manager 状态"
                                           Lines="{Binding LogLines}"
                                           ConsoleCloseRequested="OnComfyUiManagerStatusCloseClicked"
                                           Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}"
                               Margin="0,4,0,0" FontWeight="Bold" TextWrapping="Wrap"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                </StackPanel>
            </Border>

            <!-- v1.0.0.x #577:本地常用安装 inline 状态面板 — 镜像 ComfyUI Manager 同款
            SurfaceBrush/OutlineBrush/Border pattern,✕ 按钮走 ConsolePanel 内部
            ConsoleCloseRequested → OnLocalNodeInstallStatusCloseClicked。
            与单阶段 manager/status 不同:批量 + 多阶段(copy→pip 逐包),所以从不 auto-hide,
            成功失败都等用户手动关 — 用户需要看 "X/Y 个节点已装,失败:..." 的总结。 -->
            <Border Margin="0,6,0,0" Padding="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding LocalNodeInstallStatus.IsVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                <StackPanel DataContext="{Binding LocalNodeInstallStatus}">
                    <TextBlock Text="{Binding StatusText}" FontSize="14" Margin="0,4"
                               Foreground="{DynamicResource OnSurfaceBrush}" TextWrapping="Wrap" />
                    <controls:ConsolePanel Title="本地常用节点安装状态"
                                           Lines="{Binding LogLines}"
                                           ConsoleCloseRequested="OnLocalNodeInstallStatusCloseClicked"
                                           Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}"
                               Margin="0,4,0,0" FontWeight="Bold" TextWrapping="Wrap"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                </StackPanel>
            </Border>

            <!-- v0.6.22.x 删:模板更新状态面板(env-list 移除 — 模板更新操作改到 工具菜单,
                 状态面板移到 MainWindow 全局展示,跟 per-env 无关)。 -->

            <!-- v0.6.15.8:节点管理 inline panel(同 SurfaceBrush/OutlineBrush/Border pattern) -->
            <Border Margin="0,6,0,0" Padding="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding IsNodeManagementVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                <StackPanel DataContext="{Binding NodeManagement}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="扫描" Command="{Binding ScanCommand}"
                                    Style="{StaticResource MaterialButton}" />
                            <Button Content="安装节点" Command="{Binding InstallCommand}"
                                    Style="{StaticResource MaterialButton}" Margin="6,0,0,0" />
                            <Button Content="✕" Margin="6,0,0,0"
                                    Click="OnNodeManagementCloseClicked"
                                    Style="{StaticResource GearIconButtonStyle}"
                                    Foreground="{DynamicResource OnSurfaceBrush}" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="{Binding EnvName, Mode=OneWay}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource OnSurfaceBrush}" />
                            <Run Text=" 的节点管理" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource OnSurfaceBrush}" />
                        </TextBlock>
                    </DockPanel>
                    <ContentControl Content="{Binding}" Margin="0,8,0,0" MinHeight="300">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type vm:NodeManagementViewModel}">
                                <v:NodeManagementView />
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                </StackPanel>
            </Border>

            <!-- v0.6.15.9:升级节点 inline panel 已删除 — 升级迁入节点管理面板行内(过时才显示),
                 面板通过 NodeManagementView DataGrid 的 IsOutdated DataTrigger 控制。 -->
        </StackPanel>

        <!-- 中间:env card 列表 -->
        <Grid Margin="12,0,12,12">
            <!-- 空状态 -->
            <Border Visibility="{Binding Environments.Count, Converter={StaticResource ZeroCountToVisibility}}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="32"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📦" FontSize="48" HorizontalAlignment="Center"
                               Foreground="{DynamicResource OutlineBrush}" />
                    <TextBlock Text="还没有任何环境" FontSize="16" Margin="0,8,0,4"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource OnSurfaceBrush}" />
                    <TextBlock Text="点右上角「+ 新建环境」开始"
                               FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource OutlineBrush}" />
                </StackPanel>
            </Border>

            <!-- env 卡片列表 -->
            <ListBox ItemsSource="{Binding Environments}"
                     SelectedItem="{Binding Selected}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch"
                     Visibility="{Binding Environments.Count, Converter={StaticResource InverseZeroCountToVisibility}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" CornerRadius="6"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <Binding Path="IsSelected"
                                                         RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                                            </DataTrigger.Binding>
                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                            <Setter Property="Padding" Value="11" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Row 0: Header — 状态点 + Name + Port(图标入口)+ BED 徽章 -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Status dot: running=Success, stopped=Outline, failed=Error -->
                                    <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                             Margin="0,0,8,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource OutlineBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="running">
                                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="failed">
                                                        <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                               FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource OnSurfaceBrush}" />
                                    <!-- v0.6.17.1:启动控制台图标按钮(常驻)+ Port 标签。
                                         图标在 Port 左边,常驻可见(open 时深色 / close 时浅色)。
                                         DataTrigger 比较 ActiveStartStatusEnvId 跟当前 env.Id:
                                         相等 → Foreground=OnSurfaceBrush(深色,面板开着);
                                         不等或 null → Foreground=OutlineBrush(浅色,面板关着或别的 env 开)。
                                         从未启动过的 env 点图标 → 命令静默 no-op(CanExecute 永远
                                         true 给 env 非 null,但 dict 没条目 Execute 直接 return)。 -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="0,0,8,0">
                                        <!-- v0.6.22 T4:进入虚拟环境图标按钮 — 在 ⌨ 左边,terminal <Path>
                                             图标(无 emoji per v0.6.17.1)。点开新 cmd.exe /k cd 到 venv。 -->
                                        <Button MinWidth="24" MinHeight="24"
                                                ToolTip="在新窗口中打开该环境的虚拟环境(cmd.exe)"
                                                Command="{Binding DataContext.OpenVenvCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource GearIconButtonStyle}">
                                            <Viewbox Width="14" Height="14">
                                                <Path Fill="{DynamicResource OutlineBrush}"
                                                      Data="M2,4 L8,9 L2,14 M9,4 L13,4 M9,14 L13,14" />
                                            </Viewbox>
                                        </Button>
                                        <Button Content="⌨" FontSize="14" MinWidth="24" MinHeight="24"
                                                ToolTip="env 启动后,点此重新打开启动状态面板(3 阶段 + stdout 日志)。env 未启动时点击会提示"
                                                Command="{Binding DataContext.ReopenStartStatusCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource GearIconButtonStyle}">
                                                    <Setter Property="Foreground" Value="{DynamicResource OutlineBrush}" />
                                                    <!-- v0.6.17.1:DataTrigger.Value 不能挂 {Binding}(非
                                                         DependencyProperty,WPF 启动崩)。改用 MultiBinding
                                                         把 VM.ActiveStartStatusEnvId + this.Id 喂给
                                                         StringEqualityMultiConverter → bool → Value="True"。 -->
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource StringEqualityMulti}">
                                                                    <Binding Path="DataContext.ActiveStartStatusEnvId"
                                                                             RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                    <Binding Path="Id" />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource OnSurfaceBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <!-- v1.0.0.x:! 按钮 — 在 Port 7000 标签左边(⌨ 之后,Port 之前)。
                                             点击弹 NodeStartupStatusDialog 列出当前 env 所有节点 +
                                             加载失败标记。**仅 env 启动完成后才显示**:
                                             ProcessLauncher 启动 5s grace 后 NodeStartupErrorDetector
                                             才扫描 stdout/stderr 写 load_error,Status="running"
                                             之前的 env 没有数据可看 — Grid 整层折叠免占位。
                                             颜色语义:FailedNodeCount==0 → 绿色 SuccessBrush(全部加载成功);
                                             FailedNodeCount>0 → 红色 ErrorBrush(有节点未启动)。ToolTip
                                             跟着切换:"全部加载成功" / "有节点未启动"。
                                             风格跟 ⌨ 一致 GearIconButtonStyle(小图标 24×24),
                                             字面内容 "!";不显示数字 badge(避免视觉噪音)。 -->
                                        <Grid MinWidth="24" MinHeight="24">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="running">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Button Content="!" FontSize="14" FontWeight="Bold" MinWidth="24" MinHeight="24"
                                                    Command="{Binding DataContext.ShowNodeStartupStatusCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GearIconButtonStyle}">
                                                        <!-- 默认绿色 = 全部加载成功(或从未启动,无 load_error) -->
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        <Setter Property="ToolTip" Value="全部节点加载成功" />
                                                        <Style.Triggers>
                                                            <!-- 派生布尔 HasFailedNodes → 任意 ≥ 1 失败即红色 + 警示 ToolTip -->
                                                            <DataTrigger Binding="{Binding HasFailedNodes}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                                <Setter Property="ToolTip" Value="有节点未启动" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                        <Border Padding="8,2" CornerRadius="4"
                                                Background="{DynamicResource BackgroundBrush}">
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource OnSurfaceBrush}">
                                                <Run Text="Port " Foreground="{DynamicResource OutlineBrush}" />
                                                <Run Text="{Binding Port, Mode=OneWay}" FontWeight="Bold" />
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                    <!-- BED 徽章 -->
                                    <Border Grid.Column="3" Padding="8,2" CornerRadius="4"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource OutlineBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BedStatus}" Value="done">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BedStatus}" Value="installing">
                                                        <Setter Property="Background" Value="{DynamicResource SecondaryBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BedStatus}" Value="failed">
                                                        <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding BedDisplay}" FontSize="11"
                                                   Foreground="{DynamicResource OnPrimaryBrush}" />
                                    </Border>
                                </Grid>

                                <!-- Row 1: Meta — PID + Python/BED profile + (Forge) 待装 torch hint -->
                                <TextBlock Grid.Row="1" Margin="18,4,0,8" FontSize="11"
                                           Foreground="{DynamicResource OutlineBrush}">
                                    <Run Text="PID " />
                                    <Run Text="{Binding Pid, Mode=OneWay, TargetNullValue='-'}" />
                                    <Run Text="  ·  " />
                                    <Run Text="{Binding PythonVersion, Mode=OneWay, TargetNullValue='-'}" />
                                    <Run Text="  ·  " />
                                    <Run Text="{Binding BedDisplayId, Mode=OneWay, TargetNullValue='未部署'}" />
                                    <!-- v1.0.0.x (2026-08-30):Forge env 未装 BED 时,追加 "torch 2.4.0 待装" 提示,
                                         让用户看到该 template 即将装的 torch 版本号。颜色走 WarningBrush 突出"待装"。
                                         TargetNullValue="" 让已装 BED 或非 Forge env 自然不渲染 separator。 -->
                                    <Run Text="{Binding PendingBedHint, Mode=OneWay, StringFormat='  ·  {0}', TargetNullValue=''}"
                                         Foreground="{DynamicResource WarningBrush}" />
                                </TextBlock>

<!-- Row 2: Actions — 两个互斥 Grid 按 TemplateKind 切换(2026-08-30 user 修正):
                                     - Forge env  → 3 列 × 2 行 = 6 cells(启动 | 卸载基础环境 | 组件报告 / 查看日志 | 打开浏览器 | 删除)
                                     - ComfyUI env → 5 列 × 2 行 = 10 cells(启动 | 卸载基础环境 | 卸依赖 | 卸 Manager | 重装本地 / 查看日志 | 打开浏览器 | 节点管理 | 组件报告 | 删除)
                                     互斥通过外层 Grid.Style DataTrigger 控制:TemplateKind="Forge" → ForgeActions Visible,
                                     TemplateKind="ComfyUI" → ComfyUIActions Visible,其它 Collapsed(0 高,不留空白)。
                                     跟之前单一 Grid 不同,buttons 不再按 Visibility hidden 折叠,而是直接换一套 layout —
                                     让用户看到 button 数 + 列数严格匹配 TemplateKind。 -->
                                <Grid Grid.Row="2">
                                    <!-- Forge Actions:3 列 × 2 行,6 个有效 button(Requirements/Manager/LocalNodes/NodeManagement 都隐藏因为对 Forge 无意义) -->
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TemplateKind}" Value="Forge">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Row 0:装卸链路 (3 cells,2 button + 组件报告) -->
                                        <Button Grid.Row="0" Grid.Column="0" Content="{Binding StartStopButtonText}" Margin="2" MinWidth="0"
                                                Style="{StaticResource MaterialButton}"
                                                IsEnabled="{Binding StartStopButtonEnabled}"
                                                Command="{Binding DataContext.StartStopCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Row="0" Grid.Column="1" Content="{Binding BaseEnvButtonText}" Margin="2" MinWidth="0"
                                                Style="{StaticResource MaterialButton}"
                                                Command="{Binding DataContext.ToggleBaseEnvCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="走 picker dialog 装 PyTorch+CUDA 组合;已装则重置 BedStatus 保留 venv。busy 时按钮禁用" />
                                        <Button Grid.Row="0" Grid.Column="2" Content="组件报告" Margin="2" MinWidth="0"
                                                Style="{StaticResource MaterialButton}"
                                                Command="{Binding DataContext.ReportComponentsCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="生成该环境的组件版本报告(基础环境要求 vs 实际已装)并在浏览器中打开" />
                                        <!-- Row 1:调试/删除 (3 cells,3 button) -->
                                        <Button Grid.Row="1" Grid.Column="0" Content="查看日志" Margin="2" MinWidth="0"
                                                Style="{StaticResource MaterialButton}"
                                                Command="{Binding DataContext.ShowLogCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Row="1" Grid.Column="1" Content="打开浏览器" Margin="2" MinWidth="0"
                                                Style="{StaticResource MaterialButton}"
                                                Command="{Binding DataContext.OpenBrowserCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="用 Chrome 打开该环境的 ComfyUI 页面(未装则用系统默认浏览器)。仅运行中可用。" />
                                        <Button Grid.Row="1" Grid.Column="2" Content="删除" Margin="2" MinWidth="0"
                                                Style="{StaticResource DangerButton}"
                                                Command="{Binding DataContext.DeleteCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                    <!-- ComfyUI Actions:5 列 × 2 行,10 个有效 button 全显 -->
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TemplateKind}" Value="ComfyUI">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Row 0:装卸链路 (5 cells) -->
                                        <Button Grid.Row="0" Grid.Column="0" Content="{Binding StartStopButtonText}" Margin="2" MinWidth="0"
                                                Style="{StaticResource MaterialButton}"
                                                IsEnabled="{Binding StartStopButtonEnabled}"
                                                Command="{Binding DataContext.StartStopCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Row="0" Grid.Column="1" Content="{Binding BaseEnvButtonText}" Margin="2" MinWidth="0"
                                                Style="{StaticResource MaterialButton}"
                                                Command="{Binding DataContext.ToggleBaseEnvCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="走 picker dialog 装 PyTorch+CUDA 组合;已装则重置 BedStatus 保留 venv。busy 时按钮禁用" />
                                        <Button Grid.Row="0" Grid.Column="2" Content="{Binding RequirementsButtonText}" Margin="2" MinWidth="0"
                                                Style="{StaticResource MaterialButton}"
                                                Command="{Binding DataContext.ToggleRequirementsCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="运行 pip install -r requirements.txt(过滤 torch 行);已装则卸载。busy 时按钮禁用" />
                                        <Button Grid.Row="0" Grid.Column="3" Content="{Binding ComfyUiManagerButtonText}" Margin="2" MinWidth="0"
                                                Style="{StaticResource MaterialButton}"
                                                Command="{Binding DataContext.ToggleComfyUiManagerCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="git clone ltdrdata/ComfyUI-Manager 到 custom_nodes 并装 requirements.txt;已装则 rm -rf 整个目录" />
                                        <Button Grid.Row="0" Grid.Column="4" Content="{Binding LocalNodesButtonText}" Margin="2" MinWidth="0"
                                                Style="{StaticResource MaterialButton}"
                                                Command="{Binding DataContext.InstallLocalNodesCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="批量装 Settings.LocalNodesDirectory 下的本地节点包(逐个 copy + pip install -r)。已装会重装(rm -rf 同名目录后重新 copy)。失败一个 skip 到下一个。" />
                                        <!-- Row 1:调试/删除 (5 cells) -->
                                        <Button Grid.Row="1" Grid.Column="0" Content="查看日志" Margin="2" MinWidth="0"
                                                Style="{StaticResource MaterialButton}"
                                                Command="{Binding DataContext.ShowLogCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Row="1" Grid.Column="1" Content="打开浏览器" Margin="2" MinWidth="0"
                                                Style="{StaticResource MaterialButton}"
                                                Command="{Binding DataContext.OpenBrowserCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="用 Chrome 打开该环境的 ComfyUI 页面(未装则用系统默认浏览器)。仅运行中可用。" />
                                        <Button Grid.Row="1" Grid.Column="2" Content="节点管理" Margin="2" MinWidth="0"
                                                Style="{StaticResource MaterialButton}"
                                                Command="{Binding DataContext.OpenNodeManagementCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Row="1" Grid.Column="3" Content="组件报告" Margin="2" MinWidth="0"
                                                Style="{StaticResource MaterialButton}"
                                                Command="{Binding DataContext.ReportComponentsCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="生成该环境的组件版本报告(基础环境要求 vs 实际已装)并在浏览器中打开" />
                                        <Button Grid.Row="1" Grid.Column="4" Content="删除" Margin="2" MinWidth="0"
                                                Style="{StaticResource DangerButton}"
                                                Command="{Binding DataContext.DeleteCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</UserControl>