<UserControl x:Class="ComfyUI.Manager.Views.WorkflowMarketplaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ComfyUI.Manager.ViewModels"
             xmlns:models="clr-namespace:ComfyUI.Manager.Models"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:WorkflowMarketplaceViewModel}"
             Background="{DynamicResource WindowBackgroundBrush}">
  <!--
    v0.6.19.x:工作流市场 view polish — 4 axes:
    A) card layout:220x300 + Uniform stretch + source badge pill (WorkflowSourceBadge* converters)
    B) toolbar:uniform 6px gaps + 刷新 rightmost + MaterialButton style + 排序 chips
       filter strip:counts pushed right
    C) loading state:overlay Grid with indeterminate ProgressBar + 加载中… + IsEnabled dim
    D) empty state:overlay Grid with — icon + 未找到匹配工作流 + 重新刷新 button
       error/info banner:⚠ / ✓ prefix + close ✕ + Border pill 风格 (移到 card grid 之上)

    5-row Grid:
    Row0=Top toolbar / Row1=Filter strip / Row2=Info+Error banners /
    Row3=Card grid (with 3 layered overlays) / Row4=Console.

    DataContext 由 MainViewModel 切换 section 时绑成 WorkflowMarketplaceViewModel。
  -->
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Top toolbar (v0.6.19.x B: uniform 6px gaps + 刷新 moved rightmost + MaterialButton) -->
    <DockPanel Grid.Row="0" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Content="刷新"
              Command="{Binding RefreshCommand}" Margin="6,0,0,0"
              Style="{StaticResource MaterialButton}"
              IsEnabled="{Binding NotIsBusy}" />
      <Button DockPanel.Dock="Right" Content="打开目录"
              Command="{Binding OpenFolderCommand}" Margin="6,0,0,0"
              Style="{StaticResource MaterialButton}" />
      <Button DockPanel.Dock="Right" Content="全选"
              Command="{Binding ToggleSelectAllCommand}" Margin="6,0,0,0"
              Style="{StaticResource MaterialButton}" />
      <Button DockPanel.Dock="Right" Content="批量下载"
              Command="{Binding BatchDownloadCommand}" Margin="6,0,0,0"
              Style="{StaticResource MaterialButton}" />
      <!-- v0.6.22 composite search bar: Border + 🔍 Path + TextBox + ✕ Button + placeholder overlay -->
      <Border DockPanel.Dock="Left" Width="360" Margin="0,0,16,0"
              BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
              CornerRadius="6" Background="{DynamicResource SurfaceBrush}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <!-- 🔍 magnifying-glass icon (Path, no emoji per v0.6.17.1) -->
          <Viewbox Grid.Column="0" Width="16" Height="16" Margin="8,0,4,0" VerticalAlignment="Center">
            <Path Fill="{DynamicResource OnSurfaceBrush}" Opacity="0.6"
                  Data="M10,2 a8,8 0 1,0 0,16 a8,8 0 1,0 0,-16 Z M14,14 l5,5" />
          </Viewbox>
          <!-- Search input with placeholder overlay -->
          <TextBox Grid.Column="1" Padding="6,4"
                   BorderThickness="0" Background="Transparent"
                   VerticalAlignment="Center"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   IsEnabled="{Binding NotIsBusy}" />
          <!-- Placeholder TextBlock (overlay, hidden when text non-empty) -->
          <TextBlock Grid.Column="1" Margin="6,0,0,0"
                     VerticalAlignment="Center" IsHitTestVisible="False"
                     Foreground="{DynamicResource OnSurfaceBrush}" Opacity="0.5"
                     Text="搜索工作流"
                     Visibility="{Binding HasSearchText, Converter={StaticResource InverseBoolToVisibility}}" />
          <!-- ✕ clear button (visible when text non-empty) -->
          <Button Grid.Column="2" Padding="4,2" Margin="0,0,4,0"
                  VerticalAlignment="Center"
                  Command="{Binding ClearSearchCommand}"
                  ToolTip="清除搜索"
                  Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVisibility}}"
                  Style="{StaticResource MaterialButton}">
            <Viewbox Width="12" Height="12">
              <Path Fill="{DynamicResource OnSurfaceBrush}" Opacity="0.6"
                    Data="M6,6 L18,18 M18,6 L6,18" />
            </Viewbox>
          </Button>
        </Grid>
      </Border>
      <TextBlock DockPanel.Dock="Left" Text="工作流市场"
                 FontSize="20" FontWeight="Bold"
                 Foreground="{DynamicResource OnSurfaceBrush}"
                 VerticalAlignment="Center" Margin="0,0,16,0" />
    </DockPanel>

    <!-- Filter strip (v0.6.19.x B: 排序 chips + counts pushed right) -->
    <Border Grid.Row="1" Padding="8" Margin="0,0,0,8"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="1" CornerRadius="6">
      <DockPanel LastChildFill="False">
        <!-- Counts pushed right -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
          <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7"
                     Foreground="{DynamicResource OnSurfaceBrush}"
                     Text="{Binding TotalCount, StringFormat='共 {0} 条'}" />
          <TextBlock VerticalAlignment="Center" Margin="0,0,0,0" Opacity="0.7"
                     Foreground="{DynamicResource OnSurfaceBrush}"
                     Text="{Binding DownloadedCount, StringFormat='已下载 {0} 个'}" />
        </StackPanel>
        <!-- Sort chips (v0.6.19.x B:3 RadioButton segmented,镜像 CatalogSegmentedRadioButton) -->
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <TextBlock Text="源:" VerticalAlignment="Center" Margin="0,0,6,0"
                     Foreground="{DynamicResource OnSurfaceBrush}" />
          <ItemsControl ItemsSource="{Binding ActiveSourceFilters}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox Content="{Binding}" Margin="6,0"
                          Foreground="{DynamicResource OnSurfaceBrush}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="排序:" VerticalAlignment="Center" Margin="16,0,6,0"
                     Foreground="{DynamicResource OnSurfaceBrush}" />
          <RadioButton GroupName="SortBy" Content="最新"
                       IsChecked="{Binding SortBy, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Newest}"
                       Style="{StaticResource CatalogSegmentedRadioButton}" />
          <RadioButton GroupName="SortBy" Content="下载"
                       IsChecked="{Binding SortBy, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Downloads}"
                       Style="{StaticResource CatalogSegmentedRadioButton}" />
          <RadioButton GroupName="SortBy" Content="名称"
                       IsChecked="{Binding SortBy, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Name}"
                       Style="{StaticResource CatalogSegmentedRadioButton}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Info / Error banner (v0.6.19.x D:moved ABOVE card grid,⚠ / ✓ prefix + close ✕ + Border pill) -->
    <StackPanel Grid.Row="2" Margin="0,0,0,8">
      <Border CornerRadius="6" Padding="8,6" Margin="0,0,0,4"
              BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1"
              Background="{DynamicResource SurfaceBrush}"
              Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="✕" Padding="4,0" Background="Transparent"
                  BorderThickness="0" Foreground="{DynamicResource ErrorBrush}"
                  Click="OnErrorBannerCloseClicked" />
          <TextBlock Foreground="{DynamicResource ErrorBrush}" FontWeight="SemiBold"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
            <Run Text="⚠  " FontSize="14" />
            <Run Text="{Binding ErrorMessage, Mode=OneWay}" />
          </TextBlock>
        </DockPanel>
      </Border>
      <Border CornerRadius="6" Padding="8,6"
              BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1"
              Background="{DynamicResource SurfaceBrush}"
              Visibility="{Binding InfoMessage, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="✕" Padding="4,0" Background="Transparent"
                  BorderThickness="0" Foreground="{DynamicResource SuccessBrush}"
                  Click="OnInfoBannerCloseClicked" />
          <TextBlock Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
            <Run Text="✓  " FontSize="14" />
            <Run Text="{Binding InfoMessage, Mode=OneWay}" />
          </TextBlock>
        </DockPanel>
      </Border>
    </StackPanel>

    <!-- Card grid + loading overlay + empty state overlay (v0.6.19.x A/C/D) -->
    <Grid Grid.Row="3">
      <!-- Existing ScrollViewer with cards — disabled during IsBusy (C) -->
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    IsEnabled="{Binding NotIsBusy}">
        <ItemsControl ItemsSource="{Binding Workflows}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type models:WorkflowEntry}">
              <Border Width="220" Height="300" Margin="8"
                      Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource OutlineBrush}"
                      BorderThickness="1" CornerRadius="6">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <!-- Preview: Uniform + SurfaceVariantBrush letterbox fill (A) -->
                  <!-- v0.6.22 T3: hover handlers trigger LoadJsonPreviewAsync; overlay shows JSON -->
                  <Border Grid.Row="0" Margin="8" CornerRadius="4" ClipToBounds="True"
                          Background="{DynamicResource SurfaceVariantBrush}"
                          MouseEnter="OnPreviewMouseEnter"
                          MouseLeave="OnPreviewMouseLeave"
                          Tag="{Binding}">
                    <Grid>
                      <Image Source="{Binding PreviewImageUrl}" Stretch="Uniform" />
                      <!-- JSON overlay (visible when HoveredEntry == this entry) -->
                      <Border Background="#CC000000" Padding="8"
                              Visibility="{Binding DataContext.IsJsonOverlayVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                        <Grid>
                          <!-- Loading state -->
                          <StackPanel Visibility="{Binding DataContext.IsJsonOverlayLoading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                            <ProgressBar IsIndeterminate="True" Height="4" Width="60" />
                            <TextBlock Text="加载 JSON..." FontSize="11" Margin="0,4,0,0"
                                       Foreground="{DynamicResource OnSurfaceBrush}" />
                          </StackPanel>
                          <!-- Loaded state -->
                          <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"
                                        Visibility="{Binding DataContext.IsJsonOverlayLoading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVisibility}, FallbackValue=Collapsed}">
                            <TextBlock Text="{Binding DataContext.JsonOverlayText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       FontFamily="Consolas" FontSize="10"
                                       TextWrapping="NoWrap"
                                       Foreground="{DynamicResource OnSurfaceBrush}" />
                          </ScrollViewer>
                          <!-- Error state -->
                          <TextBlock Text="无法加载 JSON" FontSize="11"
                                     Foreground="{DynamicResource ErrorBrush}"
                                     Visibility="{Binding DataContext.IsJsonOverlayError, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                        </Grid>
                      </Border>
                    </Grid>
                  </Border>
                  <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                             Margin="8,4" MaxHeight="60" TextWrapping="Wrap"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource OnSurfaceBrush}" />
                  <TextBlock Grid.Row="2" Text="{Binding Author}" FontSize="11" Opacity="0.7"
                             Margin="8,0"
                             Foreground="{DynamicResource OnSurfaceBrush}"
                             TextTrimming="CharacterEllipsis" />
                  <!-- Source badge pill (A) + Download button stretching full width -->
                  <Grid Grid.Row="3" Margin="8,4,8,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="8" Padding="6,2"
                            Background="{Binding Source, Converter={StaticResource WorkflowSourceBadgeBrush}}">
                      <TextBlock Text="{Binding Source, Converter={StaticResource WorkflowSourceBadgeText}}"
                                 FontSize="10" Foreground="{DynamicResource OnPrimaryBrush}" />
                    </Border>
                    <Button Grid.Column="1" Content="下载" Margin="6,0,0,0"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource MaterialButton}"
                            Command="{Binding DataContext.DownloadSingleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Loading overlay (C) -->
      <Grid Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
            Background="#80000000">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <ProgressBar IsIndeterminate="True" Width="200" Height="6" />
          <TextBlock Text="加载中…" HorizontalAlignment="Center" Margin="0,12,0,0"
                     Foreground="{DynamicResource OnSurfaceBrush}" />
        </StackPanel>
      </Grid>

      <!-- Empty state overlay (D) -->
      <Grid Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="—" FontSize="48" Opacity="0.4"
                     Foreground="{DynamicResource OutlineBrush}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="未找到匹配工作流" FontSize="14"
                     Foreground="{DynamicResource OnSurfaceBrush}"
                     Margin="0,8,0,0" HorizontalAlignment="Center" />
          <Button Content="重新刷新" Command="{Binding RefreshCommand}"
                  Margin="0,12,0,0"
                  Style="{StaticResource MaterialButton}" />
        </StackPanel>
      </Grid>
    </Grid>

    <!-- Console panel — mirrors BulkUpdateView Console (v0.6.18.4) -->
    <Border Grid.Row="4" Margin="0,8,0,0" Padding="0"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="1" CornerRadius="6"
            Visibility="{Binding IsConsoleVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="12,8,8,4">
          <Button DockPanel.Dock="Right" Content="✕"
                  Click="OnConsoleCloseClicked"
                  ToolTip="关闭 Console(下次 Start 时自动重新打开)" />
          <TextBlock VerticalAlignment="Center" FontWeight="Bold" FontSize="13"
                     Foreground="{DynamicResource OnSurfaceBrush}">
            <Run Text="Console" />
            <Run Text="  " />
            <Run Text="{Binding ConsoleLog.Count, Mode=OneWay}" FontSize="11"
                 Foreground="{DynamicResource OutlineBrush}" />
            <Run Text=" 行" FontSize="11" Foreground="{DynamicResource OutlineBrush}" />
          </TextBlock>
        </DockPanel>
        <ScrollViewer x:Name="ConsoleScrollViewer" Grid.Row="1"
                      Height="160" Margin="8,0,8,8"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding ConsoleLog}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"
                           TextWrapping="NoWrap"
                           Foreground="{DynamicResource OnSurfaceBrush}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
