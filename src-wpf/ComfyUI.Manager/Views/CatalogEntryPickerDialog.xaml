<Window x:Class="ComfyUI.Manager.Views.CatalogEntryPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ComfyUI.Manager.Views"
        Title="选择节点" Height="600" Width="870"
        Background="{StaticResource BackgroundBrush}"
        Icon="pack://siteoforigin:,,,/asset/comfyuiLogo.png">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: search box -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="搜索:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <!-- Row 1: filter chips (全部/未装/已装/已过时)
             v0.6.14 R1 fix:ConverterParameter 写 enum-name 字面串(不能再写 {Binding},
             WPF markup 评估返 Binding 实例 ≠ enum 值)。OneWay binding + RadioButton.Click
             代码后端调 SetActiveFilterCommand 改 VM.ActiveFilter(详见 code-behind)。
             pattern 同 MainWindow.xaml 的 SidebarRadioButton。 -->
        <ItemsControl Grid.Row="1" Margin="0,0,0,8"
                      ItemsSource="{Binding FilterOptions}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton GroupName="PickerFilter"
                                 Margin="0,0,8,0"
                                 Style="{StaticResource CatalogSegmentedRadioButton}"
                                 Tag="{Binding}"
                                 Click="OnFilterChipClicked"
                                 Content="{Binding Label}">
                        <RadioButton.IsChecked>
                            <!-- v0.6.14 picker hotfix:DataTemplate 里 RadioButton 不能用
                                 ConverterParameter={Binding} (WPF 把 Binding 实例赋给
                                 ConverterParameter → XamlParseException at template load),
                                 改用 MultiBinding 把 Filter + ActiveFilter 两值都拿到,
                                 走 IMultiValueConverter 直接比。
                                 两路 binding 都必须 Mode=OneWay:PickerFilterOption.Filter
                                 是 get-only,默认 TwoWay 会抛 InvalidOperationException。 -->
                            <MultiBinding Converter="{StaticResource PickerFilterEqualsConverter}">
                                <Binding Path="Filter" Mode="OneWay" />
                                <Binding Path="DataContext.ActiveFilter"
                                         RelativeSource="{RelativeSource AncestorType=Window}"
                                         Mode="OneWay" />
                            </MultiBinding>
                        </RadioButton.IsChecked>
                    </RadioButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Row 2: list of picker items (cards)
             v0.6.14 R1 fix:MouseDoubleClick 触发 OkCommand(只对 IsInstalled==false 生效,
             OkCommand.CanExecute 已 gate)。配合行内安装按钮用户单双击都能选。
             v0.6.15.9.2:右侧按钮列改固定 Width=120(原 Auto 会在窄屏挤压触发横向滚动),
             卸载/安装 并排(原上下),description 单行 ellipsis + tooltip 看完整。 -->
        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Items}"
                 SelectedItem="{Binding Selected}"
                 MouseDoubleClick="OnListDoubleClick"
                 ItemContainerStyle="{StaticResource CatalogCardItemContainerStyle}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- v0.6.15.9.2 R6 fix:Card MaxWidth = Window.Width × 90% = 870 × 0.9 = 783。
                         用户规则升级:Card 占 90%,其余 10% 留给框架。比 R5 的 80% 略宽,
                         给 description / 已装 / latest / LastUpdate 多点横向空间。
                         仍留 MaxWidth 避免子控件撑爆 ListBoxItem。 -->
                    <Border Padding="10" CornerRadius="6"
                            MaxWidth="783"
                            HorizontalAlignment="Stretch"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <Binding Path="IsSelected"
                                                     RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                                        </DataTrigger.Binding>
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="Padding" Value="9" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <!-- v0.6.15.9.2:固定 120 而非 Auto,避免窄屏挤压主体列触发横向滚动条 -->
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <!-- v0.6.15.11:Row 4 新增 — 紧凑 stat strip (license / stars / downloads / lang / py compat / os icons / deprecated) -->
                                <RowDefinition Height="Auto" />
                                <!-- v0.6.15.11:Row 5 新增 — chevron 展开的 row details 面板 (3 分区) -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: Package + Status badge + chevron toggle
                                 v0.6.15.11:在 Package 之前加 chevron ToggleButton,绑 IsExpanded TwoWay,
                                 跟 v0.6.15.10 节点管理面板的 chevron 列同款 — ▸ 旋转 90° 变 ▾。 -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                              Cursor="Hand"
                                              ToolTip="展开/收起详细信息"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Width="20" Height="20"
                                              Padding="0"
                                              Margin="0,0,6,0"
                                              Background="Transparent"
                                              BorderThickness="0">
                                    <TextBlock Text="▸" FontSize="12"
                                               HorizontalAlignment="Center"
                                               RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="0" />
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="90" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </ToggleButton>
                                <!-- v0.6.15.9.2:Package 字号 16 → 14,降低视觉权重让 description/版本信息更突出 -->
                                <TextBlock Text="{Binding Entry.Package}"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource OnSurfaceBrush}"
                                           VerticalAlignment="Center" />
                                <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="3"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource OutlineBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Installed">
                                                    <Setter Property="Background" Value="{DynamicResource SecondaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Outdated">
                                                    <Setter Property="Background" Value="{DynamicResource ErrorVariantBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusBadge}" FontSize="11"
                                               Foreground="{DynamicResource OnPrimaryBrush}" />
                                </Border>
                                <!-- v0.6.15.11:deprecated badge — Entry.Deprecated=true 时红色 DEPRECATED chip -->
                                <Border Margin="6,0,0,0" Padding="6,2" CornerRadius="3"
                                        Background="#D32F2F"
                                        VerticalAlignment="Center"
                                        ToolTip="此 catalog 节点作者已标记为不推荐使用"
                                        Visibility="{Binding Entry.Deprecated, Mode=OneWay, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                    <TextBlock Text="DEPRECATED" FontSize="10" FontWeight="Bold"
                                               Foreground="White" />
                                </Border>
                            </StackPanel>

                            <!-- Row 0 right: per-row action buttons (卸载/安装 同一行 + 进度/错误)
                                 v0.6.15.9.2:卸载/安装 改成横向并排(原上下),省垂直空间也匹配互斥语义 -->
                            <StackPanel Grid.Row="0" Grid.RowSpan="4" Grid.Column="1"
                                        VerticalAlignment="Center" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Command="{Binding DataContext.UninstallCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Content="卸载"
                                            MinWidth="56" Padding="8,4" FontSize="11"
                                            ToolTip="从当前 env 卸载节点(仅已装的条目显示)">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusKind}" Value="Installed">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusKind}" Value="Outdated">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <!-- v0.6.14 T5:per-row 安装 button,NotInstalled 显示,
                                         直接走 NodeOperations.InstallAsync(不再弹 InstallDialog)。
                                         Installed/Outdated 隐藏 — 那两种已装,不需要安装。 -->
                                    <Button Command="{Binding DataContext.InstallCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Content="安装"
                                            MinWidth="56" Padding="8,4" FontSize="11"
                                            Margin="6,0,0,0"
                                            ToolTip="直接安装到当前 env(仅未装的条目显示)">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusKind}" Value="NotInstalled">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                                <!-- v0.6.14 T5:行内安装进度 — IsInstalling=true 时显示,
                                     文本由 Progress<string> 从 NodeOperations.InstallAsync
                                     推到 UI 线程。默认 Collapsed,DataTrigger 切 Visible。
                                     v0.6.15.9.2:单行 + ellipsis + tooltip 看完整,MaxWidth 160 → 110 -->
                                <TextBlock Text="{Binding InstallProgress}"
                                           FontSize="11"
                                           Foreground="{DynamicResource OutlineBrush}"
                                           VerticalAlignment="Center" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="110"
                                           ToolTip="{Binding InstallProgress}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- v0.6.14 T5:行内安装错误 — InstallError 非 null 时显示,
                                     走 NullToVisibilityConverter(Theme.xaml 已注册)。
                                     v0.6.15.9.2:同上一致 — 单行 ellipsis + tooltip,MaxWidth 160 → 110 -->
                                <TextBlock Text="{Binding InstallError}"
                                           FontSize="11"
                                           Foreground="{DynamicResource ErrorVariantBrush}"
                                           VerticalAlignment="Center" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="110"
                                           ToolTip="{Binding InstallError}"
                                           Visibility="{Binding InstallError,
                                                Converter={x:Static views:NullToVisibilityConverter.Instance}}" />
                            </StackPanel>

                            <!-- Row 1: Author + install_type pill (复用 CatalogInstallTypeBadgeStyle)
                                 v0.6.15.9.2:行间距 6 → 4 -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding Entry.Author}" FontSize="12"
                                           Foreground="{DynamicResource OutlineBrush}" />
                                <Border Style="{StaticResource CatalogInstallTypeBadgeStyle}">
                                    <TextBlock Text="{Binding Entry.InstallType}" FontSize="10"
                                               Foreground="{DynamicResource OnPrimaryBrush}" />
                                </Border>
                            </StackPanel>

                            <!-- Row 2: Description (v0.6.15.9.2 R1 fix:改多行 wrap,不再强制单行 + ellipsis。
                                 用户反馈 "描述不能一直处于一行" — 长描述需要展开,空状态短描述
                                 不会撑高。MaxHeight=60 (~3 行) + ToolTip 兜底超长截断。 -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Entry.Description}"
                                       FontSize="12" Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       MaxHeight="60"
                                       ToolTip="{Binding Entry.Description}"
                                       Foreground="{DynamicResource OnSurfaceBrush}" />

                            <!-- Row 3: installed version + latest version + 选择版本 + LastUpdate
                                 v0.6.15.9.2:ComboBox MaxWidth 220 → 160,LastUpdate 跟「选择版本」
                                 label + ComboBox 共用一行(原 row 4 整行) -->
                            <Grid Grid.Row="3" Grid.Column="0" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="选择版本:" VerticalAlignment="Center"
                                           Margin="0,0,6,0" FontSize="11"
                                           Foreground="{DynamicResource OutlineBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Installed">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Outdated">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Versions}"
                                          SelectedItem="{Binding SelectedVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="DisplayLabel"
                                          MinWidth="120"
                                          MaxWidth="160"
                                          FontSize="11">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Installed">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Outdated">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>
                                <!-- v0.6.15.9.2:installed version / latest version + LastUpdate
                                     合到 ComboBox 那一行右侧,不再独立一行,row 4 也砍了 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="8,0,0,0">
                                    <TextBlock Text="{Binding InstalledVersionDisplay, StringFormat='已装: {0}'}"
                                               FontSize="11" Foreground="{DynamicResource OnSurfaceBrush}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="120" />
                                    <TextBlock Text="{Binding Entry.LatestVersion, StringFormat='  |  latest: {0}'}"
                                               FontSize="11" Foreground="{DynamicResource OutlineBrush}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="120" />
                                    <TextBlock Text="{Binding Entry.LastUpdate, StringFormat='  |  更新: {0}'}"
                                               FontSize="11" Foreground="{DynamicResource OutlineBrush}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="100" />
                                </StackPanel>
                            </Grid>

                            <!-- Row 4: v0.6.15.11 紧凑 stat strip
                                 永远显示(空内容 strip 高度 0,不影响布局)。水平排列小 chip:
                                 license / language / stars / downloads / python compat / OS icons。
                                 单个 chip 内部用 NullToVisibility 或 DataTrigger 切 Visible/Collapsed。
                                 Entry.Deprecated 在 Row 0 已单独显示 DEPRECATED 红 chip,这里不重复。 -->
                            <ItemsControl Grid.Row="4" Grid.Column="0" Margin="0,6,0,0"
                                          ItemsSource="{Binding StatChips}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,6,0" Padding="5,1" CornerRadius="3"
                                                Background="{DynamicResource OutlineBrush}"
                                                VerticalAlignment="Center"
                                                ToolTip="{Binding Tooltip}">
                                            <TextBlock Text="{Binding Display}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource OnPrimaryBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Row 5: v0.6.15.11 chevron 展开 — row details 面板
                                 跟 v0.6.15.10 节点管理面板同款 3 分区布局:
                                 GitHub 项目元数据 / 安装兼容性 / 已装 vs 最新比对。
                                 Visibility 绑 IsExpanded → chevron toggle 切显隐。
                                 列 0+1 ColumnSpan=2 让 details 横跨整个 card 宽度。 -->
                            <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                                    Margin="0,8,0,0"
                                    Background="{DynamicResource OutlineBrush}"
                                    CornerRadius="4"
                                    Padding="12,8"
                                    Visibility="{Binding IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 分区 1:GitHub 项目元数据 -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="GitHub 元数据"
                                               FontSize="12" FontWeight="Bold" Margin="0,0,0,6"
                                               Foreground="{DynamicResource OnSurfaceBrush}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" FontSize="11" Margin="0,2"
                                               Visibility="{Binding LicenseDisplay, Mode=OneWay, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}">
                                        <Run Text="License:" Foreground="{DynamicResource OutlineBrush}" />
                                        <Run Text="{Binding LicenseDisplay, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="2" Grid.Column="0" FontSize="11" Margin="0,2"
                                               Visibility="{Binding LanguageDisplay, Mode=OneWay, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}">
                                        <Run Text="Language:" Foreground="{DynamicResource OutlineBrush}" />
                                        <Run Text="{Binding LanguageDisplay, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="3" Grid.Column="0" FontSize="11" Margin="0,2"
                                               Visibility="{Binding StarsDisplay, Mode=OneWay, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}">
                                        <Run Text="Stars:" Foreground="{DynamicResource OutlineBrush}" />
                                        <Run Text="{Binding StarsDisplay, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="4" Grid.Column="0" FontSize="11" Margin="0,2"
                                               Visibility="{Binding Entry.ForksCount, Mode=OneWay, Converter={StaticResource ZeroCountToVisibility}, FallbackValue=Collapsed}">
                                        <Run Text="Forks:" Foreground="{DynamicResource OutlineBrush}" />
                                        <Run Text="{Binding Entry.ForksCount, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="5" Grid.Column="0" FontSize="11" Margin="0,2"
                                               Visibility="{Binding Entry.OpenIssuesCount, Mode=OneWay, Converter={StaticResource ZeroCountToVisibility}, FallbackValue=Collapsed}">
                                        <Run Text="Open Issues:" Foreground="{DynamicResource OutlineBrush}" />
                                        <Run Text="{Binding Entry.OpenIssuesCount, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="6" Grid.Column="0" FontSize="11" Margin="0,2"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding TagsDisplay}"
                                               Visibility="{Binding TagsDisplay, Mode=OneWay, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}">
                                        <Run Text="Tags:" Foreground="{DynamicResource OutlineBrush}" />
                                        <Run Text="{Binding TagsDisplay, Mode=OneWay}" />
                                    </TextBlock>

                                    <!-- 分区 2:安装兼容性 -->
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="兼容性"
                                               FontSize="12" FontWeight="Bold" Margin="0,0,0,6"
                                               Foreground="{DynamicResource OnSurfaceBrush}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" Margin="0,2"
                                               Visibility="{Binding PythonCompatDisplay, Mode=OneWay, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}">
                                        <Run Text="Python:" Foreground="{DynamicResource OutlineBrush}" />
                                        <Run Text="{Binding PythonCompatDisplay, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="2" Grid.Column="1" FontSize="11" Margin="0,2"
                                               Visibility="{Binding OsCompatIcons, Mode=OneWay, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}">
                                        <Run Text="OS:" Foreground="{DynamicResource OutlineBrush}" />
                                        <Run Text="{Binding OsCompatIcons, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="3" Grid.Column="1" FontSize="11" Margin="0,2"
                                               Visibility="{Binding Entry.InstallType, Mode=OneWay, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}">
                                        <Run Text="安装方式:" Foreground="{DynamicResource OutlineBrush}" />
                                        <Run Text="{Binding Entry.InstallType, Mode=OneWay}" />
                                    </TextBlock>
                                    <ItemsControl Grid.Row="4" Grid.Column="1" Grid.RowSpan="3" Grid.ColumnSpan="1"
                                                  Margin="0,2"
                                                  ItemsSource="{Binding PipRequirementsDisplay}"
                                                  Visibility="{Binding PipRequirementsDisplay, Mode=OneWay, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,1,4,1" Padding="5,1" CornerRadius="3"
                                                        Background="{DynamicResource SurfaceBrush}"
                                                        BorderBrush="{DynamicResource OutlineBrush}"
                                                        BorderThickness="1">
                                                    <TextBlock FontSize="10"
                                                               Foreground="{DynamicResource OnSurfaceBrush}">
                                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                                        <Run Text="{Binding Specifier, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 分区 3:已装 vs 最新比对 -->
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="已装 vs 最新"
                                               FontSize="12" FontWeight="Bold" Margin="0,0,0,6"
                                               Foreground="{DynamicResource OnSurfaceBrush}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" FontSize="11" Margin="0,2"
                                               Visibility="{Binding InstalledTag, Mode=OneWay, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}">
                                        <Run Text="已装 tag:" Foreground="{DynamicResource OutlineBrush}" />
                                        <Run Text="{Binding InstalledTag, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="2" Grid.Column="2" FontSize="11" Margin="0,2"
                                               Visibility="{Binding InstalledSha, Mode=OneWay, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}">
                                        <Run Text="已装 SHA:" Foreground="{DynamicResource OutlineBrush}" />
                                        <Run Text="{Binding InstalledSha, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="3" Grid.Column="2" FontSize="11" Margin="0,2"
                                               Visibility="{Binding Entry.LatestVersion, Mode=OneWay, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}">
                                        <Run Text="Latest:" Foreground="{DynamicResource OutlineBrush}" />
                                        <Run Text="{Binding Entry.LatestVersion, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="4" Grid.Column="2" FontSize="11" Margin="0,2"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource ErrorVariantBrush}"
                                               Visibility="{Binding IsOutdated, Mode=OneWay, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                        <Run Text="⚠ 已过时,可升级" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="5" Grid.Column="2" FontSize="11" Margin="0,2"
                                               Visibility="{Binding Entry.LastUpdate, Mode=OneWay, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}">
                                        <Run Text="catalog 更新:" Foreground="{DynamicResource OutlineBrush}" />
                                        <Run Text="{Binding Entry.LastUpdate, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="6" Grid.Column="2" FontSize="11" Margin="0,2"
                                               Visibility="{Binding Entry.MetadataFetchedAt, Mode=OneWay, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}">
                                        <Run Text="GitHub 数据:" Foreground="{DynamicResource OutlineBrush}" />
                                        <Run Text="{Binding Entry.MetadataFetchedAt, Mode=OneWay}" />
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Row 4: footer with cancel -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0"
                    HorizontalAlignment="Right">
            <TextBlock Text="双击未装条目 或 点击行内安装 / 卸载按钮"
                       FontSize="11" Foreground="{DynamicResource OutlineBrush}"
                       VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button Content="取消" Command="{Binding CancelCommand}"
                    Style="{StaticResource MaterialButton}" Width="80" />
        </StackPanel>
    </Grid>
</Window>