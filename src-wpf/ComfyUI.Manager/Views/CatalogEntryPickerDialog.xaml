<Window x:Class="ComfyUI.Manager.Views.CatalogEntryPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择节点" Height="600" Width="720"
        Background="{StaticResource BackgroundBrush}"
        Icon="pack://siteoforigin:,,,/asset/comfyuiLogo.png">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: search box -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="搜索:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <!-- Row 1: filter chips (全部/未装/已装/已过时)
             v0.6.14 R1 fix:ConverterParameter 写 enum-name 字面串(不能再写 {Binding},
             WPF markup 评估返 Binding 实例 ≠ enum 值)。OneWay binding + RadioButton.Click
             代码后端调 SetActiveFilterCommand 改 VM.ActiveFilter(详见 code-behind)。
             pattern 同 MainWindow.xaml 的 SidebarRadioButton。 -->
        <ItemsControl Grid.Row="1" Margin="0,0,0,8"
                      ItemsSource="{Binding FilterOptions}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton GroupName="PickerFilter"
                                 Margin="0,0,8,0"
                                 Style="{StaticResource CatalogSegmentedRadioButton}"
                                 Tag="{Binding}"
                                 Click="OnFilterChipClicked"
                                 Content="{Binding Label}">
                        <RadioButton.IsChecked>
                            <!-- v0.6.14 picker hotfix:DataTemplate 里 RadioButton 不能用
                                 ConverterParameter={Binding} (WPF 把 Binding 实例赋给
                                 ConverterParameter → XamlParseException at template load),
                                 改用 MultiBinding 把 Filter + ActiveFilter 两值都拿到,
                                 走 IMultiValueConverter 直接比。
                                 两路 binding 都必须 Mode=OneWay:PickerFilterOption.Filter
                                 是 get-only,默认 TwoWay 会抛 InvalidOperationException。 -->
                            <MultiBinding Converter="{StaticResource PickerFilterEqualsConverter}">
                                <Binding Path="Filter" Mode="OneWay" />
                                <Binding Path="DataContext.ActiveFilter"
                                         RelativeSource="{RelativeSource AncestorType=Window}"
                                         Mode="OneWay" />
                            </MultiBinding>
                        </RadioButton.IsChecked>
                    </RadioButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Row 2: list of picker items (cards)
             v0.6.14 R1 fix:MouseDoubleClick 触发 OkCommand(只对 IsInstalled==false 生效,
             OkCommand.CanExecute 已 gate)。配合行内安装按钮用户单双击都能选。 -->
        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Items}"
                 SelectedItem="{Binding Selected}"
                 MouseDoubleClick="OnListDoubleClick"
                 ItemContainerStyle="{StaticResource CatalogCardItemContainerStyle}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12" CornerRadius="6"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <Binding Path="IsSelected"
                                                     RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                                        </DataTrigger.Binding>
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="Padding" Value="11" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: Package + Status badge -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="{Binding Entry.Package}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource OnSurfaceBrush}"
                                           VerticalAlignment="Center" />
                                <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="3"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource OutlineBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Installed">
                                                    <Setter Property="Background" Value="{DynamicResource SecondaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Outdated">
                                                    <Setter Property="Background" Value="{DynamicResource ErrorVariantBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusBadge}" FontSize="11"
                                               Foreground="{DynamicResource OnPrimaryBrush}" />
                                </Border>
                            </StackPanel>

                            <!-- Row 0 right: per-row action button -->
                            <StackPanel Grid.Row="0" Grid.RowSpan="4" Grid.Column="1"
                                        VerticalAlignment="Center" Margin="8,0,0,0">
                                <!-- Installed or Outdated: show 卸载 button;NotInstalled 隐藏 -->
                                <Button Command="{Binding DataContext.UninstallCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Content="卸载"
                                        MinWidth="80">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Installed">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Outdated">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- v0.6.14 R1 fix:per-row 安装 button,NotInstalled 显示,
                                     让用户单点也能选(双击也走 OnListDoubleClick 同一路径)。
                                     Installed/Outdated 隐藏 — 那两种已装,不需要安装。 -->
                                <Button Command="{Binding DataContext.OkCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Content="安装"
                                        MinWidth="80"
                                        Margin="0,6,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="NotInstalled">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <!-- Row 1: Author + install_type pill (复用 CatalogInstallTypeBadgeStyle) -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding Entry.Author}" FontSize="12"
                                           Foreground="{DynamicResource OutlineBrush}" />
                                <Border Style="{StaticResource CatalogInstallTypeBadgeStyle}">
                                    <TextBlock Text="{Binding Entry.InstallType}" FontSize="10"
                                               Foreground="{DynamicResource OnPrimaryBrush}" />
                                </Border>
                            </StackPanel>

                            <!-- Row 2: Description -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Entry.Description}"
                                       FontSize="12" Margin="0,6,0,0"
                                       TextWrapping="Wrap" MaxHeight="40"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource OnSurfaceBrush}" />

                            <!-- Row 3: installed version + latest version -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding InstalledVersionDisplay, StringFormat='已装: {0}'}"
                                           FontSize="12" Foreground="{DynamicResource OnSurfaceBrush}" />
                                <TextBlock Text="{Binding Entry.LatestVersion, StringFormat='  |  latest: {0}'}"
                                           FontSize="12" Foreground="{DynamicResource OnSurfaceBrush}" />
                            </StackPanel>

                            <!-- Row 4: v0.6.14 T4 version dropdown + LastUpdate meta
                                 ComboBox:StatusKind=NotInstalled 显示(只有未装条目允许选版本
                                 安装;已装条目只能卸载,不暴露版本选择免得误导)。
                                 LastUpdate:raw_metadata.LastUpdate(ISO 8601)显示 —
                                 updated 信息对选择安装哪个版本有用。 -->
                            <Grid Grid.Row="4" Grid.Column="0" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="选择版本:" VerticalAlignment="Center"
                                           Margin="0,0,6,0" FontSize="12"
                                           Foreground="{DynamicResource OnSurfaceBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Installed">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Outdated">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Versions}"
                                          SelectedItem="{Binding SelectedVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="DisplayLabel"
                                          MinWidth="120">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Installed">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Outdated">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource OutlineBrush}"
                                           Text="{Binding Entry.LastUpdate, StringFormat='更新: {0}'}" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Row 4: footer with cancel -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0"
                    HorizontalAlignment="Right">
            <TextBlock Text="双击未装条目 或 点击行内安装 / 卸载按钮"
                       FontSize="11" Foreground="{DynamicResource OutlineBrush}"
                       VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button Content="取消" Command="{Binding CancelCommand}"
                    Style="{StaticResource MaterialButton}" Width="80" />
        </StackPanel>
    </Grid>
</Window>
