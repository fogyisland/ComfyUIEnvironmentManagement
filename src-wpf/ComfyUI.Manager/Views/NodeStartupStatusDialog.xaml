<Window x:Class="ComfyUI.Manager.Views.NodeStartupStatusDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ComfyUI.Manager.ViewModels"
        xmlns:models="clr-namespace:ComfyUI.Manager.Models"
        Title="{Binding Title}"
        Width="560" Height="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}">
    <DockPanel Margin="14">
        <!-- 标题 + 副文本 -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource OnSurfaceBrush}" />
            <TextBlock Text="{Binding Summary}" FontSize="12" Margin="0,4,0,0"
                       Foreground="{DynamicResource OutlineBrush}" />
        </StackPanel>

        <!-- 底部关闭按钮 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="关闭" MinWidth="80"
                    Style="{StaticResource MaterialButton}"
                    Command="{Binding CloseCommand}" />
        </StackPanel>

        <!-- 节点列表(单 ListBox,行内 ✓/✗ + package + LoadError) -->
        <Border Padding="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <!-- 空状态 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding Nodes.Count, Converter={StaticResource ZeroCountToVisibility}}">
                    <TextBlock Text="∅" FontSize="48" HorizontalAlignment="Center"
                               Foreground="{DynamicResource OutlineBrush}" />
                    <TextBlock Text="无节点记录" FontSize="14" Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource OnSurfaceBrush}" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Nodes}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch"
                         Visibility="{Binding Nodes.Count, Converter={StaticResource InverseZeroCountToVisibility}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ScannedNode}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- ✓ / ✗ 状态图标:失败行用 ErrorBrush 红字 -->
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           FontSize="16" FontWeight="Bold"
                                           TextAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="✓" />
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasLoadError}" Value="True">
                                                    <Setter Property="Text" Value="✗" />
                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- 包名 + 错误信息 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <!-- 第一行:package + [import failed] 标签(Run 不能挂 Visibility,
                                         所以失败标签走单独 TextBlock + DataTrigger,失败时跟 package
                                         同行显示,成功时 hidden;整行 package 名走 trigger 决定红/普通色)。 -->
                                    <TextBlock FontSize="13" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasLoadError}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{Binding Package, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock FontSize="11" Margin="0,2,0,0"
                                               FontStyle="Italic"
                                               Foreground="{DynamicResource ErrorBrush}"
                                               Text="[import failed]"
                                               Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVisibility}}" />
                                    <!-- 失败时显示错误原文(单行截断),成功时不显示 -->
                                    <TextBlock Text="{Binding LoadErrorDisplay}"
                                               FontSize="11" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource OutlineBrush}"
                                               ToolTip="{Binding LoadErrorDisplay}"
                                               Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </DockPanel>
</Window>