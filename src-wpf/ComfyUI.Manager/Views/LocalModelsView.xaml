<UserControl x:Class="ComfyUI.Manager.Views.LocalModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ComfyUI.Manager.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LocalModelsViewModel}"
             Background="{DynamicResource BackgroundBrush}">
    <!--
      v1.0.0 T2:本地模型视图。
      Layout: 顶部 toolbar (title + kind filter chip strip + 刷新) → loading/empty/card grid。
      参考 WorkflowMarketplaceView 的 toolbar 风格 + ModelMarketplaceView 的 2-col card grid。
      RadioButton 用 OneWay IsChecked 经 MultiBinding + KindChipEquality converter 拿
      [VM.ActiveChip via RelativeSource, chip item itself] → Equals → bool(T2 fix r1:
      不能用 ConverterParameter={Binding} — WPF 在 DataTemplate 里把 Binding 实例赋给
      ConverterParameter 会抛 XamlParseException,跟 v0.6.14 PickerFilterEqualsConverter
      同样的 pattern)。
      点击通过 code-behind Tag-based setter 改 VM.ActiveChip。
      EmptyMessage 不为空时:empty state Border (IsEmpty=True) 盖住 card grid;
      EmptyMessage 为 null 时:card grid ScrollViewer (IsEmpty=False) 显示。
    -->
    <UserControl.Resources>
        <Style x:Key="KindChipRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceVariantBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <!-- v1.0.0 Console panel:Height=Auto 让 Border Collapsed 时行塌成 0,
                 Visible 时按 Border 实际高度 ~ 标题 + ScrollViewer Height=160 = ~200px。 -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 顶部 toolbar + kind filter strip ============ -->
        <Border Grid.Row="0" Padding="12" Margin="0,0,0,12"
                Background="{DynamicResource SurfaceBrush}" CornerRadius="6">
            <DockPanel>
                <!-- 右侧:刷新中…指示 + 刷新按钮。IsBusy=true 时(background refresh 在跑)
                     "刷新中…"label 出现,刷新按钮 disabled(防止并发 scan)。
                     user 看到的语义:"刷新中…"= 静默更新现有数据,而不是 "加载中… 旧数据全清"。 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="刷新中…"
                               Foreground="Gray" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               Visibility="{Binding IsRefreshingInBackground, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="🔄 刷新"
                            Command="{Binding ReloadCommand}"
                            Style="{StaticResource MaterialButton}" MinWidth="80" />
                </StackPanel>
                <TextBlock Text="本地模型" FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <ItemsControl ItemsSource="{Binding KindChips, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="KindFilter"
                                         Content="{Binding Display, Mode=OneWay}"
                                         Tag="{Binding}"
                                         Margin="0,0,6,0"
                                         Checked="KindChip_Checked"
                                         Style="{StaticResource KindChipRadioStyle}">
                                <RadioButton.IsChecked>
                                    <MultiBinding Converter="{StaticResource KindChipEquality}" Mode="OneWay">
                                        <Binding Path="DataContext.ActiveChip"
                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        <Binding />
                                    </MultiBinding>
                                </RadioButton.IsChecked>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- ============ Loading / Empty / Cards ============ -->
        <Grid Grid.Row="1">
            <!-- 加载中 overlay:只在 IsBusy && _allCards.Count==0 时显示(首屏或被外部清空后)。
                 已有卡片时(切走再回来 + background refresh)overlay 不出现 — 直接显示现有 card grid,
                 toolbar 的"刷新中…"指示让用户知道正在更新。这是用户反馈 "一直出在加载中" 的修复。 -->
            <TextBlock Text="加载中..."
                       Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding ShowLoadingOverlay, Converter={StaticResource BoolToVisibility}}" />

            <!-- Empty state:只在 VM.IsEmpty=true 时显示 (EmptyMessage 非空)。
                 IsEmpty 而不是 NullToVisibilityConverter invert — NullToVisibilityConverter
                 不支持 ConverterParameter=invert (Views/Converters.cs:32-44)。 -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6"
                    Padding="20"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📦" FontSize="48" HorizontalAlignment="Center" Foreground="Gray" />
                    <TextBlock Text="{Binding EmptyMessage, Mode=OneWay}"
                               FontSize="14" Foreground="Gray"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- Card grid:VM.IsEmpty=false 时显示。 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding FilteredModels, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="540" Height="250" Margin="0,0,12,12"
                                    Background="{DynamicResource SurfaceBrush}"
                                    CornerRadius="6" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 左:80x80 preview image OR kind badge fallback (v1.0.0 T10) -->
                                    <Grid Grid.Column="0" Width="80" Height="80" Margin="0,0,12,0" VerticalAlignment="Top">
                                        <!-- Image: 有 PreviewImagePath 时显示 -->
                                        <Border CornerRadius="6"
                                                Background="{DynamicResource SurfaceVariantBrush}"
                                                Visibility="{Binding PreviewImagePath, Converter={StaticResource InverseNullToVisibility}}">
                                            <Image Source="{Binding PreviewImagePath, Mode=OneWay}"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                        <!-- Kind badge: 无 PreviewImagePath 时显示 (T7 既有 badge fallback) -->
                                        <Border Background="{Binding Kind, Converter={StaticResource ModelKindBadgeBrush}}"
                                                CornerRadius="6"
                                                Visibility="{Binding PreviewImagePath, Converter={StaticResource NullToVisibility}}">
                                            <TextBlock Text="{Binding Kind, Mode=OneWay}"
                                                       Foreground="{DynamicResource OnPrimaryBrush}"
                                                       FontWeight="Bold" FontSize="11"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- 右:title + meta + lookup button (T11 加 button row, 卡片 height 220 → 250) -->
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Title, Mode=OneWay}"
                                                   FontSize="15" FontWeight="Bold"
                                                   TextWrapping="Wrap" MaxHeight="44" />
                                        <TextBlock Foreground="Gray" FontSize="11" Margin="0,4,0,0">
                                            <Run Text="📦 " />
                                            <Run Text="{Binding VersionCount, Mode=OneWay}" />
                                            <Run Text=" 个版本" />
                                        </TextBlock>
                                        <TextBlock Foreground="Gray" FontSize="11" Margin="0,2,0,0">
                                            <Run Text="🌐 " />
                                            <Run Text="{Binding Source, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Foreground="Gray" FontSize="11" Margin="0,2,0,0">
                                            <Run Text="📅 " />
                                            <Run Text="{Binding LatestDownloadedAt, Mode=OneWay, StringFormat='{}{0:yyyy-MM-dd}', TargetNullValue='—'}" />
                                        </TextBlock>
                                        <!-- v1.0.0.x: 用户覆盖的本地路径(蓝色 badge) + 复制按钮 + 编辑按钮。
                                             LocalPathOverride 非空时显示「✏ 覆盖中」badge 提示用户该卡走自定义路径;
                                             路径文本 monospace + 横向滚动(text 过长时);📋 复制走 Clipboard;📁 编辑
                                             弹 EditLocalPathDialog → VM.SetOverridePath → 写 SQLite + 重建 card。 -->
                                        <Border Margin="0,4,0,0" Padding="4,2" CornerRadius="3"
                                                Background="#E3F2FD"
                                                Visibility="{Binding LocalPathOverride, Converter={StaticResource NullToVisibility}}"
                                                HorizontalAlignment="Left">
                                            <TextBlock FontSize="10" Foreground="#1976D2" FontWeight="SemiBold">
                                                <Run Text="✏ 覆盖中"/>
                                            </TextBlock>
                                        </Border>
                                        <DockPanel Margin="0,2,0,0">
                                            <Button DockPanel.Dock="Right" Content="📋"
                                                    Margin="4,0,0,0" Padding="6,1"
                                                    ToolTip="复制本地路径到剪贴板"
                                                    Click="CopyLocalPath_Click"
                                                    Tag="{Binding}" />
                                            <Button DockPanel.Dock="Right" Content="📁"
                                                    Margin="2,0,0,0" Padding="6,1"
                                                    ToolTip="编辑本地路径"
                                                    Click="EditLocalPath_Click"
                                                    Tag="{Binding}" />
                                            <TextBlock Text="{Binding LocalPathOverride, Mode=OneWay}"
                                                       FontFamily="Consolas" FontSize="10"
                                                       Foreground="#555"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{Binding LocalPathOverride, Mode=OneWay}"/>
                                        </DockPanel>
                                        <!-- v1.0.0 T11:CivitAI lookup 按钮 — Source == "Local" 时显示。
                                             meta.json / civitai / huggingface 卡片(Source != "Local")按钮隐藏 —
                                             这些卡已有 SourceUrl 直接 web 跳转,不需要再查一遍。
                                             CardSourceVisibility converter:Source (string) == "Local" → Visible。
                                             Command 通过 DataContext.RelativeSource 拿 VM 的 LookupCivitAiCommand,
                                             parameter 是当前 card(record — WPF 自动装箱成 object)。 -->
                                        <Button Content="🔍 查询 CivitAI"
                                                Margin="0,4,0,0" Padding="12,4"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding Source, Converter={StaticResource CardSourceVisibility}, ConverterParameter=Local}"
                                                Command="{Binding DataContext.LookupCivitAiCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <!-- v1.0.0 T13-7:status dot — bottom-right of card。
                                         MatchedDetail 非 null → 绿 / null → 灰。
                                         Tooltip 显示 MatchSource enum 的人话描述。 -->
                                    <Ellipse Width="10" Height="10" Margin="0,0,4,4"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Fill="{Binding MatchedDetail, Converter={StaticResource MatchStatusToBrush}}"
                                             ToolTip="{Binding MatchSource, Converter={StaticResource MatchSourceToTooltip}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- v1.0.0 Console panel:实景监控 scanner hash/match 进度 ([hash] cache hit/computed、
             [scan] ⚠ hash failed、[match] N/M Title → Source、[preview] saved/failed 等行)。
             三态可见性(!_userHiddenConsole && (IsBusy || ConsoleLog.Count > 0))由 VM IsConsoleVisible 计算,
             Visibility binding 接管 — Border Collapsed 时 Grid.Row 2 (Height=Auto) 塌成 0 不抢空间。
             镜像 BulkUpdateView 的 console 风格(SurfaceBrush/OutlineBrush/Border/CornerRadius 6 +
             Consolas monospace)保持视觉一致。Auto-scroll 由 code-behind 订阅 ConsoleLog.CollectionChanged
             调 ScrollToEnd 实现,新行追加时自动滚到底,用户无需手动滚。 -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding IsConsoleVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="12,8,8,4">
                    <Button DockPanel.Dock="Right" Content="✕"
                            Style="{StaticResource GearIconButtonStyle}"
                            Foreground="{DynamicResource OnSurfaceBrush}"
                            Click="OnConsoleCloseClicked"
                            ToolTip="关闭 Console(下次刷新时自动重新打开)" />
                    <TextBlock VerticalAlignment="Center" FontWeight="Bold" FontSize="13"
                               Foreground="{DynamicResource OnSurfaceBrush}">
                        <Run Text="Console" />
                        <Run Text="  " />
                        <Run Text="{Binding ConsoleLog.Count, Mode=OneWay}" FontSize="11"
                             Foreground="{DynamicResource OutlineBrush}" />
                        <Run Text=" 行" FontSize="11" Foreground="{DynamicResource OutlineBrush}" />
                    </TextBlock>
                </DockPanel>
                <ScrollViewer x:Name="ConsoleScrollViewer" Grid.Row="1"
                              Height="160" Margin="8,0,8,8"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ConsoleLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"
                                           TextWrapping="NoWrap"
                                           Foreground="{DynamicResource OnSurfaceBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
