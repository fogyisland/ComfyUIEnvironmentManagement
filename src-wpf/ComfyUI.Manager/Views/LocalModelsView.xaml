<UserControl x:Class="ComfyUI.Manager.Views.LocalModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ComfyUI.Manager.ViewModels"
             xmlns:controls="clr-namespace:ComfyUI.Manager.Controls"
             xmlns:views="clr-namespace:ComfyUI.Manager.Views.LocalModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LocalModelsViewModel}"
             Background="{DynamicResource BackgroundBrush}">
    <!--
      v1.0.0 T2:本地模型视图。
      Layout: 顶部 toolbar (title + kind filter chip strip + 刷新) → loading/empty/card grid。
      参考 WorkflowMarketplaceView 的 toolbar 风格 + ModelMarketplaceView 的 2-col card grid。
      RadioButton 用 OneWay IsChecked 经 MultiBinding + KindChipEquality converter 拿
      [VM.ActiveChip via RelativeSource, chip item itself] → Equals → bool(T2 fix r1:
      不能用 ConverterParameter={Binding} — WPF 在 DataTemplate 里把 Binding 实例赋给
      ConverterParameter 会抛 XamlParseException,跟 v0.6.14 PickerFilterEqualsConverter
      同样的 pattern)。
      点击通过 code-behind Tag-based setter 改 VM.ActiveChip。
      EmptyMessage 不为空时:empty state Border (IsEmpty=True) 盖住 card grid;
      EmptyMessage 为 null 时:card grid ScrollViewer (IsEmpty=False) 显示。
    -->
    <UserControl.Resources>
        <Style x:Key="KindChipRadioStyle" TargetType="RadioButton">
            <!-- v1.0.0.x (2026-09-17) T46i.1 fix:KindChip 选中态给 3D 描边效果。
                 之前 IsChecked=True 只切 Background=PrimaryBrush(Light 主题 #1C1B1F 深黑)
                 → 用户反馈"纯黑 应该和按钮一样选中呈现三维效果"。
                 修法:加 BorderThickness=1 + BorderBrush=OutlineBrush 让选中态有描边立体感。
                 Background 改用 SurfaceVariantBrush(浅灰紫 #E7E0EC / 深灰 #49454F)避免纯黑。
                 Foreground 保持 OnSurfaceBrush,语义对比不变。
                 Unselected 透明 + MouseOver SurfaceVariantBrush 不变。 -->
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceVariantBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceVariantBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <!-- v1.0.0 Console panel:Height=Auto 让 Border Collapsed 时行塌成 0,
                 Visible 时按 Border 实际高度 ~ 标题 + ScrollViewer Height=160 = ~200px。 -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 顶部 toolbar + kind filter strip ============ -->
        <Border Grid.Row="0" Padding="12" Margin="0,0,0,12"
                Background="{DynamicResource SurfaceBrush}" CornerRadius="6">
            <DockPanel>
                <!-- 右侧:🔎 CivitAI 查询 + 刷新中…指示 + 刷新按钮。
                     v1.0.0.x:CivitAI 查询按钮 toolbar 形态(选中卡片生效)— 用户点 card 设
                     SelectedCard,button IsEnabled 走 IsLookupEnabledForSelectedCard。
                     取代之前 inline per-card「🔍 查询 CivitAI」(inline 按钮还留着但 redundant — 隐藏)。
                     IsRefreshingInBackground / 🔄 刷新 行为不变。 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="刷新中…"
                               Foreground="Gray" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               Visibility="{Binding IsRefreshingInBackground, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="🔄 刷新"
                            Command="{Binding ReloadCommand}"
                            Style="{StaticResource MaterialButton}" MinWidth="80" Margin="0,0,8,0" />
                    <Button Content="🔎 CivitAI 查询"
                            Command="{Binding LookupCivitAiCommand}"
                            Style="{StaticResource MaterialButton}" MinWidth="120"
                            ToolTip="对当前选中的本地模型卡查询 CivitAI 详情(先点卡片选中)"
                            IsEnabled="{Binding IsLookupEnabledForSelectedCard}" />
                </StackPanel>
                <!-- v1.0.0.x (2026-09-17) T46:顶部搜索框 — 借鉴 SwarmUI UX。
                     TextBox.Text 两-way binding 到 VM.SearchText (UpdateSourceTrigger=PropertyChanged:
                     每键即触发 setter → 1ms DispatcherTimer 防抖 → ApplyFilter 重算 FilteredModels)。
                     ✕ 清空按钮 Visibility 绑 SearchText — 非空时 Visible,空时 Collapsed
                     (StringNotEmptyToVisibility 已在 Theme.xaml 全局注册)。
                     placeholder 文本走 ToolTip(简洁;WPF TextBox 原生无 placeholder 跨平台 way)。 -->
                <Border DockPanel.Dock="Left"
                        Background="{DynamicResource SurfaceVariantBrush}"
                        CornerRadius="4" Padding="8,2" Margin="0,0,12,0"
                        VerticalAlignment="Center" MinWidth="240" MaxWidth="400">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="✕" Foreground="Gray"
                                   Cursor="Hand" Margin="6,0,0,0" VerticalAlignment="Center"
                                   FontSize="13" ToolTip="清空搜索"
                                   MouseLeftButtonUp="OnClearSearchClick"
                                   Visibility="{Binding SearchText, Converter={StaticResource StringNotEmptyToVisibility}}" />
                        <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource OnSurfaceBrush}"
                                 VerticalAlignment="Center"
                                 ToolTip="🔍 search models... (即时搜索,匹配 title/source/kind 等)"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                </Border>
                <TextBlock Text="本地模型" FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <ItemsControl ItemsSource="{Binding KindChips, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="KindFilter"
                                         Content="{Binding Display, Mode=OneWay}"
                                         Tag="{Binding}"
                                         Margin="0,0,6,0"
                                         Checked="KindChip_Checked"
                                         Style="{StaticResource KindChipRadioStyle}">
                                <RadioButton.IsChecked>
                                    <MultiBinding Converter="{StaticResource KindChipEquality}" Mode="OneWay">
                                        <Binding Path="DataContext.ActiveChip"
                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        <Binding />
                                    </MultiBinding>
                                </RadioButton.IsChecked>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- ============ Loading / Empty / Cards ============ -->
        <Grid Grid.Row="1">
            <!-- 加载中 overlay:只在 IsBusy && _allCards.Count==0 时显示(首屏或被外部清空后)。
                 已有卡片时(切走再回来 + background refresh)overlay 不出现 — 直接显示现有 card grid,
                 toolbar 的"刷新中…"指示让用户知道正在更新。这是用户反馈 "一直出在加载中" 的修复。 -->
            <TextBlock Text="加载中..."
                       Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding ShowLoadingOverlay, Converter={StaticResource BoolToVisibility}}" />

            <!-- Empty state:只在 VM.IsEmpty=true 时显示 (EmptyMessage 非空)。
                 IsEmpty 而不是 NullToVisibilityConverter invert — NullToVisibilityConverter
                 不支持 ConverterParameter=invert (Views/Converters.cs:32-44)。 -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6"
                    Padding="20"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📦" FontSize="48" HorizontalAlignment="Center" Foreground="Gray" />
                    <TextBlock Text="{Binding EmptyMessage, Mode=OneWay}"
                               FontSize="14" Foreground="Gray"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- v1.0.0.x (2026-09-17) T47:ContentControl + ViewModeTemplateSelector 路由 3 视图
                 (Cards / List / Thumbnails)。Cards 默认显示 — FallbackValue 给设计器 / 启动期 VM 未注入时用。
                 Content="{Binding ActiveViewMode}" — T6 才加 ActiveViewMode INPC property,
                 本 task 临时接受 binding 失败(显示默认),T6 会修。XAML 编译不报错(只是运行时 binding warning)。
                 3 个 UserControl + selector 的 DataTemplate 在 Theme.xaml 全局注册(CardsViewTemplate /
                 ListViewTemplate / ThumbnailsViewTemplate),DataType="{x:Type sys:Int32}" 让
                 selector 拿 enum boxed Int32 路由。 -->
            <ContentControl Content="{Binding ActiveViewMode, FallbackValue={x:Static views:ViewMode.Cards}}"
                            Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                <ContentControl.ContentTemplateSelector>
                    <views:ViewModeTemplateSelector
                        CardsTemplate="{StaticResource CardsViewTemplate}"
                        ListTemplate="{StaticResource ListViewTemplate}"
                        ThumbnailsTemplate="{StaticResource ThumbnailsViewTemplate}" />
                </ContentControl.ContentTemplateSelector>
            </ContentControl>
        </Grid>

        <!-- v1.0.0.x #590:Console 面板抽取到 Controls/ConsolePanel.xaml — terminal 深灰底浅字风格。
             三态可见性(!_userHiddenConsole && (IsBusy || ConsoleLog.Count > 0))由 VM IsConsoleVisible 计算,
             Visibility binding 接管 — ConsolePanel Collapsed 时 Grid.Row 2 (Height=Auto) 塌成 0 不抢空间。
             Auto-scroll 由 ConsolePanel 内部订阅 Lines.CollectionChanged → ScrollToEnd。 -->
        <controls:ConsolePanel Grid.Row="2" Margin="0,12,0,0"
                               Lines="{Binding ConsoleLog}"
                               Title="Console"
                               ConsoleCloseRequested="OnConsoleCloseRequested"
                               Visibility="{Binding IsConsoleVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
    </Grid>
</UserControl>
