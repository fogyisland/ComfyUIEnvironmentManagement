<Window x:Class="ComfyUI.Manager.Views.EditLocalPathDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑本地路径" Height="320" Width="560"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: card title + kind -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="{Binding Card.Title}" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock FontSize="11" Foreground="{DynamicResource OutlineBrush}">
                <Run Text="Kind: "/><Run Text="{Binding Card.Kind}"/>
                <Run Text="  •  Source: "/><Run Text="{Binding Card.Source}"/>
            </TextBlock>
        </StackPanel>

        <!-- Label + path TextBox -->
        <TextBlock Grid.Row="1" Text="本地绝对路径" Margin="0,8,0,4" FontWeight="SemiBold"/>
        <DockPanel Grid.Row="2">
            <Button DockPanel.Dock="Right" Content="浏览..." Margin="4,0,0,0"
                    Click="Browse_Click"/>
            <TextBox x:Name="PathBox" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>

        <!-- Default info + checkbox -->
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock FontSize="11" Foreground="{DynamicResource OutlineBrush}" TextWrapping="Wrap">
                <Run Text="scanner 推算路径: "/><Run Text="{Binding DefaultFullPath, Mode=OneWay}"/>
            </TextBlock>
            <CheckBox Content="恢复默认(scanner 推算路径)" Margin="0,8,0,0"
                      IsChecked="{Binding ClearOverride}"/>
        </StackPanel>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="80" Margin="0,0,8,0"
                    IsCancel="True" Click="Cancel_Click"/>
            <Button Content="保存" Width="80"
                    IsDefault="True"
                    Click="Save_Click"
                    IsEnabled="{Binding CanConfirm}"/>
        </StackPanel>
    </Grid>
</Window>