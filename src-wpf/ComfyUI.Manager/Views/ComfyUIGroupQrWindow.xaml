<Window x:Class="ComfyUI.Manager.Views.ComfyUIGroupQrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="460" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="True">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </Window.InputBindings>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="{Binding Title}"
                   FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,8" />

        <!-- 提示 -->
        <TextBlock Grid.Row="1" Text="{Binding Hint}"
                   FontSize="12" Foreground="Gray" TextWrapping="Wrap"
                   HorizontalAlignment="Center" Margin="0,0,0,12" />

        <!-- 二维码大图(原图比例显示,不裁剪 — 用户反馈 v1.0.0.x 原 280×280
             定宽高会把 396×396 原图等比缩小 + Border 内部裁切边缘。
             MaxWidth/MaxHeight + Stretch=Uniform 让图按原比例展示,
             仅在超过 420×520 时等比缩到上内,从不裁剪。-->
        <Border Grid.Row="2" Background="White" Padding="4" CornerRadius="4"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <Image x:Name="GroupImage" Stretch="Uniform"
                       MaxWidth="420" MaxHeight="500"
                       Visibility="{Binding HasGroupImage, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding PlaceholderText}" TextWrapping="Wrap"
                           FontSize="13" Foreground="Gray"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           MaxWidth="260"
                           Visibility="{Binding HasGroupImage, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- 关闭按钮 -->
        <Button Grid.Row="3" Content="关闭" Command="{Binding CloseCommand}"
                Style="{StaticResource MaterialButton}" HorizontalAlignment="Center"
                MinWidth="80" Margin="0,16,0,0" />
    </Grid>
</Window>
