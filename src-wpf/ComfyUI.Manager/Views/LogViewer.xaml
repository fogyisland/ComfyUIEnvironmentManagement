<UserControl x:Class="ComfyUI.Manager.Views.LogViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ComfyUI.Manager.Controls">
    <!-- v1.0.0.x #590:用 Controls/ConsolePanel 替换原 ListBox — terminal 深灰底浅字风格。
         ConsolePanel 自带 ✕ 关闭按钮 raise ConsoleCloseRequested;本 view 加一个独立的
         「清空」按钮(走 VM.ClearCommand,只清内容不关 dialog);Lines 是 ObservableCollection<string>
         由 LogViewerViewModel 维护(LogLine.Text 投影)。 -->
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"
                    HorizontalAlignment="Right">
            <Button Content="清空"
                    Command="{Binding ClearCommand}"
                    Style="{StaticResource MaterialButton}" />
        </StackPanel>
        <controls:ConsolePanel Title="日志"
                               Lines="{Binding Lines}"
                               ConsoleCloseRequested="OnConsoleCloseClicked" />
    </DockPanel>
</UserControl>
