            <!-- ============ v0.6.19:工作流市场 ============ -->
            <TextBlock x:Name="SectionWorkflows" Text="工作流市场" FontSize="16" FontWeight="Bold" Margin="0,24,0,8" />
            <TextBlock Text="共享 workflows 目录(留空 = 默认 workflows/),以及 3 个工作流来源的开关。"
                       Foreground="Gray" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap" MaxWidth="480"
                       HorizontalAlignment="Left" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                <TextBlock Text="共享 workflows 目录" VerticalAlignment="Center"/>
                <TextBlock Text="⚠" FontSize="11" Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}"
                           ToolTip="尚未保存"
                           Visibility="{Binding Dirty[WorkflowsDirectory], Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
