<UserControl x:Class="ComfyUI.Manager.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ComfyUI.Manager.Views"
             xmlns:vm="clr-namespace:ComfyUI.Manager.ViewModels"
             xmlns:controls="clr-namespace:ComfyUI.Manager.Controls"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- v0.6.11+ SDD B T1:粘性 Save toolbar -->
        <Border Grid.Row="0" Padding="12,8"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="设置"
                           FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="{DynamicResource WarningBrush}"
                               Text="{Binding UnsavedCount, StringFormat='⚠ {0} 项未保存'}"
                               Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Content="↩ 放弃" Width="80" Margin="0,0,8,0"
                            Style="{StaticResource MaterialButton}"
                            Command="{Binding DiscardCommand}"/>
                    <Button Content="💾 保存" Width="80"
                            Style="{StaticResource MaterialButton}"
                            Command="{Binding SaveCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16" MaxWidth="640" HorizontalAlignment="Left">

            <!-- ============ 基础 ============ -->
            <TextBlock x:Name="SectionGeneral" Text="基础" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                <TextBlock Text="语言" VerticalAlignment="Center"/>
                <TextBlock Text="⚠" FontSize="11" Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}"
                           ToolTip="尚未保存"
                           Visibility="{Binding Dirty[Language], Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"
                      Width="240" HorizontalAlignment="Left" />
            <!-- v0.6.9.3 T5:删 "主题模式" ComboBox — ThemeToggleButton 是唯一入口。
                 ThemeMode property 仍保留(SettingsViewModel ctor 启动时调 ThemeService.Apply 持久化恢复)。 -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                <TextBlock Text="Catalog 缓存 TTL(分钟)" VerticalAlignment="Center"/>
                <TextBlock Text="⚠" FontSize="11" Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}"
                           ToolTip="尚未保存"
                           Visibility="{Binding Dirty[CacheTtlMinutes], Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <TextBox Text="{Binding CacheTtlMinutes, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource MaterialTextBox}" Width="240"
                     HorizontalAlignment="Left" />

            <!-- v0.6.7.1: ComfyUI 启动就绪超时 -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                <TextBlock Text="ComfyUI 启动就绪超时(秒)" VerticalAlignment="Center"/>
                <TextBlock Text="⚠" FontSize="11" Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}"
                           ToolTip="尚未保存"
                           Visibility="{Binding Dirty[ComfyUiStartupTimeoutSeconds], Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <TextBox Text="{Binding ComfyUiStartupTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource MaterialTextBox}" Width="240"
                     HorizontalAlignment="Left" />
            <TextBlock Text="默认 600 秒(10 分钟)。ComfyUI 首次启动编译 kernel / 加载大模型可能需要几分钟。"
                       FontSize="11" Foreground="Gray" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="480"
                       HorizontalAlignment="Left" />

            <!-- v0.6.7.2: ComfyUI UI locale —— 启动前写到 <comfyui>/user/default/comfy.settings.json -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                <TextBlock Text="ComfyUI 界面语言" VerticalAlignment="Center"/>
                <TextBlock Text="⚠" FontSize="11" Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}"
                           ToolTip="尚未保存"
                           Visibility="{Binding Dirty[ComfyUiLocale], Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <ComboBox ItemsSource="{Binding ComfyUiLocales}"
                      SelectedItem="{Binding ComfyUiLocale}"
                      Width="240" HorizontalAlignment="Left" />
            <TextBlock Text="留空 = 不修改 ComfyUI 配置;其他值(zh/en/ja/ko/ru/fr/es)启动 env 时写入 ComfyUI 的 user/default/comfy.settings.json 的 Comfy.Locale 字段。"
                       FontSize="11" Foreground="Gray" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="480"
                       HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                <TextBlock Text="外部冲突 API URL" VerticalAlignment="Center"/>
                <TextBlock Text="⚠" FontSize="11" Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}"
                           ToolTip="尚未保存"
                           Visibility="{Binding Dirty[CompatApiBaseUrl], Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <TextBox Text="{Binding CompatApiBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource MaterialTextBox}" Width="480"
                     HorizontalAlignment="Left" />

            <!-- v0.6.10: 全局默认 Models 目录(放共享 Models 目录之上,作为更常用的入口) -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                <TextBlock Text="全局默认 Models 目录(留空 = 不动 env 的 models 目录)" VerticalAlignment="Center"/>
                <TextBlock Text="⚠" FontSize="11" Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}"
                           ToolTip="尚未保存"
                           Visibility="{Binding Dirty[DefaultModelsDirectory], Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <DockPanel Margin="0,2,0,0">
                <Button DockPanel.Dock="Right" Content="浏览..."
                        Click="BrowseDefaultModelsDirectory"
                        Style="{StaticResource MaterialButton}" Margin="4,0,0,0" />
                <TextBox Text="{Binding DefaultModelsDirectory, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialTextBox}" />
            </DockPanel>
            <TextBlock Text="新建 env 时 junction &lt;env&gt;/ComfyUI/models 到此路径;留空则 env 自己保留本地 models。"
                       Foreground="Gray" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="480"
                       HorizontalAlignment="Left" />

            <!-- v0.6.12: 日志根目录(Logs/ 子目录的父目录)。空 = 默认 <安装目录>。
                 v0.6.12 hotfix:Browse 按钮补上(原 MVP 略去,见 SettingsViewModel.BrowseLogDirectoryCommand)。 -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                <TextBlock Text="日志目录" VerticalAlignment="Center"/>
                <TextBlock Text="⚠" FontSize="11" Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}"
                           ToolTip="尚未保存"
                           Visibility="{Binding Dirty[LogDirectory], Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <DockPanel Margin="0,2,0,0">
                <Button DockPanel.Dock="Right" Content="浏览..."
                        Command="{Binding BrowseLogDirectoryCommand}"
                        Style="{StaticResource MaterialButton}" Margin="4,0,0,0" />
                <TextBox Text="{Binding LogDirectory, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialTextBox}" />
            </DockPanel>
            <TextBlock Text="日志文件夹位置(Logs/ 子目录会创建在此目录下);默认 seed 当前项目根下的 logs/ 绝对路径。"
                       Foreground="Gray" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="480"
                       HorizontalAlignment="Left" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                <TextBlock Text="GitHub Token(可选 — 配置后刷新 catalog 时会同步拉取各节点最新版本号,留空则不拉)"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                <TextBlock Text="⚠" FontSize="11" Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}"
                           ToolTip="尚未保存"
                           Visibility="{Binding Dirty[GitHubToken], Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <PasswordBox x:Name="GitHubTokenBox" Width="480" HorizontalAlignment="Left"
                         PasswordChanged="OnGitHubTokenChanged" />
            <TextBlock Text="仅保存在本地 settings.json,不会上传到任何服务器"
                       Foreground="Gray" FontSize="11" Margin="0,2,0,0" />

            <!-- v0.6.11 T3: 开关 gate — 关闭 = 不拉节点版本号(默认,向后兼容);
                 开启 = 即使没配 token 也尝试拉 GitHub releases(无鉴权 60/h 限流,
                 失败 fail-soft,不抛)。这两个 property 互不约束:开关决定"拉不拉",
                 token 决定"是否鉴权"。 -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox Content="刷新时拉取节点版本(无 token 会被 GitHub 限流 60/h)"
                          IsChecked="{Binding FetchNodeVersionsOnRefresh}"
                          VerticalAlignment="Center"/>
                <TextBlock Text="⚠" FontSize="11" Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}"
                           ToolTip="尚未保存"
                           Visibility="{Binding Dirty[FetchNodeVersionsOnRefresh], Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <!-- v0.6.13-B: 开关 gate — 关闭 = 不拉 GitHub metadata(默认,向后兼容);
                 开启 = refresh catalog 同步给每条 entry 填 License/Tags/Stars/Downloads/
                 LastCommit/Readme/Changelog/Deprecated/PythonCompat/OsCompat(无 token
                 会被 GitHub 限流 60/h,失败 fail-soft 不抛)。和上面版本号开关互不约束,
                 各走各的 GitHub endpoint。结果本地缓存 24h,二次刷新走缓存不重拉。 -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <CheckBox Content="刷新时拉取节点 GitHub 元信息(License/Stars/Tags/Readme 等,慢且限流)"
                          IsChecked="{Binding FetchCatalogMetadata}"
                          VerticalAlignment="Center"/>
                <TextBlock Text="⚠" FontSize="11" Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}"
                           ToolTip="尚未保存"
                           Visibility="{Binding Dirty[FetchCatalogMetadata], Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <!-- ============ 查询节点的源 ============ -->
            <TextBlock x:Name="SectionQuerySources" Text="查询节点的源" FontSize="16" FontWeight="Bold" Margin="0,24,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="当前使用" VerticalAlignment="Center"/>
                <TextBlock Text="⚠" FontSize="11" Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}"
                           ToolTip="尚未保存"
                           Visibility="{Binding Dirty[ActiveQuerySource], Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <ComboBox ItemsSource="{Binding QuerySources}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding ActiveQuerySource, Mode=TwoWay}"
                      Width="320" HorizontalAlignment="Left" />
            <ItemsControl ItemsSource="{Binding QuerySources}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Url}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <Button Grid.Column="2" Content="删除" Margin="8,0,0,0"
                                    Command="{Binding DataContext.RemoveQuerySourceCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource MaterialButton}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="+ 添加查询源" Margin="0,8,0,0" HorizontalAlignment="Left"
                    Command="{Binding AddQuerySourceCommand}"
                    Style="{StaticResource MaterialButton}" />
            <Grid Margin="0,8,0,0"
                  Visibility="{Binding IsAddQuerySourceOpen,
                                Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Style="{StaticResource MaterialTextBox}"
                         Text="{Binding NewQuerySourceName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Column="1" Style="{StaticResource MaterialTextBox}" Margin="8,0,0,0"
                         Text="{Binding NewQuerySourceUrl, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="2" Content="确定" Margin="8,0,0,0"
                        Command="{Binding ConfirmAddQuerySourceCommand}"
                        Style="{StaticResource MaterialButton}" />
                <Button Grid.Column="3" Content="取消" Margin="4,0,0,0"
                        Command="{Binding CancelAddQuerySourceCommand}"
                        Style="{StaticResource MaterialButton}" />
            </Grid>

            <!-- ============ 下载节点的源 ============ -->
            <TextBlock x:Name="SectionDownloadSources" Text="下载节点的源" FontSize="16" FontWeight="Bold" Margin="0,24,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="当前使用(URL 中可用 {node} 占位)" VerticalAlignment="Center"/>
                <TextBlock Text="⚠" FontSize="11" Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}"
                           ToolTip="尚未保存"
                           Visibility="{Binding Dirty[ActiveDownloadSource], Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <ComboBox ItemsSource="{Binding DownloadSources}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding ActiveDownloadSource, Mode=TwoWay}"
                      Width="320" HorizontalAlignment="Left" />
            <ItemsControl ItemsSource="{Binding DownloadSources}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Url}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <Button Grid.Column="2" Content="删除" Margin="8,0,0,0"
                                    Command="{Binding DataContext.RemoveDownloadSourceCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource MaterialButton}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="+ 添加下载源" Margin="0,8,0,0" HorizontalAlignment="Left"
                    Command="{Binding AddDownloadSourceCommand}"
                    Style="{StaticResource MaterialButton}" />
            <Grid Margin="0,8,0,0"
                  Visibility="{Binding IsAddDownloadSourceOpen,
                                Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Style="{StaticResource MaterialTextBox}"
                         Text="{Binding NewDownloadSourceName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Column="1" Style="{StaticResource MaterialTextBox}" Margin="8,0,0,0"
                         Text="{Binding NewDownloadSourceUrl, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="2" Content="确定" Margin="8,0,0,0"
                        Command="{Binding ConfirmAddDownloadSourceCommand}"
                        Style="{StaticResource MaterialButton}" />
                <Button Grid.Column="3" Content="取消" Margin="4,0,0,0"
                        Command="{Binding CancelAddDownloadSourceCommand}"
                        Style="{StaticResource MaterialButton}" />
            </Grid>

            <!-- ============ 路径 ============ -->
            <TextBlock x:Name="SectionPaths" Text="路径" FontSize="16" FontWeight="Bold" Margin="0,24,0,8" />

            <!-- v1.0.0.x #630: 系统模板库目录加回 Settings 页 ——
                 v1.0.0.x 用户改名为"模板路径",改用 ResolveAsAbsolute 自动 seed 当前项目根
                 下的绝对路径(类似 EnvsDir / LocalNodeDirectory 等本地资源路径)。
                 TemplatePathResolver 锚定此字段解析所有 built-in template 的 LocalSourceDir
                 (空 → fallback 到 AppContext.BaseDirectory 拼 dev bin/,污染 dev build,所以
                 不推荐空值)。默认 seed 绝对 <projectRoot>/ENVTemplate/。 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="模板路径(8 个内置模板源码根目录)" VerticalAlignment="Center"/>
                <TextBlock Text="⚠" FontSize="11" Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}"
                           ToolTip="尚未保存"
                           Visibility="{Binding Dirty[SystemTemplateLibraryDir], Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <DockPanel Margin="0,2,0,0">
                <Button DockPanel.Dock="Right" Content="浏览..."
                        Click="BrowseSystemTemplateLibraryDir"
                        Style="{StaticResource MaterialButton}" Margin="4,0,0,0" />
                <TextBox Text="{Binding SystemTemplateLibraryDir, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialTextBox}" />
            </DockPanel>
            <TextBlock Text="默认 seed 当前项目根下的 ENVTemplate/ 绝对路径;留空会退化到 bin/ 目录(dbg dev build)不建议。"
                       Foreground="Gray" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="480"
                       HorizontalAlignment="Left" />

            <!-- ============ v0.6.11++ Pip 镜像 ============ -->
            <TextBlock x:Name="SectionPipMirror" Text="Pip 镜像" FontSize="16" FontWeight="Bold" Margin="0,24,0,8" />
            <TextBlock Text="选择 pip 镜像源(影响 ComfyUI / ComfyUI Manager 依赖安装,BED 仍走 pytorch.org)"
                       FontSize="11" Foreground="Gray" Margin="0,0,0,8" TextWrapping="Wrap" MaxWidth="480"
                       HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                <TextBlock Text="镜像源" VerticalAlignment="Center"/>
                <TextBlock Text="⚠" FontSize="11" Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}"
                           ToolTip="尚未保存"
                           Visibility="{Binding Dirty[PipMirror], Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <ComboBox ItemsSource="{Binding PipMirrorKinds}"
                      SelectedItem="{Binding PipMirror, Mode=TwoWay}"
                      Width="240" HorizontalAlignment="Left" />
            <Grid Margin="0,8,0,0"
                  Visibility="{Binding IsCustomPipMirrorSelected,
                                Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="自定义 URL" VerticalAlignment="Center"/>
                    <TextBlock Text="⚠" FontSize="11" Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource WarningBrush}"
                               ToolTip="尚未保存"
                               Visibility="{Binding Dirty[PipMirrorCustomUrl], Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
                <TextBox Grid.Column="1" Style="{StaticResource MaterialTextBox}" Margin="8,0,0,0"
                         Text="{Binding PipMirrorCustomUrl, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <TextBlock Text="官方(不传 --index-url)|清华 TUNA|阿里云|USTC|自定义。" Foreground="Gray" FontSize="11"
                       Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="480" HorizontalAlignment="Left" />

            <!-- ============ v0.6.11++ 常规节点 ============ -->
            <TextBlock x:Name="SectionCommonNodes" Text="常规节点" FontSize="16" FontWeight="Bold" Margin="0,24,0,8" />
            <TextBlock Text="env-create 或装依赖末尾自动克隆以下节点(已装自动跳过)。Built-in 不可删,可取消勾选;User-added 可删可改 Id。"
                       Foreground="Gray" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap" MaxWidth="480"
                       HorizontalAlignment="Left" />
            <ItemsControl ItemsSource="{Binding CommonNodes}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding Enabled, Mode=OneWay}"
                                      Command="{Binding DataContext.ToggleCommonNodeEnabledCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}"
                                      VerticalAlignment="Center" Margin="0,0,8,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" />
                                <TextBlock Text="{Binding Id}" Foreground="Gray" FontSize="11" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="删除" Margin="8,0,0,0"
                                    Command="{Binding DataContext.RemoveCommonNodeCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding IsBuiltIn, Converter={StaticResource InverseBool}}"
                                    Style="{StaticResource MaterialButton}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <!-- v1.0.0.x:把 enabled=true 的常用节点批量 git clone 到 Settings.LocalNodesDirectory
                     (用户原话"将设置勾选的哪些节点 全部都下载到本地节点目录中")。已装自动跳过,
                     单包失败 warn 继续,busy 期间 disabled 防双击。-->
                <Button Content="下载到本地节点目录" Margin="0,0,8,0" HorizontalAlignment="Left"
                        Command="{Binding DownloadCommonNodesCommand}"
                        ToolTip="把上方勾选的节点 git clone 到 Settings.local_nodes_directory"
                        Style="{StaticResource MaterialButton}" />
                <Button Content="+ 添加节点" HorizontalAlignment="Left"
                        Command="{Binding AddCommonNodeCommand}"
                        Style="{StaticResource MaterialButton}" />
            </StackPanel>
            <Grid Margin="0,8,0,0"
                  Visibility="{Binding IsAddCommonNodeOpen,
                                Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Style="{StaticResource MaterialTextBox}"
                         Text="{Binding NewCommonNodeId, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Column="1" Style="{StaticResource MaterialTextBox}" Margin="8,0,0,0"
                         Text="{Binding NewCommonNodeDisplayName, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="2" Content="确定" Margin="8,0,0,0"
                        Command="{Binding ConfirmAddCommonNodeCommand}"
                        Style="{StaticResource MaterialButton}" />
                <Button Grid.Column="3" Content="取消" Margin="4,0,0,0"
                        Command="{Binding CancelAddCommonNodeCommand}"
                        Style="{StaticResource MaterialButton}" />
            </Grid>
            <TextBlock Text="{Binding AddCommonNodeError}"
                       Foreground="OrangeRed" FontSize="11" TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Visibility="{Binding HasAddCommonNodeError,
                                     Converter={StaticResource BoolToVisibility}}" />

            <!-- v1.0.0.x:批量下载进度面板 — 跟 env-list LocalNodeInstallStatus 同模式。
                 v1.0.0.x 用户改"下载完成自动收起":status.Hide() 设 IsVisible=false →
                 Border Visibility → Collapsed。下载过程中 IsVisible=true 走显示。
                 v1.0.0.x #590:日志区换成 Controls/ConsolePanel — terminal 深灰底浅字风格,
                 ✕ 关闭按钮交给 ConsolePanel 内部 ConsoleCloseRequested → CloseCommand。
                 (当前主路径里 ✕ 已不再触发,因为面板自动收起;CloseCommonNodeDownloadStatusCommand
                  仍保留供 ConsolePanel 内部 ✕ handler 调用 — 调用是 no-op 因为 IsVisible
                  已为 false,但保留以防用户在其他路径下手动触发。) -->
            <Border Margin="0,8,0,0" Padding="8" CornerRadius="4"
                    Background="{DynamicResource Brush.Surface.Variant}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="1"
                    Visibility="{Binding CommonNodeDownloadStatus.IsVisible,
                                 Converter={StaticResource BoolToVisibility},
                                 FallbackValue=Collapsed}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="下载进度:" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CommonNodeDownloadStatus.StatusText}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Text="{Binding CommonNodeDownloadStatus.Error}"
                               Foreground="OrangeRed" FontSize="11" TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               Visibility="{Binding CommonNodeDownloadStatus.HasError,
                                         Converter={StaticResource BoolToVisibility}}" />
                    <controls:ConsolePanel Title="下载日志"
                                           Lines="{Binding CommonNodeDownloadStatus.LogLines}"
                                           ConsoleCloseRequested="OnCommonNodeDownloadConsoleCloseClicked"
                                           Margin="0,8,0,0" />
                </StackPanel>
            </Border>

