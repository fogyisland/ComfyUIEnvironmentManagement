                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="测试连接" Click="TestModelScopeConnection"
                            Style="{StaticResource MaterialButton}" Margin="4,0,0,0" Padding="8,4" />
                    <controls:BindablePasswordBox x:Name="ModelScopeTokenBox"
                                                   Password="{Binding ModelSourceModelScopeApiToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <TextBlock Margin="0,4,0,0">
                    <Hyperlink NavigateUri="https://www.modelscope.cn/my/myaccesstoken" RequestNavigate="OpenHyperlink">
                        在 https://www.modelscope.cn/my/myaccesstoken 获取 token
                    </Hyperlink>
                </TextBlock>

                <!-- ModelScope mirror toggle + URL + reset -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <CheckBox Content="使用国内镜像 (默认 https://www.modelscope.cn)"
                              IsChecked="{Binding ModelSourceModelScopeUseMirror, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              VerticalAlignment="Center" />
                    <TextBlock Text="⚠" FontSize="11" Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource WarningBrush}"
                               ToolTip="尚未保存"
                               Visibility="{Binding Dirty[ModelSourceModelScopeUseMirror], Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
                <DockPanel Margin="0,4,0,0"
                           Visibility="{Binding ModelSourceModelScopeUseMirror, Converter={StaticResource BoolToVisibility}}">
                    <Button DockPanel.Dock="Right" Content="重置" Click="ResetModelScopeMirrorUrl"
                            Style="{StaticResource MaterialButton}" Margin="4,0,0,0" Padding="8,4" />
                    <TextBox Text="{Binding ModelSourceModelScopeMirrorUrl, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialTextBox}" />
                    <TextBlock Text="⚠" FontSize="11" Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource WarningBrush}"
                               ToolTip="尚未保存"
                               Visibility="{Binding Dirty[ModelSourceModelScopeMirrorUrl], Converter={StaticResource BoolToVisibility}}"/>
                </DockPanel>
                <TextBlock Text="⚠ http 镜像将不会发送 token(安全) — 仅 HTTPS 镜像支持鉴权模型"
                           Foreground="{DynamicResource WarningBrush}" FontSize="11" Margin="0,4,0,0"
                           Visibility="{Binding IsModelScopeMirrorInsecure, Converter={StaticResource BoolToVisibility}}" />

                <!-- v0.6.22.x:ModelScope 代理三态 — 关闭 / 跟随全局 / 总是启用。重启生效 -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="代理" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <RadioButton Content="关闭" GroupName="ModelScopeProxyMode"
                                 IsChecked="{Binding ModelSourceModelScopeProxyMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Off, Mode=TwoWay}"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                    <RadioButton Content="跟随全局" GroupName="ModelScopeProxyMode"
                                 IsChecked="{Binding ModelSourceModelScopeProxyMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=InheritGlobal, Mode=TwoWay}"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                    <RadioButton Content="总是启用" GroupName="ModelScopeProxyMode"
                                 IsChecked="{Binding ModelSourceModelScopeProxyMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=AlwaysOn, Mode=TwoWay}"
                                 VerticalAlignment="Center" />
                    <TextBlock Text="⚠" FontSize="11" Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource WarningBrush}"
                               ToolTip="尚未保存"
                               Visibility="{Binding Dirty[ModelSourceModelScopeProxyMode], Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </StackPanel>

            <!-- Helper text + refresh button -->
            <TextBlock Text="勾选镜像后访问国内镜像地址,速度更快不需代理。CivitAI 无流行国内镜像,留空即可。"
                       Foreground="Gray" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" MaxWidth="500"
                       HorizontalAlignment="Left" />
            <Button Content="立即刷新模型市场" Click="RefreshModelMarketplace" Margin="0,8,0,0"
                    HorizontalAlignment="Left" Style="{StaticResource MaterialButton}" />

            <!-- ============ Python 解释器(v0.6.5.6) ============ -->
            <TextBlock x:Name="SectionPythonInterpreters" Text="Python 解释器" FontSize="16" FontWeight="Bold" Margin="0,24,0,8" />
            <TextBlock Text="可定义多个,选一个作为新建环境 auto-fill 的默认解释器"
                       Foreground="Gray" FontSize="11" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="当前使用" VerticalAlignment="Center"/>
                <TextBlock Text="⚠" FontSize="11" Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}"
                           ToolTip="尚未保存"
                           Visibility="{Binding Dirty[ActivePythonInterpreterName], Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <ComboBox ItemsSource="{Binding PythonInterpreters}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Name"
                      SelectedValue="{Binding ActivePythonInterpreterName, Mode=TwoWay}"
                      Width="320" HorizontalAlignment="Left" />
            <ItemsControl ItemsSource="{Binding PythonInterpreters}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <Button Grid.Column="2" Content="删除" Margin="8,0,0,0"
                                    Command="{Binding DataContext.RemovePythonInterpreterCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource MaterialButton}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="+ 添加解释器" Margin="0,8,0,0" HorizontalAlignment="Left"
                    Command="{Binding AddPythonInterpreterCommand}"
                    Style="{StaticResource MaterialButton}" />
            <Grid Margin="0,8,0,0"
                  Visibility="{Binding IsAddPythonInterpreterOpen,
                                Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Style="{StaticResource MaterialTextBox}"
                         Text="{Binding NewPythonInterpreterName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Column="1" Style="{StaticResource MaterialTextBox}" Margin="8,0,0,0"
                         Text="{Binding NewPythonInterpreterPath, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="2" Content="浏览..." Margin="4,0,0,0"
                        Click="BrowsePythonInterpreter"
                        Style="{StaticResource MaterialButton}" />
                <Button Grid.Column="3" Content="确定" Margin="8,0,0,0"
                        Command="{Binding ConfirmAddPythonInterpreterCommand}"
                        Style="{StaticResource MaterialButton}" />
                <Button Grid.Column="4" Content="取消" Margin="4,0,0,0"
                        Command="{Binding CancelAddPythonInterpreterCommand}"
                        Style="{StaticResource MaterialButton}" />
            </Grid>
            <TextBlock Text="{Binding AddPythonInterpreterError}"
                       Foreground="OrangeRed" FontSize="11" TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Visibility="{Binding HasAddPythonInterpreterError,
                                     Converter={StaticResource BoolToVisibility}}" />

            <!-- ============ 环境 / 工具 ============ -->
            <TextBlock x:Name="SectionEnvTools" Text="环境 / 工具" FontSize="16" FontWeight="Bold" Margin="0,24,0,8" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                <TextBlock Text="venv baseline Python(virtualenv 创建时使用)" VerticalAlignment="Center"/>
                <TextBlock Text="⚠" FontSize="11" Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}"
                           ToolTip="尚未保存"
                           Visibility="{Binding Dirty[PythonVenvBaseline], Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <DockPanel Margin="0,2,0,0">
                <Button DockPanel.Dock="Right" Content="浏览..."
                        Click="BrowsePythonVenvBaseline"
                        Style="{StaticResource MaterialButton}" Margin="4,0,0,0" />
                <TextBox Text="{Binding PythonVenvBaseline, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialTextBox}" />
            </DockPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                <TextBlock Text="git.exe 路径" VerticalAlignment="Center"/>
                <TextBlock Text="(默认 seed shipped portable 绝对路径,留空自动探测)" Margin="6,0,0,0"
                           VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedText}"/>
                <TextBlock Text="⚠" FontSize="11" Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}"
                           ToolTip="尚未保存"
                           Visibility="{Binding Dirty[GitExe], Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <DockPanel Margin="0,2,0,0">
                <Button DockPanel.Dock="Right" Content="浏览..."
                        Click="BrowseGitExe"
                        Style="{StaticResource MaterialButton}" Margin="4,0,0,0" />
                <TextBox Text="{Binding GitExe, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialTextBox}" />
            </DockPanel>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,4">
                <TextBlock Text="访问代理" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="驱动 Git 拉取 + HTTP catalog 拉取。重启后生效(handler 在 OnStartup 一次性构造)。" Margin="8,0,0,0"
                           VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedText}"/>
            </StackPanel>
            <!-- v1.0.0.x:代理简化为 2 选 — 继承系统 / 自定义(URL/Port)。
                 Off 已移除:用户希望默认走代理(系统或自定)。HttpProxyMode.Off 枚举保留
                 用于读取老 settings.json(向后兼容),但不再暴露 UI。 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <RadioButton Content="继承系统" GroupName="HttpProxyMode"
                             IsChecked="{Binding HttpProxyMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=InheritSystem, Mode=TwoWay}"
                             VerticalAlignment="Center" Margin="0,0,16,0"
                             ToolTip="走 OS-level 代理(IE settings / WPAD / PAC 自动检测)。URL/Port 字段被忽略。" />
                <RadioButton Content="自定义" GroupName="HttpProxyMode"
                             IsChecked="{Binding HttpProxyMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Custom, Mode=TwoWay}"
                             VerticalAlignment="Center"
                             ToolTip="使用下方 URL/Port 自定义代理。" />
                <TextBlock Text="⚠" FontSize="11" Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}"
                           ToolTip="尚未保存"
                           Visibility="{Binding Dirty[HttpProxyMode], Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <!-- URL + Port 字段 — 仅在 HttpProxyMode=Custom 时启用 -->
            <Grid Margin="0,2,0,0">
                <Grid.IsEnabled>
                    <Binding Path="HttpProxyMode" Converter="{StaticResource EnumEqualsConverter}" ConverterParameter="Custom" />
                </Grid.IsEnabled>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBox Text="{Binding HttpProxyUrl, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialTextBox}" />
                    <TextBlock Text="⚠" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                               Foreground="{DynamicResource WarningBrush}"
                               ToolTip="尚未保存"
                               Visibility="{Binding Dirty[HttpProxyUrl], Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
                <Grid Grid.Column="2">
                    <TextBox Text="{Binding HttpProxyPort, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialTextBox}" />
                    <TextBlock Text="⚠" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                               Foreground="{DynamicResource WarningBrush}"
                               ToolTip="尚未保存"
                               Visibility="{Binding Dirty[HttpProxyPort], Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Grid>

            <!-- v0.6.22.1+:继承系统代理 + URL/Port 都填时告警 — 防止用户以为配置生效但实际 URL/Port 被忽略 -->
            <Border Margin="0,6,0,0" Padding="10,6"
                    Background="{DynamicResource WarningContainerBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding ShowsIgnoredProxyUrlWarning, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" FontSize="13" Foreground="{DynamicResource WarningBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Margin="6,0,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource OnWarningBrush}"
                               VerticalAlignment="Center"
                               Text="继承系统代理模式下，URL/Port 字段被忽略(handler 走 OS 自动检测)。如需使用自定义代理，请切换到「自定义」。"/>
                </StackPanel>
            </Border>

            <!-- ============ 高级:额外 paths 表格 ============ -->
            <TextBlock x:Name="SectionExtraPaths" Text="高级 — 额外路径" FontSize="16" FontWeight="Bold" Margin="0,24,0,8" />
            <ItemsControl ItemsSource="{Binding ExtraPaths}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialTextBox}" Margin="0,0,4,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialTextBox}" />
                            <Button Grid.Column="2" Content="浏览..." Margin="4,0,0,0"
                                    Click="BrowseExtraPath"
                                    DataContext="{Binding}"
                                    Tag="{Binding}"
                                    Style="{StaticResource MaterialButton}" />
                            <Button Grid.Column="3" Content="删除" Margin="4,0,0,0"
                                    Command="{Binding DataContext.RemoveExtraPathCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource MaterialButton}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="+ 添加路径" Margin="0,8,0,0"
                    Command="{Binding AddExtraPathCommand}"
                    Style="{StaticResource MaterialButton}"
                    HorizontalAlignment="Left" />

            <!-- ============ 底部 ============ -->
            <!-- v0.6.9 T9:Check Update 按钮 pulse — IsChecking=true 时 DataTrigger
                 EnterActions 启动 RepeatBehavior=Forever 循环,ExitActions 自动 Stop。
                 ScaleTransform 而非 Height/Width 避免 layout invalidate,Opacity 走 GPU 合成。
                 当前 CheckUpdateCommand 同步完成所以 pulse 几乎看不到,IsChecking 留给
                 future async 检查接线(spec §4.4)。 -->
            <Button Content="检查更新" Margin="0,32,0,16"
                    Command="{Binding CheckUpdateCommand}"
                    HorizontalAlignment="Left">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource MaterialButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecking}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="PulseBegin">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1.0" To="0.6" Duration="0:0:0.5"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             From="1.0" To="1.05" Duration="0:0:0.5"
                                                             AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             From="1.0" To="1.05" Duration="0:0:0.5"
                                                             AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="PulseBegin" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>
