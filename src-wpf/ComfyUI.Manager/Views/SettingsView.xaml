                <TextBlock Text="⚠" FontSize="11" Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}"
                           ToolTip="尚未保存"
                           Visibility="{Binding Dirty[WorkflowsDirectory], Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <TextBlock Text="工作流市场页面使用的共享 workflows 目录;留空 = 默认 workflows/。"
                       Foreground="Gray" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="480"
                       HorizontalAlignment="Left" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox Content="启用 ComfyUI-Manager community json 来源"
                          IsChecked="{Binding WorkflowSourceCommunityJsonEnabled}"
                          VerticalAlignment="Center"/>
                <TextBlock Text="⚠" FontSize="11" Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}"
                           ToolTip="尚未保存"
                           Visibility="{Binding Dirty[WorkflowSourceCommunityJsonEnabled], Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <CheckBox Content="启用 CivitAI 来源"
                          IsChecked="{Binding WorkflowSourceCivitAiEnabled}"
                          VerticalAlignment="Center"/>
                <TextBlock Text="⚠" FontSize="11" Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}"
                           ToolTip="尚未保存"
                           Visibility="{Binding Dirty[WorkflowSourceCivitAiEnabled], Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <CheckBox Content="启用 OpenArt 来源"
