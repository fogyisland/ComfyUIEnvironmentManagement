<UserControl x:Class="ComfyUI.Manager.Views.BulkUpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ComfyUI.Manager.ViewModels"
             xmlns:model="clr-namespace:ComfyUI.Manager.Models">
    <!--
    v0.6.18.1 inline 批量更新 — env + node 双层。
    镜像 EnvironmentListView 的三层 DockPanel 布局(Top 工具栏 + Bottom 状态面板 +
    Middle 主区),Middle 现在是 3 列(env / node / TabControl),不再是 2 列。

    DataContext 由 MainViewModel.OpenBulkUpdate 在 SetView 时绑成 BulkUpdateViewModel。
    -->
    <UserControl.Resources>
        <Style x:Key="CardListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="CardListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="EnvCardTemplate" DataType="{x:Type vm:EnvRow}">
            <Border Padding="8,6"
                    Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="4">
                <CheckBox Content="{Binding DisplayName}"
                          IsChecked="{Binding Selected}"
                          VerticalAlignment="Center" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="NodeCardTemplate" DataType="{x:Type vm:NodeRow}">
            <Border Padding="8,6"
                    Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="4">
                <CheckBox IsChecked="{Binding Selected}"
                          VerticalAlignment="Center">
                    <TextBlock>
                        <Run Text="{Binding DisplayName, Mode=OneWay}" />
                        <Run Text=" (" />
                        <Run Text="{Binding InstalledEnvId, Mode=OneWay}" />
                        <Run Text=")" />
                    </TextBlock>
                </CheckBox>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- 顶部:section 标题 + count + 全选/开始/取消 -->
        <Grid DockPanel.Dock="Top" Margin="12,12,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="批量更新"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource OnSurfaceBrush}" />
                <TextBlock FontSize="11" Foreground="{DynamicResource OutlineBrush}"
                           Margin="0,2,0,0">
                    <Run Text="环境:" />
                    <Run Text="{Binding EnvRows.Count, Mode=OneWay}" />
                    <Run Text=" · 节点:" />
                    <Run Text="{Binding AvailableNodes.Count, Mode=OneWay}" />
                    <Run Text=" · env-level 全跑,node-level 按勾选" />
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="全选/反选 节点" Command="{Binding ToggleSelectAllNodesCommand}"
                        Style="{StaticResource MaterialButton}" Margin="0,0,6,0" />
                <Button Content="全选/反选 环境" Command="{Binding ToggleSelectAllEnvCommand}"
                        Style="{StaticResource MaterialButton}" Margin="0,0,6,0" />
                <Button Content="开始" Command="{Binding StartCommand}" MinWidth="80"
                        Style="{StaticResource MaterialButton}" Margin="0,0,6,0" />
                <Button Content="取消" Command="{Binding CancelCommand}" MinWidth="80"
                        Style="{StaticResource MaterialButton}" />
            </StackPanel>
        </Grid>

        <!-- 底部:summary inline 面板 + ErrorMessage -->
        <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,12">
            <Border Padding="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding Summary, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}">
                <StackPanel>
                    <TextBlock FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource OnSurfaceBrush}">
                        <Run Text="完成:" />
                        <Run Text="{Binding Summary.Total, Mode=OneWay}" />
                        <Run Text="  成功:" />
                        <Run Text="{Binding Summary.Succeeded, Mode=OneWay}" />
                        <Run Text="  跳过:" />
                        <Run Text="{Binding Summary.Skipped, Mode=OneWay}" />
                        <Run Text="  失败:" />
                        <Run Text="{Binding Summary.Failed, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}"
                       Margin="0,4,0,0" FontWeight="Bold"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}" />
        </StackPanel>

        <!-- 中间:3 列(env / node / TabControl 状态) -->
        <Grid Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左:env checkbox 列表 -->
            <Border Grid.Column="0" Margin="0,0,8,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Border Visibility="{Binding EnvRows.Count, Converter={StaticResource ZeroCountToVisibility}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="还没有任何环境" FontSize="13"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource OnSurfaceBrush}" />
                            <TextBlock Text="先去「环境」页新建一个"
                                       FontSize="11" Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource OutlineBrush}" />
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="EnvListBox" ItemsSource="{Binding EnvRows}"
                             ItemTemplate="{StaticResource EnvCardTemplate}"
                             ItemContainerStyle="{StaticResource CardListBoxItemStyle}"
                             Style="{StaticResource CardListBoxStyle}"
                             Visibility="{Binding EnvRows.Count, Converter={StaticResource InverseZeroCountToVisibility}}" />
                </Grid>
            </Border>

            <!-- 中:节点 checkbox 列表(选中 envs 合并) -->
            <Border Grid.Column="1" Margin="0,0,8,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Border Visibility="{Binding AvailableNodes.Count, Converter={StaticResource ZeroCountToVisibility}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="选中环境后才有节点" FontSize="13"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource OnSurfaceBrush}" />
                            <TextBlock Text="勾选左侧环境,这里自动列出"
                                       FontSize="11" Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource OutlineBrush}" />
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="NodeListBox" ItemsSource="{Binding AvailableNodes}"
                             ItemTemplate="{StaticResource NodeCardTemplate}"
                             ItemContainerStyle="{StaticResource CardListBoxItemStyle}"
                             Style="{StaticResource CardListBoxStyle}"
                             Visibility="{Binding AvailableNodes.Count, Converter={StaticResource InverseZeroCountToVisibility}}" />
                </Grid>
            </Border>

            <!-- 右:TabControl 状态(基础环境 / ComfyUI / 自定义节点) -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="6">
                <TabControl Background="Transparent" BorderThickness="0">
                    <!-- 基础环境 -->
                    <TabItem Header="基础环境">
                        <Grid>
                            <Border Visibility="{Binding Rows.Count, Converter={StaticResource ZeroCountToVisibility}}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16">
                                <TextBlock Text="勾选左侧环境 → 点「开始」"
                                           FontSize="13"
                                           Foreground="{DynamicResource OnSurfaceBrush}" />
                            </Border>
                            <DataGrid ItemsSource="{Binding BaseEnvRowsView}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      EnableRowVirtualization="True"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Visibility="{Binding Rows.Count, Converter={StaticResource InverseZeroCountToVisibility}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Env" Binding="{Binding EnvId}" Width="*" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                                    <DataGridTextColumn Header="Progress"
                                                        Binding="{Binding Percent, StringFormat={}{0}%}"
                                                        Width="80" />
                                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
                                    <DataGridTextColumn Header="ms" Binding="{Binding LatencyMs}" Width="60" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- ComfyUI(ComfyUI-Manager) -->
                    <TabItem Header="ComfyUI">
                        <Grid>
                            <Border Visibility="{Binding Rows.Count, Converter={StaticResource ZeroCountToVisibility}}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16">
                                <TextBlock Text="勾选左侧环境 → 点「开始」"
                                           FontSize="13"
                                           Foreground="{DynamicResource OnSurfaceBrush}" />
                            </Border>
                            <DataGrid ItemsSource="{Binding ComfyUiManagerRowsView}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      EnableRowVirtualization="True"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Visibility="{Binding Rows.Count, Converter={StaticResource InverseZeroCountToVisibility}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Env" Binding="{Binding EnvId}" Width="*" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                                    <DataGridTextColumn Header="Progress"
                                                        Binding="{Binding Percent, StringFormat={}{0}%}"
                                                        Width="80" />
                                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
                                    <DataGridTextColumn Header="ms" Binding="{Binding LatencyMs}" Width="60" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- 自定义节点 -->
                    <TabItem Header="自定义节点">
                        <Grid>
                            <Border Visibility="{Binding NodeRowsView, Converter={StaticResource ZeroCountToVisibility}}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16">
                                <TextBlock Text="勾选中列节点 + 点「开始」"
                                           FontSize="13"
                                           Foreground="{DynamicResource OnSurfaceBrush}" />
                            </Border>
                            <DataGrid ItemsSource="{Binding NodeRowsView}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      EnableRowVirtualization="True"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Visibility="{Binding NodeRowsView, Converter={StaticResource InverseZeroCountToVisibility}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Node" Binding="{Binding NodeId}" Width="*" />
                                    <DataGridTextColumn Header="Env" Binding="{Binding EnvId}" Width="*" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                                    <DataGridTextColumn Header="Progress"
                                                        Binding="{Binding Percent, StringFormat={}{0}%}"
                                                        Width="80" />
                                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
                                    <DataGridTextColumn Header="ms" Binding="{Binding LatencyMs}" Width="60" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>