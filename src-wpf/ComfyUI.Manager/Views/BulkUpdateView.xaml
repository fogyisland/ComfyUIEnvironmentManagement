<UserControl x:Class="ComfyUI.Manager.Views.BulkUpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ComfyUI.Manager.ViewModels">
    <!--
    v0.6.18 inline 批量更新。镜像 EnvironmentListView 的三层 DockPanel 布局
    (Top 工具栏 + Bottom 状态面板 + Middle 主区),不再是弹窗。复用既有
    MaterialButton / DangerButton / BoolToVisibility / NullToVisibility /
    InverseZeroCountToVisibility converter — 不引入新 theme 资源。

    DataContext 由 MainViewModel.OpenBulkUpdate 在 SetView 时绑成 BulkUpdateViewModel。
    -->
    <DockPanel>
        <!-- 顶部:section 标题 + target checkboxes + 全选/开始/取消 (Grid 3 列:标题 | spacer | 操作) -->
        <Grid DockPanel.Dock="Top" Margin="12,12,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="批量更新"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource OnSurfaceBrush}" />
                <TextBlock FontSize="11" Foreground="{DynamicResource OutlineBrush}"
                           Margin="0,2,0,0">
                    <Run Text="共 " />
                    <Run Text="{Binding EnvRows.Count, Mode=OneWay}" />
                    <Run Text=" 个环境 · 只更新环境(不更新节点)" />
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- v0.6.11 T8:两个 target checkbox 取代旧版 per-env × per-node 网格 -->
                <CheckBox Content="{DynamicResource BulkUpdate_TargetComfyUi}"
                          IsChecked="{Binding UpdateComfyUi}"
                          VerticalAlignment="Center" Margin="0,0,12,0" />
                <CheckBox Content="{DynamicResource BulkUpdate_TargetComfyUiManager}"
                          IsChecked="{Binding UpdateComfyUiManager}"
                          VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="全选/反选" Command="{Binding ToggleSelectAllCommand}"
                        Style="{StaticResource MaterialButton}" Margin="0,0,6,0" />
                <Button Content="开始" Command="{Binding StartCommand}" MinWidth="80"
                        Style="{StaticResource MaterialButton}" Margin="0,0,6,0" />
                <Button Content="取消" Command="{Binding CancelCommand}" MinWidth="80"
                        Style="{StaticResource MaterialButton}" />
            </StackPanel>
        </Grid>

        <!-- 底部:summary inline 面板(同 EnvironmentListView 的 SurfaceBrush/OutlineBrush/CornerRadius pattern)。
             v0.6.18:无 dialog Mode 切换,summary 实时跟随 orchestrator.Completed。
             IsVisible 用 Summary != null 控制(NullToVisibility);ErrorMessage 走同款红色 TextBlock。 -->
        <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,12">
            <Border Padding="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding Summary, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}">
                <StackPanel>
                    <TextBlock FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource OnSurfaceBrush}">
                        <Run Text="完成:" />
                        <Run Text="{Binding Summary.Total, Mode=OneWay}" />
                        <Run Text="  成功:" />
                        <Run Text="{Binding Summary.Succeeded, Mode=OneWay}" />
                        <Run Text="  跳过:" />
                        <Run Text="{Binding Summary.Skipped, Mode=OneWay}" />
                        <Run Text="  失败:" />
                        <Run Text="{Binding Summary.Failed, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}"
                       Margin="0,4,0,0" FontWeight="Bold"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}" />
        </StackPanel>

        <!-- 中间:左侧 env 选择列表 + 右侧进度表 -->
        <Grid Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左:env checkbox 列表 -->
            <Border Grid.Column="0" Margin="0,0,8,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <!-- 空状态 -->
                    <Border Visibility="{Binding EnvRows.Count, Converter={StaticResource ZeroCountToVisibility}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="还没有任何环境" FontSize="13"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource OnSurfaceBrush}" />
                            <TextBlock Text="先去「环境」页新建一个"
                                       FontSize="11" Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource OutlineBrush}" />
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="EnvListBox" ItemsSource="{Binding EnvRows}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch"
                             Visibility="{Binding EnvRows.Count, Converter={StaticResource InverseZeroCountToVisibility}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:EnvRow}">
                                <Border Padding="8,6"
                                        Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                                        CornerRadius="4">
                                    <CheckBox Content="{Binding DisplayName}"
                                              IsChecked="{Binding Selected}"
                                              VerticalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 右:进度表(逐 (env, target) 行) -->
            <Border Grid.Column="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <!-- 空状态:run 没启动时显示引导 -->
                    <Border Visibility="{Binding Rows.Count, Converter={StaticResource ZeroCountToVisibility}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="勾选左侧环境 + 选目标 → 点「开始」"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource OnSurfaceBrush}" />
                            <TextBlock Text="批量跑 git pull --ff-only,逐 (env, target) 显示进度"
                                       FontSize="11" Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource OutlineBrush}" />
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="RowsGrid"
                              ItemsSource="{Binding Rows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              EnableRowVirtualization="True"
                              Background="Transparent"
                              BorderThickness="0"
                              Visibility="{Binding Rows.Count, Converter={StaticResource InverseZeroCountToVisibility}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Env" Binding="{Binding EnvId}" Width="120" />
                            <DataGridTextColumn Header="Target" Binding="{Binding TargetKind}" Width="160" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                            <DataGridTextColumn Header="Progress"
                                                Binding="{Binding Percent, StringFormat={}{0}%}"
                                                Width="80" />
                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
                            <DataGridTextColumn Header="ms" Binding="{Binding LatencyMs}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
