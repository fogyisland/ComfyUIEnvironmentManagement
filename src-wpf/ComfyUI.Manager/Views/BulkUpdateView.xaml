<UserControl x:Class="ComfyUI.Manager.Views.BulkUpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ComfyUI.Manager.ViewModels"
             xmlns:model="clr-namespace:ComfyUI.Manager.Models"
             xmlns:controls="clr-namespace:ComfyUI.Manager.Controls">
    <!--
    v0.6.18.2 inline 批量更新 — 扁平 checklist。
    镜像 EnvironmentListView 的三层 DockPanel 布局(Top 工具栏 + Bottom 状态面板 +
    Middle 主区),Middle 现在是 3 列(env / items / progress),不再是 2 列 +
    TabControl。

    v0.6.18.2 G11+:左列 env 卡片镜像 EnvironmentListView 的 env 卡(状态点 + Name +
    checkbox),用 Environment.Status 渲染填充色;顶部加"先关闭环境再更新"警告
    banner(任何选中 env 处于 running 时显示),跑 git 写入工作树时 live env
    会留脏状态或失败。

    DataContext 由 MainViewModel.OpenBulkUpdate 在 SetView 时绑成 BulkUpdateViewModel。
    -->
    <UserControl.Resources>
        <Style x:Key="CardListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="CardListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- v0.6.18.2 G11+:左列 env 卡片,镜像 EnvironmentListView 的 env 卡设计 —
             状态点(running=SuccessBrush / stopped=OutlineBrush / failed=ErrorBrush)
             + Name + checkbox。用户选中切换驱动 RebuildUpdateItems + HasRunningSelectedEnv 重算。 -->
        <DataTemplate x:Key="EnvCardTemplate" DataType="{x:Type vm:EnvRow}">
            <Border Padding="10,8"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- 状态点:running=Success / stopped=Outline / failed=Error,镜像 EnvironmentListView Ellipse pattern -->
                    <Ellipse Grid.Column="0" Width="10" Height="10"
                             VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource OutlineBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="running">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="failed">
                                        <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource OnSurfaceBrush}" />
                    <CheckBox Grid.Column="2" IsChecked="{Binding Selected}"
                              VerticalAlignment="Center"
                              ToolTip="取消勾选 = 跳过该 env 的所有 update items" />
                </Grid>
            </Border>
        </DataTemplate>
        <!-- v0.6.18.2 G11+:中列 update item 卡片,镜像 LocalNodeListView 的卡片风格 —
             checkbox + DisplayName + InstalledEnvId 灰色小字,标识 item 装在哪个 env
             (跨 env 合并去重时 <see cref="UpdateItem.DisplayName"/> 已经带 "…")。 -->
        <DataTemplate x:Key="UpdateItemCardTemplate" DataType="{x:Type vm:UpdateItem}">
            <Border Padding="10,8"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="6">
                <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="{Binding DisplayName, Mode=OneWay}" FontSize="13"
                             Foreground="{DynamicResource OnSurfaceBrush}" />
                        <Run Text=" (" FontSize="11" Foreground="{DynamicResource OutlineBrush}" />
                        <Run Text="{Binding InstalledEnvId, Mode=OneWay}" FontSize="11"
                             Foreground="{DynamicResource OutlineBrush}" />
                        <Run Text=")" FontSize="11" Foreground="{DynamicResource OutlineBrush}" />
                    </TextBlock>
                </CheckBox>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- 顶部:section 标题 + count + 全选/开始/取消 -->
        <Grid DockPanel.Dock="Top" Margin="12,12,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="批量更新"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource OnSurfaceBrush}" />
                <TextBlock FontSize="11" Foreground="{DynamicResource OutlineBrush}"
                           Margin="0,2,0,0">
                    <Run Text="环境:" />
                    <Run Text="{Binding EnvRows.Count, Mode=OneWay}" />
                    <Run Text="  ·  更新项:" />
                    <Run Text="{Binding UpdateItems.Count, Mode=OneWay}" />
                    <Run Text="  ·  默认全跑,按勾选" />
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="全选/反选 更新项" Command="{Binding ToggleSelectAllItemsCommand}"
                        Style="{StaticResource MaterialButton}" Margin="0,0,6,0" />
                <Button Content="全选/反选 环境" Command="{Binding ToggleSelectAllEnvCommand}"
                        Style="{StaticResource MaterialButton}" Margin="0,0,6,0" />
                <Button Content="开始" Command="{Binding StartCommand}" MinWidth="80"
                        Style="{StaticResource MaterialButton}" Margin="0,0,6,0" />
                <Button Content="取消" Command="{Binding CancelCommand}" MinWidth="80"
                        Style="{StaticResource MaterialButton}" />
            </StackPanel>
        </Grid>

        <!-- v0.6.18.2 G11+:running env 警告 banner — 任何选中 env 处于 running 时显示,
             提示"更新前请先关闭环境,否则 git 操作可能失败或留下脏状态"。镜像
             EnvironmentListView 底部状态面板的 Border 风格(SurfaceBrush / OutlineBrush
             / CornerRadius 6),用 ErrorBrush 边框强调警告性质。 -->
        <Border DockPanel.Dock="Top" Margin="12,0,12,8" Padding="12"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding HasRunningSelectedEnv, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
            <StackPanel>
                <TextBlock FontWeight="Bold" FontSize="13"
                           Foreground="{DynamicResource ErrorBrush}">
                    <Run Text="⚠ 检测到正在运行的环境,更新前请先关闭" />
                </TextBlock>
                <TextBlock FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource OnSurfaceBrush}">
                    <Run Text="选中环境中包含正在运行的 ComfyUI 实例。git 操作期间 live 进程可能持有文件锁,导致 pull 失败或留下脏状态。" />
                    <Run Text="建议:切到「环境」页点击对应环境的「停止」按钮,确认关闭后再回来运行批量更新。" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- 底部:summary inline 面板 + ErrorMessage + v1.0.0.x #590 Console 面板(抽到 Controls/ConsolePanel.xaml,
             terminal 风格深灰底浅字,✕ raise ConsoleCloseRequested → code-behind 调 VM.ClearConsoleLog)。 -->
        <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,12">
            <Border Padding="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding Summary, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}">
                <StackPanel>
                    <TextBlock FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource OnSurfaceBrush}">
                        <Run Text="完成:" />
                        <Run Text="{Binding Summary.Total, Mode=OneWay}" />
                        <Run Text="  成功:" />
                        <Run Text="{Binding Summary.Succeeded, Mode=OneWay}" />
                        <Run Text="  跳过:" />
                        <Run Text="{Binding Summary.Skipped, Mode=OneWay}" />
                        <Run Text="  失败:" />
                        <Run Text="{Binding Summary.Failed, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}"
                       Margin="0,4,0,0" FontWeight="Bold"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}" />
            <!-- v0.6.18.4:Console 面板 — 显示当前在跑 job 的 git pull stdout/stderr
                 实时输出,镜像 EnvironmentListView StartStatus 面板风格
                 (SurfaceBrush/OutlineBrush/Border/CornerRadius 6 + Consolas monospace)。
                 IsBusy=true 自动可见,run 完保留日志直到用户点 ✕ 关闭。
                 Auto-scroll:新行追加时 ScrollToEnd 让用户总看最新输出。 -->
            <controls:ConsolePanel Margin="0,8,0,0"
                                         Lines="{Binding ConsoleLog}"
                                         Title="Console"
                                         ConsoleCloseRequested="OnConsoleCloseRequested"
                                         Visibility="{Binding IsConsoleVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
        </StackPanel>

        <!-- 中间:3 列(env 卡片 / items / progress),镜像 EnvironmentListView Grid + Border 风格 -->
        <Grid Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左:env 卡片列表(状态点 + Name + check),镜像 EnvironmentListView env 卡 -->
            <Border Grid.Column="0" Margin="0,0,8,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Border Visibility="{Binding EnvRows.Count, Converter={StaticResource ZeroCountToVisibility}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="还没有任何环境" FontSize="13"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource OnSurfaceBrush}" />
                            <TextBlock Text="先去「环境」页新建一个"
                                       FontSize="11" Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource OutlineBrush}" />
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="EnvListBox" ItemsSource="{Binding EnvRows}"
                             ItemTemplate="{StaticResource EnvCardTemplate}"
                             ItemContainerStyle="{StaticResource CardListBoxItemStyle}"
                             Style="{StaticResource CardListBoxStyle}"
                             Visibility="{Binding EnvRows.Count, Converter={StaticResource InverseZeroCountToVisibility}}" />
                </Grid>
            </Border>

            <!-- 中:扁平 UpdateItem checklist(env-level + node-level 混排),镜像 LocalNodeListView 卡片风格 -->
            <Border Grid.Column="1" Margin="0,0,8,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Border Visibility="{Binding UpdateItems.Count, Converter={StaticResource ZeroCountToVisibility}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="选中环境后才有更新项" FontSize="13"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource OnSurfaceBrush}" />
                            <TextBlock Text="勾选左侧环境,这里自动列出"
                                       FontSize="11" Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource OutlineBrush}" />
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="UpdateItemListBox" ItemsSource="{Binding UpdateItems}"
                             ItemTemplate="{StaticResource UpdateItemCardTemplate}"
                             ItemContainerStyle="{StaticResource CardListBoxItemStyle}"
                             Style="{StaticResource CardListBoxStyle}"
                             Visibility="{Binding UpdateItems.Count, Converter={StaticResource InverseZeroCountToVisibility}}" />
                </Grid>
            </Border>

            <!-- 右:全局进度 DataGrid(env-level + node-level 统一显示) -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Border Visibility="{Binding Rows.Count, Converter={StaticResource ZeroCountToVisibility}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16">
                        <TextBlock Text="勾选中列更新项 → 点「开始」"
                                   FontSize="13"
                                   Foreground="{DynamicResource OnSurfaceBrush}" />
                    </Border>
                    <DataGrid x:Name="RowsGrid"
                              ItemsSource="{Binding Rows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              EnableRowVirtualization="True"
                              Background="Transparent"
                              BorderThickness="0"
                              Visibility="{Binding Rows.Count, Converter={StaticResource InverseZeroCountToVisibility}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="240" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                            <DataGridTextColumn Header="Progress"
                                                Binding="{Binding Percent, StringFormat={}{0}%}"
                                                Width="80" />
                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
                            <DataGridTextColumn Header="ms" Binding="{Binding LatencyMs}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
