<UserControl x:Class="ComfyUI.Manager.Views.NodelistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ComfyUI.Manager.ViewModels"
             xmlns:controls="clr-namespace:ComfyUI.Manager.Controls"
             d:DataContext="{d:DesignInstance Type=vm:NodelistViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- v1.0.0.x T43f+user:tag pill(右上 Topics 标签圆角矩形)。背景用 SurfaceVariantBrush,
             文字 OnSurfaceBrush — 跟整体 Surface 调色板统一,Material Design 风格。 -->
        <Style x:Key="TagPillBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: toolbar -->
            <RowDefinition Height="Auto"/>   <!-- 1: 日志 Border(v1.0.0.x 2026-09-16 T43i+user) -->
            <RowDefinition Height="*"/>      <!-- 2: list + detail -->
        </Grid.RowDefinitions>

        <!-- 顶部 toolbar(v1.0.0.x 2026-09-15 T43f+user 改造:
             删 path TextBox + 📁 打开 button — 路径由 Settings 后台配(用户原话
             "我们的路径没有必要,因为本身就是设置在后台的路径")。只保留「⬇ 重新下载」+「⤴ 增量入库」+ StatusText。 -->
        <Border Grid.Row="0" Padding="12,8"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="节点市场"
                           FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="⬇ 重新下载"
                            Command="{Binding DownloadAndIngestCommand}"
                            Margin="0,0,8,0" Padding="10,4"
                            Style="{StaticResource MaterialButton}"
                            ToolTip="重新下载 custom-node-list.json 并入库"/>
                    <Button Content="⤴ 增量入库"
                            Command="{Binding IngestCommand}"
                            Margin="0,0,8,0" Padding="10,4"
                            Style="{StaticResource MaterialButton}"
                            ToolTip="不下载,只对已下载的 json 调 NodeRepoQueryService 拉详情"/>
                    <TextBlock Text="{Binding StatusText}"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}" FontSize="11"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- v1.0.0.x (2026-09-16) T43i+user 「入库过程中加日志记录,我希望看到进度和日志」:
             入库启动时 VM 端 IsLogPanelVisible=true 自动展开,完成时 IsLogPanelVisible=false
             自动折叠(用户原话"完成时折叠")。复用 Controls/ConsolePanel(已在 10 处使用) —
             terminal 深灰底浅字 + 复制/关闭按钮 + auto-scroll,免去新写一个 Expander 模板。 -->
        <Border Grid.Row="1" Margin="8,4,8,0"
                Visibility="{Binding IsLogPanelVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
            <controls:ConsolePanel Title="📋 入库日志"
                                   Lines="{Binding LogLines}"
                                   ConsoleCloseRequested="OnIngestLogCloseClicked"
                                   Margin="0" />
        </Border>

        <!-- 左右结构:左 list(search + 仓库列表)+ 右 detail(版本 cards) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="240"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- 左:列表(search TextBox 在顶 + 仓库 ListBox + 分页栏) -->
            <Border Grid.Column="0" Margin="8"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                <DockPanel>
                    <!-- 顶部:仓库数 summary + search 框 -->
                    <Border DockPanel.Dock="Top" Padding="8,6"
                            Background="{DynamicResource SurfaceVariantBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding EntriesSummaryText}"
                                       FontWeight="Bold" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="🔍"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                        </Grid>
                    </Border>
                    <TextBox DockPanel.Dock="Top"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,4" Margin="8,4,8,4"
                             Background="{DynamicResource SurfaceVariantBrush}"
                             Foreground="{DynamicResource OnSurfaceBrush}"
                             BorderBrush="{DynamicResource OutlineBrush}"
                             ToolTip="搜索:匹配 author / repo_name(模糊、大小写不敏感)。清空显示全部。"/>

                    <!-- v1.0.0.x (2026-09-15) T43g+user 「中间实现分页效果」:
                         底部传统分页器(« 首页 / ‹ 上一页 / 页码 / 下一页 › / 末页 »)。
                         50 条/页(DefaultPageSize);首页/上一页/下一页/末页 4 个 button + 页码 TextBlock。
                         CurrentPageItems 已切片,无需虚拟化。 -->
                    <Border DockPanel.Dock="Bottom" Padding="6,4"
                            Background="{DynamicResource SurfaceVariantBrush}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="« 首页" Command="{Binding FirstPageCommand}"
                                    Margin="2,0" Padding="8,2"
                                    Style="{StaticResource MaterialButton}"/>
                            <Button Content="‹ 上一页" Command="{Binding PrevPageCommand}"
                                    Margin="2,0" Padding="8,2"
                                    Style="{StaticResource MaterialButton}"/>
                            <TextBlock Text="{Binding PageInfoText}"
                                       VerticalAlignment="Center" Margin="12,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                            <Button Content="下一页 ›" Command="{Binding NextPageCommand}"
                                    Margin="2,0" Padding="8,2"
                                    Style="{StaticResource MaterialButton}"/>
                            <Button Content="末页 »" Command="{Binding LastPageCommand}"
                                    Margin="2,0" Padding="8,2"
                                    Style="{StaticResource MaterialButton}"/>
                        </StackPanel>
                    </Border>

                    <!-- 仓库 ListBox — 绑 CurrentPageItems(50 条/页切片),移除 VirtualizingStackPanel
                         因为 CurrentPageItems 永远只有 50 条以内,不需要虚拟化 — 用户原话
                         "不然耗费大量内存资源" = 改用分页,内存峰值从 5175 条降到 50 条。 -->
                    <ListBox ItemsSource="{Binding CurrentPageItems}"
                             SelectedItem="{Binding SelectedEntry}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <!-- author/repo — 主行 -->
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="{Binding Author}" FontSize="11"
                                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                                        <TextBlock Text="/" FontSize="11" Margin="2,0"
                                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                                        <TextBlock Text="{Binding RepoName}" FontWeight="SemiBold"
                                                   FontSize="13"/>
                                    </DockPanel>
                                    <!-- 副信息:最近入库时间 + source -->
                                    <TextBlock FontSize="10" Margin="0,2,0,0"
                                               Foreground="{DynamicResource OnSurfaceVariantBrush}">
                                        <Run Text="最近入库:"/>
                                        <Run Text="{Binding LastIngestedAt, Mode=OneWay}"/>
                                        <Run Text="  来源:"/>
                                        <Run Text="{Binding Source, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource OutlineBrush}"/>

            <!-- 右:详情(顶部 header + meta + ActionBar + TabControl,默认折叠未选状态)
                 v1.0.0.x (2026-09-15) T43g+user 「右边详情空旷」:从单一版本 cards 列表
                 改成 4 行结构(顶部 header / meta / ActionBar / TabControl),
                 TabControl 含「版本管理」「插件说明」2 个 tab(T43i.5 删「依赖配置」placeholder:
                 依赖安装走 Action Bar「📥 一键安装」按钮,不在 TabControl 里占位)。 -->
            <Border Grid.Column="2" Margin="8"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                <DockPanel>
                    <!-- 头部:owner / repo -->
                    <Border DockPanel.Dock="Top" Padding="12,8"
                            Background="{DynamicResource SurfaceVariantBrush}"
                            BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedEntryHeader}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectedEntryMeta}" FontSize="11" Margin="0,4,0,0"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- v1.0.0.x T43g+user:Action Bar ——
                         4 个 button:📥 一键安装 / 🌐 浏览器打开 / 📋 复制链接 / 💾 下载到本地。
                         无选中项时全部 disabled(由 command CanExecute 控制)。
                         一键安装弹 EnvPickerDialog,环境 picker 完成后调 NodeOperations.InstallAsync。
                         下载到本地调 NodeOperations.DownloadAsync,git clone 到 Settings.LocalNodeDirectory/<repoName>。 -->
                    <Border DockPanel.Dock="Top" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="📥 一键安装" Command="{Binding InstallCommand}"
                                    Margin="0,0,8,0" Padding="10,4"
                                    Style="{StaticResource MaterialButton}"
                                    ToolTip="选中项 git clone 到 ComfyUI env 的 custom_nodes/"/>
                            <Button Content="🌐 浏览器打开" Command="{Binding OpenInBrowserCommand}"
                                    Margin="0,0,8,0" Padding="10,4"
                                    Style="{StaticResource MaterialButton}"
                                    ToolTip="Chrome → Edge → 默认浏览器 fallback"/>
                            <Button Content="📋 复制链接" Command="{Binding CopyUrlCommand}"
                                    Margin="0,0,8,0" Padding="10,4"
                                    Style="{StaticResource MaterialButton}"
                                    ToolTip="复制 html_url 到剪贴板"/>
                            <!-- v1.0.0.x (2026-09-16) T43i.5+user「下载到本地是下载到本地的节点
                                 LocalNodes 下面」:把选中 entry git clone 到 Settings.LocalNodeDirectory
                                 下的 LocalNodes 目录(跟 env 的 custom_nodes/ 解耦),完成后 NodeOperations
                                 内部 upsert scanned_nodes(Source="download", EnvId="") 让 LocalNodes 面板可见。 -->
                            <Button Content="💾 下载到本地" Command="{Binding DownloadToLocalCommand}"
                                    Padding="10,4"
                                    Style="{StaticResource MaterialButton}"
                                    ToolTip="git clone 到 Settings.LocalNodeDirectory 下的 LocalNodes 目录"/>
                        </StackPanel>
                    </Border>

                    <!-- v1.0.0.x T43g+user:TabControl ——
                         「版本管理」(复用 T43f 14 字段版本 cards)/「插件说明」(T43i.4+user 填 description)。
                         T43i.5 删「依赖配置」placeholder —— 依赖安装走 Action Bar「📥 一键安装」按钮更顺手,
                         TabControl 不再为它占位。 -->
                    <TabControl Margin="8,0,8,8">
                        <TabItem Header="版本管理">
                            <DockPanel>
                                <!-- Tab 内顶部版本列表标题 -->
                                <Border DockPanel.Dock="Top" Padding="8,4">
                                    <TextBlock Text="{Binding SelectedDetailsSummaryText}"
                                               FontWeight="Bold" FontSize="12"/>
                                </Border>
                                <!-- v1.0.0.x (2026-09-15) T43h+user:「数据源」debug panel —
                                     折叠避免污染主 UI;展开看到所有 raw JSON 解析字段 + 跳弹窗查看完整 GitHub API JSON。
                                     字段来源:NodelistEntryRow 18 新属性(T43h 全量入库)。
                                     首次默认折叠(IsExpanded=False),点 header 展开。 -->
                                <Expander DockPanel.Dock="Top" Margin="0,4,0,8" IsExpanded="False"
                                          Background="{DynamicResource SurfaceVariantBrush}"
                                          BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                                    <Expander.Header>
                                        <TextBlock FontWeight="SemiBold" FontSize="12"
                                                   Text="🔍 数据源(raw JSON 解析字段 + GitHub API 元信息)"/>
                                    </Expander.Header>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320">
                                        <StackPanel Margin="8">
                                            <!-- 标量字段 -->
                                            <TextBlock FontSize="11" Margin="0,2">
                                                <Run Text="ID:" FontWeight="SemiBold"/>
                                                <Run Text="{Binding SelectedEntry.Id, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Margin="0,2">
                                                <Run Text="Install Type:" FontWeight="SemiBold"/>
                                                <Run Text="{Binding SelectedEntry.InstallType, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Margin="0,2" TextWrapping="Wrap">
                                                <Run Text="Reference:" FontWeight="SemiBold"/>
                                                <Run Text="{Binding SelectedEntry.Reference, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Margin="0,2" TextWrapping="Wrap">
                                                <Run Text="Reference2:" FontWeight="SemiBold"/>
                                                <Run Text="{Binding SelectedEntry.Reference2, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Margin="0,2">
                                                <Run Text="Category:" FontWeight="SemiBold"/>
                                                <Run Text="{Binding SelectedEntry.Category, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Margin="0,2">
                                                <Run Text="JS Path:" FontWeight="SemiBold"/>
                                                <Run Text="{Binding SelectedEntry.JsPath, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Margin="0,2">
                                                <Run Text="Nodename Pattern:" FontWeight="SemiBold"/>
                                                <Run Text="{Binding SelectedEntry.NodenamePattern, Mode=OneWay}"/>
                                            </TextBlock>

                                            <!-- 数组字段 — tag pills -->
                                            <TextBlock FontSize="11" Margin="0,6,0,0" FontWeight="SemiBold" Text="Pip 依赖:"/>
                                            <ItemsControl ItemsSource="{Binding SelectedEntry.PipList}" Margin="0,2,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource TagPillBorder}">
                                                            <TextBlock Text="{Binding}" FontSize="10"
                                                                       Foreground="{DynamicResource OnSurfaceBrush}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock FontSize="11" Margin="0,6,0,0" FontWeight="SemiBold" Text="Raw Tags:"/>
                                            <ItemsControl ItemsSource="{Binding SelectedEntry.TagsList}" Margin="0,2,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource TagPillBorder}">
                                                            <TextBlock Text="{Binding}" FontSize="10"
                                                                       Foreground="{DynamicResource OnSurfaceBrush}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock FontSize="11" Margin="0,6,0,0" FontWeight="SemiBold"
                                                       Text="Preemptions(需要预装的 pack):"/>
                                            <ItemsControl ItemsSource="{Binding SelectedEntry.PreemptionsList}" Margin="0,2,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource TagPillBorder}">
                                                            <TextBlock Text="{Binding}" FontSize="10"
                                                                       Foreground="{DynamicResource OnSurfaceBrush}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- v1.0.0.x (2026-09-16) T43i.2.2-fix:删 Badges: TextBlock + 整个
                                                 WrapPanel ItemsControl —— BadgesJson 列(1/5942 entry)删了,
                                                 BadgesList computed property 也删了,XAML 绑源没了。
                                                 详情面板「数据源」expander 不再展示 Badges 字段。 -->

                                            <!-- 查看完整 GitHub API 响应按钮 -->
                                            <Button Content="📄 查看完整 GitHub API 响应 (raw_json)"
                                                    Command="{Binding ShowRawJsonCommand}"
                                                    Margin="0,8,0,0" Padding="8,3"
                                                    Style="{StaticResource MaterialButton}"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Expander>
                                <!-- 版本列表 ItemsControl — 每个 version 一个 card(原 T43f 模板) -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SelectedDetails}" Margin="0,0,0,8">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,4,0,4" Padding="10,8"
                                                        Background="{DynamicResource SurfaceBrush}"
                                                        BorderBrush="{DynamicResource OutlineBrush}"
                                                        BorderThickness="1" CornerRadius="3">
                                                    <StackPanel>
                                                        <!-- Card 头部:version 名 + html_url 链接 -->
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Text="{Binding Version}"
                                                                       FontWeight="Bold" FontSize="13"
                                                                       Margin="0,0,8,0"/>
                                                            <TextBlock DockPanel.Dock="Right"
                                                                       FontSize="11">
                                                                <Hyperlink NavigateUri="{Binding HtmlUrl}"
                                                                           RequestNavigate="RepoLink_RequestNavigate">
                                                                    <Run Text="🔗 仓库地址"/>
                                                                </Hyperlink>
                                                            </TextBlock>
                                                        </DockPanel>

                                                        <!-- 描述(多行可换行) -->
                                                        <TextBlock Text="{Binding Description}"
                                                                   Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"/>

                                                        <!-- 统计行:Stars / Watchers / Forks / Language / OpenIssues / License / DefaultBranch -->
                                                        <WrapPanel Margin="0,6,0,0">
                                                            <TextBlock Margin="0,0,12,0" FontSize="11">
                                                                <Run Text="⭐ Stars:"/>
                                                                <Run Text="{Binding Stars, Mode=OneWay}" FontWeight="SemiBold"/>
                                                            </TextBlock>
                                                            <TextBlock Margin="0,0,12,0" FontSize="11">
                                                                <Run Text="👁 Watchers:"/>
                                                                <Run Text="{Binding Watchers, Mode=OneWay}"/>
                                                            </TextBlock>
                                                            <TextBlock Margin="0,0,12,0" FontSize="11">
                                                                <Run Text="🍴 Forks:"/>
                                                                <Run Text="{Binding Forks, Mode=OneWay}"/>
                                                            </TextBlock>
                                                            <TextBlock Margin="0,0,12,0" FontSize="11">
                                                                <Run Text="📜 License:"/>
                                                                <Run Text="{Binding License, Mode=OneWay}"/>
                                                            </TextBlock>
                                                            <TextBlock Margin="0,0,12,0" FontSize="11">
                                                                <Run Text="💻 Language:"/>
                                                                <Run Text="{Binding Language, Mode=OneWay}"/>
                                                            </TextBlock>
                                                            <TextBlock Margin="0,0,12,0" FontSize="11">
                                                                <Run Text="🐞 OpenIssues:"/>
                                                                <Run Text="{Binding OpenIssues, Mode=OneWay}"/>
                                                            </TextBlock>
                                                            <TextBlock Margin="0,0,12,0" FontSize="11">
                                                                <Run Text="🌿 Branch:"/>
                                                                <Run Text="{Binding DefaultBranch, Mode=OneWay}"/>
                                                            </TextBlock>
                                                            <TextBlock Margin="0,0,12,0" FontSize="11">
                                                                <Run Text="🏷 Latest:"/>
                                                                <Run Text="{Binding LatestReleaseTag, Mode=OneWay}" FontWeight="SemiBold"/>
                                                            </TextBlock>
                                                            <TextBlock Margin="0,0,12,0" FontSize="11">
                                                                <Run Text="📦 Releases:"/>
                                                                <Run Text="{Binding ReleaseCount, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </WrapPanel>

                                                        <!-- 时间:Updated At / Pushed At -->
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock FontSize="11" Margin="0,0,16,0">
                                                                <Run Text="📅 Updated:"/>
                                                                <Run Text="{Binding UpdatedAt, Mode=OneWay}"/>
                                                            </TextBlock>
                                                            <TextBlock FontSize="11">
                                                                <Run Text="📅 Pushed:"/>
                                                                <Run Text="{Binding PushedAt, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <!-- Topics tag pills — ItemsControl 套 TagPillBorder style -->
                                                        <ItemsControl ItemsSource="{Binding TopicTags}" Margin="0,6,0,0">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Style="{StaticResource TagPillBorder}">
                                                                        <TextBlock Text="{Binding}" FontSize="10"
                                                                                   Foreground="{DynamicResource OnSurfaceBrush}"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- v1.0.0.x user「云端其实是有这个功能」+ B 方案:
                                                             raw_json 解析的 branches/recentReleases 给 UI 显示。
                                                             跟 Topics pills 同样 ItemsControl + TagPillBorder 模式。
                                                             Release tag 比 branch 名更突出,绿色背景(branches 用灰)。 -->
                                                        <TextBlock FontSize="11" Margin="0,6,0,0" FontWeight="SemiBold"
                                                                   Text="🌿 分支:"/>
                                                        <ItemsControl ItemsSource="{Binding BranchNames}" Margin="0,2,0,0">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Style="{StaticResource TagPillBorder}">
                                                                        <TextBlock Text="{Binding}" FontSize="10"
                                                                                   Foreground="{DynamicResource OnSurfaceBrush}"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <TextBlock FontSize="11" Margin="0,6,0,0" FontWeight="SemiBold"
                                                                   Text="🚀 最近版本:"/>
                                                        <ItemsControl ItemsSource="{Binding RecentReleases}" Margin="0,2,0,0">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Style="{StaticResource TagPillBorder}">
                                                                        <TextBlock Text="{Binding}" FontSize="10"
                                                                                   Foreground="{DynamicResource OnSurfaceBrush}"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="插件说明">
                            <!-- v1.0.0.x (2026-09-16) T43i.4+user「插件说明似乎没有将 description 显示出来」:
                                 显示 SelectedEntry.Description — raw JSON 顶层 description 字段(T43i.1 入库,
                                 nodelist_entries.description,5924/5924 entry 有值)。
                                 等后续 T43h 抓 raw README 渲染后再升级成 Markdown viewer。
                                 ScrollViewer 包 TextBlock 让长 description 可滚动。 -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding SelectedEntry.Description, Mode=OneWay}"
                                           TextWrapping="Wrap" Margin="12" FontSize="12"
                                           Foreground="{DynamicResource OnSurfaceBrush}"/>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>