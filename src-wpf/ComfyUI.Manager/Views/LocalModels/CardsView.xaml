<UserControl x:Class="ComfyUI.Manager.Views.LocalModels.CardsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ItemsControl ItemsSource="{Binding FilteredModels}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Margin="8" Padding="8" Background="#22FFFFFF" CornerRadius="4"
                        ContextMenu="{StaticResource LocalModelCardContextMenu}">
                    <Grid>
                        <StackPanel Width="200">
                            <!-- 标题 / 类型 / 大小 / hash 跟现有 LocalModelsView.xaml 完全一致 -->
                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Kind}" />
                            <TextBlock Text="{Binding Source}" />
                            <TextBlock Text="{Binding Hash}" FontFamily="Consolas" />
                        </StackPanel>
                        <!-- Star 角标 -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                Background="#80000000" CornerRadius="8" Padding="4"
                                IsHitTestVisible="False"
                                Visibility="{Binding IsStarred, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="⭐" Foreground="Gold" FontSize="14" />
                        </Border>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>