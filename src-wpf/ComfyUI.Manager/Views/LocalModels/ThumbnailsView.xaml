<UserControl x:Class="ComfyUI.Manager.Views.LocalModels.ThumbnailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ComfyUI.Manager.Converters">
    <UserControl.Resources>
        <conv:LocalPathToBitmapConverter x:Key="LocalPathToBitmap" />
    </UserControl.Resources>
    <ListBox ItemsSource="{Binding FilteredModels}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             VirtualizingPanel.ScrollUnit="Pixel">
        <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
            <DataTemplate>
                <Grid Width="160" Height="190" Margin="4">
                    <Border Background="#222" CornerRadius="4">
                        <Image Source="{Binding PreviewImagePath, Converter={StaticResource LocalPathToBitmap}}"
                               Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="{Binding DisplayTitle}"
                               MaxHeight="32" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom"
                               Foreground="White" Background="#80000000" Padding="4" />
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                            Background="#80000000" CornerRadius="8" Padding="4"
                            IsHitTestVisible="False"
                            Visibility="{Binding IsStarred, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="⭐" Foreground="Gold" FontSize="14" />
                    </Border>
                </Grid>
            </DataTemplate>
        </ListBox.ItemTemplate>
        <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
                <Setter Property="ContextMenu" Value="{StaticResource LocalModelCardContextMenu}" />
            </Style>
        </ListBox.ItemContainerStyle>
    </ListBox>
</UserControl>