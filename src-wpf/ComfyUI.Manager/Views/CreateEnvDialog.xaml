<Window x:Class="ComfyUI.Manager.Views.CreateEnvDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ComfyUI.Manager.Views"
        xmlns:vm="clr-namespace:ComfyUI.Manager.ViewModels"
        xmlns:models="clr-namespace:ComfyUI.Manager.Models"
        xmlns:services="clr-namespace:ComfyUI.Manager.Services"
        Title="新建环境" Height="620" Width="560"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        Icon="pack://siteoforigin:,,,/assets/comfyuiLogo.png">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部滚动区:表单 + 进度面板 + 错误 -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding TemplateWarningMessage}"
                           Foreground="Orange" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding TemplateWarningMessage, Converter={x:Static views:NullToVisibilityConverter.Instance}}" />
                <TextBlock Text="名称" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsBusy, Converter={x:Static views:NotBoolConverter.Instance}}"
                         Margin="0,2,0,8" />

                <!-- v1.0.0 T7:TemplateKind picker — 替换 v0.x 的 "shared/independent" Layout。
                     ComboBox 显示 "{Name} ({LocalSourceDir})"。SelectedValuePath="Kind" 让
                     SelectedValue(TwoWay 绑 SelectedTemplateKind)在 TemplateConfig 之间按 Kind 字符串匹配
                     (避免 ReferenceEquals 类默认比较下,选中 TemplateConfig 实例无法 = 字符串)。 -->
                <TextBlock Text="模板" />
                <ComboBox ItemsSource="{Binding TemplateOptions}"
                          SelectedValuePath="Kind"
                          SelectedValue="{Binding SelectedTemplateKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding IsBusy, Converter={x:Static views:NotBoolConverter.Instance}}"
                          Margin="0,2,0,8">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:TemplateConfig}">
                            <TextBlock>
                                <Run Text="{Binding Name}" />
                                <Run Text=" (" />
                                <Run Text="{Binding LocalSourceDir}" />
                                <Run Text=")" />
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Python 解释器 (python.exe)" />
                <DockPanel Margin="0,2,0,8">
                    <Button DockPanel.Dock="Right" Content="应用模板"
                            Command="{Binding ApplyTemplateCommand}"
                            IsEnabled="{Binding IsBusy, Converter={x:Static views:NotBoolConverter.Instance}}"
                            Margin="4,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="浏览..."
                            Click="BrowsePython"
                            IsEnabled="{Binding IsBusy, Converter={x:Static views:NotBoolConverter.Instance}}"
                            Margin="4,0,0,0" />
                    <TextBox Text="{Binding PythonExe, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>

                <TextBlock Text="模板源(由模板选择自动填充,可手动调整)" />
                <DockPanel Margin="0,2,0,8">
                    <Button DockPanel.Dock="Right" Content="应用模板"
                            Command="{Binding ApplyTemplateCommand}"
                            IsEnabled="{Binding IsBusy, Converter={x:Static views:NotBoolConverter.Instance}}"
                            Margin="4,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="浏览..."
                            Click="BrowseComfyui"
                            IsEnabled="{Binding IsBusy, Converter={x:Static views:NotBoolConverter.Instance}}"
                            Margin="4,0,0,0" />
                    <TextBox Text="{Binding TemplateSource, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>

                <TextBlock Text="端口(默认 = 现有最大端口 + 1,空 DB = 8188)" />
                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,2,0,8" />

                <!-- v0.6.7.2:用户备注(选填)。支持多行换行输入。 -->
                <TextBlock Text="备注(选填,例如用途说明)" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="60" MaxHeight="120"
                         VerticalScrollBarVisibility="Auto"
                         IsEnabled="{Binding IsBusy, Converter={x:Static views:NotBoolConverter.Instance}}"
                         Margin="0,2,0,8" />

                <!-- 步骤进度面板:仅在 IsBusy=true 时显示 -->
                <Border BorderBrush="#7F888888" BorderThickness="1" CornerRadius="4"
                        Background="#0A888888"
                        Padding="12,8" Margin="0,8,0,0"
                        Visibility="{Binding IsBusy, Converter={x:Static views:BoolToVisibilityConverter.Instance}}">
                    <StackPanel>
                        <TextBlock Text="创建进度"
                                   FontWeight="SemiBold" Foreground="#FF67A4A4"
                                   Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CreateStepViewModel}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                                   VerticalAlignment="Top">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FFAAAAAA" />
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static services:CreateStepStatus.Running}">
                                                            <Setter Property="Foreground" Value="#FF6750A4" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static services:CreateStepStatus.Done}">
                                                            <Setter Property="Foreground" Value="#FF2E7D32" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static services:CreateStepStatus.Failed}">
                                                            <Setter Property="Foreground" Value="#FFC62828" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#FF666666" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static services:CreateStepStatus.Running}">
                                                                <Setter Property="Foreground" Value="#FF222222" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static services:CreateStepStatus.Done}">
                                                                <Setter Property="Foreground" Value="#FF2E7D32" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static services:CreateStepStatus.Failed}">
                                                                <Setter Property="Foreground" Value="#FFC62828" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Detail}"
                                                       Foreground="#FF888888" FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,1,0,0"
                                                       Visibility="{Binding Detail, Converter={x:Static views:NullToVisibilityConverter.Instance}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                           TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding ErrorMessage, Converter={x:Static views:NullToVisibilityConverter.Instance}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- 底部固定按钮行 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0"
                    HorizontalAlignment="Right">
            <Button Content="创建" Command="{Binding CreateCommand}"
                    Style="{StaticResource MaterialButton}"
                    Width="80" />
            <Button Content="取消" Command="{Binding CancelCommand}"
                    Style="{StaticResource MaterialButton}"
                    Margin="8,0,0,0" Width="80" />
        </StackPanel>
    </Grid>
</Window>
