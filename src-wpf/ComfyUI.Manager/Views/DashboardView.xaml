<UserControl x:Class="ComfyUI.Manager.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ComfyUI.Manager.ViewModels"
             xmlns:models="clr-namespace:ComfyUI.Manager.Models"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             Background="{DynamicResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- ============ Hero 区:标题 + 版本 + GitHub 数据条 ============ -->
            <!-- v0.6.12+:删 hero 图标 — asset/icon.png 是 ComfyUI 官方"4 个 logo 集合
                 参考图",缩到 96×52 几乎看不出是 logo(用户报"被清除/难看")。Logo
                 仅保留 Window.Icon(任务栏 EXE icon)。 -->
            <Border Margin="0,0,0,16" Padding="20"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="8">
                <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="{x:Static models:DashboardPageLocalizable.Refresh}"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource MaterialButton}"
                                VerticalAlignment="Top"
                                MinWidth="80" />
                        <StackPanel>
                            <TextBlock Text="ComfyUI 多环境管理系统"
                                       FontSize="24" FontWeight="Bold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="智能管理 ComfyUI 环境、节点、依赖"
                                       Foreground="Gray" FontSize="12"
                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding LastSnapshot.LatestRelease, Mode=OneWay, TargetNullValue='—'}"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       Margin="0,8,0,0" />
                            <TextBlock Foreground="Gray" FontSize="11" Margin="0,4,0,0">
                                <Run Text="⭐ " />
                                <Run Text="{Binding GitHubStars, Mode=OneWay, TargetNullValue='—'}" />
                                <Run Text=" stars · 📦 " />
                                <Run Text="{Binding GitHubReleaseCount, Mode=OneWay, TargetNullValue='—'}" />
                                <Run Text=" releases" />
                            </TextBlock>
                            <TextBlock Foreground="Gray" FontSize="11" Margin="0,2,0,0"
                                       Text="{Binding LastSnapshot.SnapshotAt, Mode=OneWay, StringFormat='更新于 {0:yyyy-MM-dd HH:mm:ss}'}" />
                        </StackPanel>
                    </DockPanel>
            </Border>

            <!-- Loading indicator -->
            <TextBlock Text="{x:Static models:DashboardPageLocalizable.Loading}"
                       Foreground="Gray" Margin="0,0,0,8"
                       Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibility}}" />

            <!-- ============ 4 卡片(2x2)============ -->
            <!-- 注意:EnvStatsCard / NodeCountCard / RecentOpsCard / VersionCard 四个
                 x:Name 被 DashboardView.xaml.cs 的 stagger 动画硬引用,不能改名/删除。 -->
            <Grid Visibility="{Binding LastSnapshot, Converter={StaticResource NullToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Card 1 (0,0): Environment Stats -->
                <Border x:Name="EnvStatsCard" Grid.Row="0" Grid.Column="0"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="8" Padding="20"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform Y="20" />
                    </Border.RenderTransform>
                    <StackPanel>
                        <TextBlock Text="{x:Static models:DashboardPageLocalizable.EnvironmentStats}"
                                   FontSize="14" FontWeight="Bold" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding LastSnapshot.EnvironmentCounts.Running, Mode=OneWay}"
                                           FontSize="28" FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Static models:DashboardPageLocalizable.Running}"
                                           Foreground="Gray" FontSize="11"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding LastSnapshot.EnvironmentCounts.Stopped, Mode=OneWay}"
                                           FontSize="28" FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Static models:DashboardPageLocalizable.Stopped}"
                                           Foreground="Gray" FontSize="11"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding LastSnapshot.EnvironmentCounts.Undeployed, Mode=OneWay}"
                                           FontSize="28" FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Static models:DashboardPageLocalizable.Undeployed}"
                                           Foreground="Gray" FontSize="11"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="{Binding LastSnapshot.TotalEnvironments, Mode=OneWay}"
                                           FontSize="28" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryBrush}" />
                                <TextBlock Text="{x:Static models:DashboardPageLocalizable.Total}"
                                           Foreground="Gray" FontSize="11"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 2 (0,2): Node Count -->
                <Border x:Name="NodeCountCard" Grid.Row="0" Grid.Column="2"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="8" Padding="20"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform Y="20" />
                    </Border.RenderTransform>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Static models:DashboardPageLocalizable.NodeCount}"
                                   FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding LastSnapshot.NodeCount, Mode=OneWay}"
                                   FontSize="48" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryBrush}" />
                        <TextBlock Text="→ 查看节点目录" Foreground="Gray"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Card 3 (2,0): Recent Operations -->
                <Border x:Name="RecentOpsCard" Grid.Row="2" Grid.Column="0"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="8" Padding="20"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform Y="20" />
                    </Border.RenderTransform>
                    <StackPanel>
                        <TextBlock Text="{x:Static models:DashboardPageLocalizable.RecentOps}"
                                   FontSize="14" FontWeight="Bold" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding LastSnapshot.RecentOperations, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ParsedTime, Mode=OneWay, StringFormat='[{0:HH:mm:ss}]'}" Foreground="Gray" />
                                        <TextBlock Grid.Column="1" Text="{Binding Subsystem, Mode=OneWay}" Foreground="{DynamicResource PrimaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Message, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Card 4 (2,2): 最新发布 + 最近更新(changelog)合并 -->
                <Border x:Name="VersionCard" Grid.Row="2" Grid.Column="2"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="8" Padding="20"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform Y="20" />
                    </Border.RenderTransform>
                    <StackPanel>
                        <TextBlock Text="{x:Static models:DashboardPageLocalizable.LatestVersion}"
                                   FontSize="14" FontWeight="Bold" Margin="0,0,0,12"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding LastSnapshot.LatestRelease, Mode=OneWay, TargetNullValue='—'}"
                                   FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryBrush}" />
                        <TextBlock Text="{x:Static models:DashboardPageLocalizable.GitHubFailed}"
                                   Foreground="#FF6B6B"
                                   Visibility="{Binding LastSnapshot.GitHubFailed, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                        <!-- v0.6.11+ T3 fix:spec §A.4 — GitHub 不可达 **且** 有 stale 缓存时
                             额外显示离线 badge(spec 原文「grey out + ⓘ 离线模式,使用缓存数据」)。
                             IsOfflineMode 同时 encode GitHubFailed + LastChangelogSync != null:
                             GitHubFailed=true 但完全没缓存(LastChangelogSync=null)时只显
                             「❌ Failed」,避免同一卡片同时显示「离线」+「Failed」互相矛盾。 -->
                        <TextBlock Text="ⓘ 离线模式,使用缓存数据"
                                   Foreground="Gray" FontSize="11"
                                   Visibility="{Binding IsOfflineMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                   HorizontalAlignment="Center" Margin="0,2,0,0" />

                        <Separator Margin="0,12,0,8" />

                        <TextBlock Text="📋 最近更新" FontSize="12" FontWeight="Bold" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding VisibleChangelog, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8" Margin="0,2"
                                            BorderBrush="{DynamicResource PrimaryBrush}"
                                            BorderThickness="0,0,0,1"
                                            CornerRadius="4">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Version, Mode=OneWay}" FontWeight="Bold" FontSize="12" />
                                                <TextBlock Text="{Binding Date, Mode=OneWay, StringFormat=' ({0:yyyy-MM-dd})'}"
                                                           Foreground="Gray" FontSize="11" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding BulletPoints, Mode=OneWay}" Margin="0,2,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Mode=OneWay, StringFormat='• {0}'}"
                                                                   FontSize="11" Margin="0,1"
                                                                   TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{Binding ChangelogToggleLabel, Mode=OneWay}"
                                Command="{Binding ToggleChangelogExpandCommand}"
                                Style="{StaticResource MaterialButton}"
                                HorizontalAlignment="Center" Margin="0,8,0,0"
                                MinWidth="110" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ 📥 下载地址 ============ -->
            <Border Margin="0,16,0,0" Padding="20"
                    Background="{DynamicResource SurfaceBrush}" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="📥 下载地址" FontSize="14" FontWeight="Bold" Margin="0,0,0,12" />

                    <TextBlock Text="本地 staging:" FontSize="11" Foreground="Gray" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding StagingPath, Mode=OneWay}"
                               FontFamily="Consolas" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="📋 复制路径" Command="{Binding CopyStagingPathCommand}"
                                Style="{StaticResource MaterialButton}" MinWidth="120" Margin="0,0,8,0" />
                        <Button Content="📂 打开文件夹" Command="{Binding OpenStagingFolderCommand}"
                                Style="{StaticResource MaterialButton}" MinWidth="120" />
                    </StackPanel>

                    <Separator Margin="0,0,0,12" />

                    <TextBlock Text="GitHub Release:" FontSize="11" Foreground="Gray" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding ReleaseUrl, Mode=OneWay}"
                               FontFamily="Consolas" FontSize="11"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                    <Button Content="🌐 浏览器打开" Command="{Binding OpenReleaseUrlCommand}"
                            Style="{StaticResource MaterialButton}" MinWidth="120"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
