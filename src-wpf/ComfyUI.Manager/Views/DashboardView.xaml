<UserControl x:Class="ComfyUI.Manager.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ComfyUI.Manager.ViewModels"
             xmlns:models="clr-namespace:ComfyUI.Manager.Models"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             Background="{DynamicResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- 标题 + 刷新按钮 + snapshot 时间 -->
            <DockPanel Margin="0,0,0,16">
                <TextBlock Text="{x:Static models:DashboardPageLocalizable.Title}"
                           FontSize="{StaticResource FontSizeTitle}"
                           FontWeight="Bold" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="{x:Static models:DashboardPageLocalizable.Refresh}"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource MaterialButton}"
                        MinWidth="80" />
                <TextBlock VerticalAlignment="Center" Foreground="Gray"
                           Text="{Binding LastSnapshot.SnapshotAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                           Margin="16,0,0,0" />
            </DockPanel>

            <!-- Loading indicator -->
            <TextBlock Text="{x:Static models:DashboardPageLocalizable.Loading}"
                       Foreground="Gray" Margin="0,0,0,8"
                       Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibility}}" />

            <!-- 4-card grid (2x2) -->
            <Grid Visibility="{Binding LastSnapshot, Converter={StaticResource NullToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Card 1 (0,0): Environment Stats -->
                <Border x:Name="EnvStatsCard" Grid.Row="0" Grid.Column="0"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="8" Padding="20"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform Y="20" />
                    </Border.RenderTransform>
                    <StackPanel>
                        <TextBlock Text="{x:Static models:DashboardPageLocalizable.EnvironmentStats}"
                                   FontSize="14" FontWeight="Bold" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding LastSnapshot.EnvironmentCounts.Running}"
                                           FontSize="28" FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Static models:DashboardPageLocalizable.Running}"
                                           Foreground="Gray" FontSize="11"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding LastSnapshot.EnvironmentCounts.Stopped}"
                                           FontSize="28" FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Static models:DashboardPageLocalizable.Stopped}"
                                           Foreground="Gray" FontSize="11"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding LastSnapshot.EnvironmentCounts.Undeployed}"
                                           FontSize="28" FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Static models:DashboardPageLocalizable.Undeployed}"
                                           Foreground="Gray" FontSize="11"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="{Binding LastSnapshot.TotalEnvironments}"
                                           FontSize="28" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryBrush}" />
                                <TextBlock Text="{x:Static models:DashboardPageLocalizable.Total}"
                                           Foreground="Gray" FontSize="11"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 2 (0,2): Node Count -->
                <Border x:Name="NodeCountCard" Grid.Row="0" Grid.Column="2"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="8" Padding="20"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform Y="20" />
                    </Border.RenderTransform>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Static models:DashboardPageLocalizable.NodeCount}"
                                   FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding LastSnapshot.NodeCount}"
                                   FontSize="48" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryBrush}" />
                        <TextBlock Text="→ 查看节点目录" Foreground="Gray"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Card 3 (2,0): Recent Operations -->
                <Border x:Name="RecentOpsCard" Grid.Row="2" Grid.Column="0"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="8" Padding="20"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform Y="20" />
                    </Border.RenderTransform>
                    <StackPanel>
                        <TextBlock Text="{x:Static models:DashboardPageLocalizable.RecentOps}"
                                   FontSize="14" FontWeight="Bold" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding LastSnapshot.RecentOperations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ParsedTime, StringFormat='[{0:HH:mm:ss}]'}" Foreground="Gray" />
                                        <TextBlock Grid.Column="1" Text="{Binding Subsystem}" Foreground="{DynamicResource PrimaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Card 4 (2,2): Latest Release -->
                <Border x:Name="VersionCard" Grid.Row="2" Grid.Column="2"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="8" Padding="20"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform Y="20" />
                    </Border.RenderTransform>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static models:DashboardPageLocalizable.LatestVersion}"
                                   FontSize="14" FontWeight="Bold" Margin="0,0,0,12"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding LastSnapshot.LatestRelease}"
                                   FontSize="32" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryBrush}" />
                        <TextBlock Text="{x:Static models:DashboardPageLocalizable.GitHubFailed}"
                                   Foreground="#FF6B6B"
                                   Visibility="{Binding LastSnapshot.GitHubFailed, Converter={StaticResource BoolToVisibility}}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>