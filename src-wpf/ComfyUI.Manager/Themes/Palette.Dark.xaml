<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Material You Dark -->
    <!-- Material You Dark ——
         v1.0.0.x (2026-09-15) T43g+user 「紫色按钮太难看」反馈:
         Dark 默认 #BB86FC 淡紫改成中性白(去色调化)。
         Primary=#E6E1E5 浅白(跟 InverseOnSurfaceBrush 同色),
         PrimaryVariant=#C5C0CF hover 状态(深一档,仍浅灰系)。 -->
    <Color x:Key="PrimaryColor">#E6E1E5</Color>
    <Color x:Key="PrimaryVariantColor">#C5C0CF</Color>
    <Color x:Key="SecondaryColor">#03DAC6</Color>
    <Color x:Key="SurfaceColor">#2D2D2D</Color>
    <Color x:Key="BackgroundColor">#1E1E1E</Color>
    <Color x:Key="ErrorColor">#CF6679</Color>
    <Color x:Key="ErrorVariantColor">#B00020</Color>
    <Color x:Key="SuccessColor">#4CAF50</Color>
    <Color x:Key="WarningColor">#FFB300</Color>
    <Color x:Key="OnPrimaryColor">#1C1B1F</Color>
    <Color x:Key="OnSurfaceColor">#E6E1E5</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryVariantBrush" Color="{StaticResource PrimaryVariantColor}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <!-- v1.0.0.x (2026-09-05):Sidebar 选中态资源(Dark 主题) ——
         Dark 选中: Background 白 + Foreground 黑
         跟主背景(#1E1E1E 深灰)翻转形成高对比。 -->
    <Color x:Key="SidebarSelectedBackgroundColor">#FFFFFF</Color>
    <Color x:Key="SidebarSelectedForegroundColor">#000000</Color>
    <SolidColorBrush x:Key="SidebarSelectedBackgroundBrush" Color="{StaticResource SidebarSelectedBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarSelectedForegroundBrush" Color="{StaticResource SidebarSelectedForegroundColor}" />
    <!-- v1.0.0.x (2026-09-05):Inverse 系列 ——
         Dark 主题 InverseOnSurface = #E6E1E5(浅白),InverseOnPrimary = #1C1B1F(深黑)。
         sidebar 选中态用这个,跟 Background 翻转形成高对比。 -->
    <Color x:Key="InverseOnSurfaceColor">#E6E1E5</Color>
    <Color x:Key="InverseOnPrimaryColor">#1C1B1F</Color>
    <SolidColorBrush x:Key="InverseOnSurfaceBrush" Color="{StaticResource InverseOnSurfaceColor}" />
    <SolidColorBrush x:Key="InverseOnPrimaryBrush" Color="{StaticResource InverseOnPrimaryColor}" />
    <!-- v1.0.0.x (2026-09-05):WindowBackgroundBrush 别名 BackgroundBrush ——
         ModelMarketplaceView/WorkflowMarketplaceView 早期 hardcode 引用 WindowBackgroundBrush
         (没有这个 key,WPF fallback SystemColors.WindowBrush=白底)。Dark 模式下白底明显。
         加 alias 让早期 XAML 仍能解析,Future 改 background 时统一用 BackgroundBrush。 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorVariantBrush" Color="{StaticResource ErrorVariantColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <Color x:Key="WarningContainerColor">#3D2F00</Color>
    <Color x:Key="OnWarningColor">#FFE0A6</Color>
    <SolidColorBrush x:Key="WarningContainerBrush" Color="{StaticResource WarningContainerColor}" />
    <SolidColorBrush x:Key="OnWarningBrush" Color="{StaticResource OnWarningColor}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}" />
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="#49454F" />
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="#CAC4D0" />
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurfaceColor}" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#252525" />
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="{StaticResource OnSurfaceColor}" />
    <SolidColorBrush x:Key="OutlineBrush" Color="#938F99" />

    <!-- v1.0.0.x #590:Console 面板 terminal 配色 — Dark/Light 都用同一深色,
         仿 cmd/PowerShell 终端风格。Header strip 略浅一档区分。 -->
    <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="ConsoleHeaderBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="ConsoleForegroundBrush" Color="#E6E1E5" />
    <SolidColorBrush x:Key="ConsoleAccentBrush" Color="#569CD6" />
</ResourceDictionary>
