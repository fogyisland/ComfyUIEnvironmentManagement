<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Material You Dark -->
    <Color x:Key="PrimaryColor">#BB86FC</Color>
    <Color x:Key="PrimaryVariantColor">#9965E0</Color>
    <Color x:Key="SecondaryColor">#03DAC6</Color>
    <Color x:Key="SurfaceColor">#2D2D2D</Color>
    <Color x:Key="BackgroundColor">#1E1E1E</Color>
    <Color x:Key="ErrorColor">#CF6679</Color>
    <Color x:Key="ErrorVariantColor">#B00020</Color>
    <Color x:Key="SuccessColor">#4CAF50</Color>
    <Color x:Key="OnPrimaryColor">#1C1B1F</Color>
    <Color x:Key="OnSurfaceColor">#E6E1E5</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryVariantBrush" Color="{StaticResource PrimaryVariantColor}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorVariantBrush" Color="{StaticResource ErrorVariantColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}" />
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurfaceColor}" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#252525" />
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="{StaticResource OnSurfaceColor}" />
    <SolidColorBrush x:Key="OutlineBrush" Color="#938F99" />
</ResourceDictionary>
