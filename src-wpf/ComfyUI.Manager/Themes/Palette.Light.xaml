<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Material You Light -->
    <Color x:Key="PrimaryColor">#6750A4</Color>
    <Color x:Key="PrimaryVariantColor">#4F378B</Color>
    <Color x:Key="SecondaryColor">#625B71</Color>
    <Color x:Key="SurfaceColor">#FFFBFE</Color>
    <Color x:Key="BackgroundColor">#F6F1FB</Color>
    <Color x:Key="ErrorColor">#B3261E</Color>
    <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
    <Color x:Key="OnSurfaceColor">#1C1B1F</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryVariantBrush" Color="{StaticResource PrimaryVariantColor}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}" />
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurfaceColor}" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#EEEAF3" />
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="{StaticResource OnSurfaceColor}" />
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource SecondaryColor}" />
</ResourceDictionary>
