<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Material You Light ——
         v1.0.0.x (2026-09-15) T43g+user 「紫色按钮太难看」反馈:
         Material You 默认 #6750A4 深紫色 MaterialButton Background 太扎眼,
         改成中性黑(去色调化)— 跟 OnSurfaceColor=#1C1B1F 同色,
         让按钮变纯黑控件,Material Design Monochrome 风格。
         PrimaryVariant=#2D2D2D 微调 hover 状态(深一档,仍黑灰系)。 -->
    <Color x:Key="PrimaryColor">#1C1B1F</Color>
    <Color x:Key="PrimaryVariantColor">#2D2D2D</Color>
    <Color x:Key="SecondaryColor">#625B71</Color>
    <Color x:Key="SurfaceColor">#FFFBFE</Color>
    <Color x:Key="BackgroundColor">#F6F1FB</Color>
    <Color x:Key="ErrorColor">#B3261E</Color>
    <Color x:Key="ErrorVariantColor">#8E1D17</Color>
    <Color x:Key="SuccessColor">#2E7D32</Color>
    <Color x:Key="WarningColor">#F57C00</Color>
    <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
    <Color x:Key="OnSurfaceColor">#1C1B1F</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryVariantBrush" Color="{StaticResource PrimaryVariantColor}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <!-- v1.0.0.x (2026-09-05):Sidebar 选中态资源 ——
         之前用 OnSurface/Inverse 系列配错(字与底同色看不见)。
         现在显式定义 Sidebar 选中态颜色,清晰命名,跟主背景反色。
         Light 选中: SidebarSelectedBackgroundBrush = #000000 黑 + SidebarSelectedForegroundBrush = #FFFFFF 白
         Dark  选中: SidebarSelectedBackgroundBrush = #FFFFFF 白 + SidebarSelectedForegroundBrush = #000000 黑 -->
    <Color x:Key="SidebarSelectedBackgroundColor">#000000</Color>
    <Color x:Key="SidebarSelectedForegroundColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="SidebarSelectedBackgroundBrush" Color="{StaticResource SidebarSelectedBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarSelectedForegroundBrush" Color="{StaticResource SidebarSelectedForegroundColor}" />
    <!-- v1.0.0.x (2026-09-05):Inverse 系列 ——
         sidebar 选中态背景 + 文字反色用。InverseOnSurfaceBrush 跟 OnSurfaceBrush
         反相(实际上 Light OnSurface=#1C1B1F 深黑 + InverseOnSurface 白 = 互反),
         但更明确命名:选中态 = 主背景反色 + 文字反色。
         Light: InverseOnSurfaceBrush=#1C1B1F(深黑) + InverseOnPrimaryBrush=#FFFFFF(白)
         Dark:  InverseOnSurfaceBrush=#E6E1E5(浅白) + InverseOnPrimaryBrush=#1C1B1F(深黑) -->
    <Color x:Key="InverseOnSurfaceColor">#1C1B1F</Color>
    <Color x:Key="InverseOnPrimaryColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="InverseOnSurfaceBrush" Color="{StaticResource InverseOnSurfaceColor}" />
    <SolidColorBrush x:Key="InverseOnPrimaryBrush" Color="{StaticResource InverseOnPrimaryColor}" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorVariantBrush" Color="{StaticResource ErrorVariantColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <Color x:Key="WarningContainerColor">#FFF3E0</Color>
    <Color x:Key="OnWarningColor">#5D2F00</Color>
    <SolidColorBrush x:Key="WarningContainerBrush" Color="{StaticResource WarningContainerColor}" />
    <SolidColorBrush x:Key="OnWarningBrush" Color="{StaticResource OnWarningColor}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}" />
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="#E7E0EC" />
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="#49454F" />
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurfaceColor}" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#EEEAF3" />
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="{StaticResource OnSurfaceColor}" />
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource SecondaryColor}" />

    <!-- v1.0.0.x #590:Console 面板 terminal 配色 — Dark/Light 都用同一深色,
         仿 cmd/PowerShell 终端风格(浅主题也固定深色底)。 -->
    <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="ConsoleHeaderBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="ConsoleForegroundBrush" Color="#E6E1E5" />
    <SolidColorBrush x:Key="ConsoleAccentBrush" Color="#569CD6" />
</ResourceDictionary>
