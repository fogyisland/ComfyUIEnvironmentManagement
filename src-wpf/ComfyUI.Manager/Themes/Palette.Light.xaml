<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Material You Light -->
    <Color x:Key="PrimaryColor">#6750A4</Color>
    <Color x:Key="PrimaryVariantColor">#4F378B</Color>
    <Color x:Key="SecondaryColor">#625B71</Color>
    <Color x:Key="SurfaceColor">#FFFBFE</Color>
    <Color x:Key="BackgroundColor">#F6F1FB</Color>
    <Color x:Key="ErrorColor">#B3261E</Color>
    <Color x:Key="ErrorVariantColor">#8E1D17</Color>
    <Color x:Key="SuccessColor">#2E7D32</Color>
    <Color x:Key="WarningColor">#F57C00</Color>
    <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
    <Color x:Key="OnSurfaceColor">#1C1B1F</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryVariantBrush" Color="{StaticResource PrimaryVariantColor}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorVariantBrush" Color="{StaticResource ErrorVariantColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <Color x:Key="WarningContainerColor">#FFF3E0</Color>
    <Color x:Key="OnWarningColor">#5D2F00</Color>
    <SolidColorBrush x:Key="WarningContainerBrush" Color="{StaticResource WarningContainerColor}" />
    <SolidColorBrush x:Key="OnWarningBrush" Color="{StaticResource OnWarningColor}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}" />
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="#E7E0EC" />
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="#49454F" />
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurfaceColor}" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#EEEAF3" />
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="{StaticResource OnSurfaceColor}" />
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource SecondaryColor}" />

    <!-- v1.0.0.x #590:Console 面板 terminal 配色 — Dark/Light 都用同一深色,
         仿 cmd/PowerShell 终端风格(浅主题也固定深色底)。 -->
    <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="ConsoleHeaderBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="ConsoleForegroundBrush" Color="#E6E1E5" />
    <SolidColorBrush x:Key="ConsoleAccentBrush" Color="#569CD6" />
</ResourceDictionary>
