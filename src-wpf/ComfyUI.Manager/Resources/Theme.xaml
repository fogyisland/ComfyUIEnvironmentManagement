<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:ComfyUI.Manager.Views">

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <views:BoolToBrushConverter x:Key="BoolToBrush" />
    <views:NullToVisibilityConverter x:Key="NullToVisibility" />
    <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <views:InverseBoolConverter x:Key="InverseBool" />
    <views:ZeroCountToVisibilityConverter x:Key="ZeroCountToVisibility" />

    <!-- Palette 资源现在由 Themes/Palette.Light.xaml 或 Themes/Palette.Dark.xaml 提供(经 App.xaml 槽位合并)。
         本文件只保留 converters / font sizes / paddings / styles / data templates。
         v0.6.9 T1 改动:删 line 13-39 的 8 colors + 8 brushes,迁移到 Themes/ 目录的 palette dict。
         styles 仍引用 {StaticResource PrimaryBrush} 等,资源查找会跨 merged dictionaries 命中 palette 槽位。-->

    <!-- 字号 -->
    <sys:Double x:Key="FontSizeSmall"
        xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>
    <sys:Double x:Key="FontSizeBody"
        xmlns:sys="clr-namespace:System;assembly=mscorlib">14</sys:Double>
    <sys:Double x:Key="FontSizeTitle"
        xmlns:sys="clr-namespace:System;assembly=mscorlib">18</sys:Double>

    <!-- 间距 -->
    <Thickness x:Key="PaddingSmall">4</Thickness>
    <Thickness x:Key="PaddingMedium">8</Thickness>
    <Thickness x:Key="PaddingLarge">16</Thickness>

    <!-- Button 样式 -->
    <Style x:Key="MaterialButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}" />
        <Setter Property="Padding" Value="{StaticResource PaddingMedium}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- TextBox 样式 -->
    <Style x:Key="MaterialTextBox" TargetType="TextBox">
        <Setter Property="Padding" Value="{StaticResource PaddingSmall}" />
        <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}" />
    </Style>

    <!-- Catalog 磁贴视图:WrapPanel + 详细卡片 -->
    <ItemsPanelTemplate x:Key="CatalogTileWrapPanel">
        <WrapPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <!-- ListBoxItem 容器:去掉默认蓝色高亮,改成细边框 hover/selected 反馈。
         用于 Catalog 磁贴视图,让 tile 可被点击并触发 selection。 -->
    <Style x:Key="CatalogTileItemContainerStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="2"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#90A4AE" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="CatalogTileTemplate">
        <Border Width="320" Margin="8" Padding="12"
                Background="White" BorderBrush="LightGray" BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="{Binding Package}" FontWeight="Bold" FontSize="14" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                    <TextBlock Text="{Binding RawMetadata[author]}" Foreground="Gray" />
                    <TextBlock Text=" · " Foreground="Gray" />
                    <TextBlock Text="⭐" />
                    <TextBlock Text="{Binding RawMetadata[stars]}" />
                </StackPanel>
                <TextBlock Text="{Binding RawMetadata[description]}"
                           TextWrapping="Wrap" MaxHeight="60"
                           TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                <Button Content="安装" HorizontalAlignment="Right"
                        Command="{Binding DataContext.InstallCommand,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource MaterialButton}" />
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>