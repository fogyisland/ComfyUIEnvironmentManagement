<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ComfyUI.Manager.Converters"
    xmlns:views="clr-namespace:ComfyUI.Manager.Views"
    xmlns:behaviors="clr-namespace:ComfyUI.Manager.Behaviors"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- v0.6.21 T3:BindablePasswordBox.xaml 自定义控件样式注册。
         BindablePasswordBox.xaml 内 {StaticResource BoolToVisibility} / {StaticResource InverseBoolToVisibility}
         经 parent-dict 查找命中本 Theme.xaml 下方 converter 声明;style TargetType 不带 x:Key
         自动应用到任何 <controls:BindablePasswordBox/> 实例,跟 MaterialButton 同款隐式 style。
         MergedDictionaries 必须在 ResourceDictionary 顶端(WPF XAML:property element 不能
         在 element content 中间),所以放最上面。 -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/ComfyUI.Manager;component/Controls/BindablePasswordBox.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <converters:SectionEqualityToBoolConverter x:Key="SectionEquality" />
    <converters:EnumEqualsConverter x:Key="EnumEqualsConverter" />
    <converters:PickerFilterEqualsConverter x:Key="PickerFilterEqualsConverter" />
    <!-- v0.6.22+:Settings 访问代理段 URL/Port 输入框 IsEnabled = HttpProxyEnabled AND !HttpProxyUseSystemProxy -->
    <converters:AndBoolMultiConverter x:Key="AndBool" />
    <converters:InvertBoolConverter x:Key="InvertBool" />
    <!-- v0.6.17.1:DataTrigger.Value 不能挂 {Binding},改用 MultiBinding + 本 converter。
         env 行 🪵 图标 deep/dim 切换:values[0]=VM ActiveStartStatusEnvId,values[1]=this.Id,
         相等 → true → Foreground 切 OnSurfaceBrush(深)。 -->
    <converters:StringEqualityMultiConverter x:Key="StringEqualityMulti" />
    <!-- v0.6.22+:model marketplace sort/period chip 高亮 — values[0]=chip item, values[1]=VM.ActiveSort,
         类型相同时返 bool 给 DataTrigger.Value(必须字面量,不能挂 {Binding} — v0.6.17.1 lesson)。 -->
    <converters:EnumEqualsMultiConverter x:Key="EnumEqualsMultiConverter" />
    <!-- v0.6.22+:model marketplace sort/period row 在 ActiveSource=CivitAi 时显示,HF 隐藏。 -->
    <converters:EnumEqualsVisibilityConverter x:Key="EnumEqualsVisibility" />
    <!-- v0.6.15.10:bool → "trueText|falseText",node-mgmt row details 用 "存在|无"。 -->
    <converters:BoolToTextConverter x:Key="BoolToText" />
    <views:BoolToBrushConverter x:Key="BoolToBrush" />
    <views:SeverityToBrushConverter x:Key="SeverityToBrush" />
    <views:NullToVisibilityConverter x:Key="NullToVisibility" />
    <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <views:InverseBoolConverter x:Key="InverseBool" />
    <views:ZeroCountToVisibilityConverter x:Key="ZeroCountToVisibility" />
    <views:InverseZeroCountToVisibilityConverter x:Key="InverseZeroCountToVisibility" />
    <views:BoolToEntryCountTextConverter x:Key="BoolToEntryCountText" />
    <views:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility" />
    <views:RelativeTimeConverter x:Key="RelativeTime" />
    <!-- v0.6.19.x:工作流卡片 source pill badge — WorkflowSourceKind → Brush/Text。 -->
    <views:WorkflowSourceBadgeBrushConverter x:Key="WorkflowSourceBadgeBrush" />
    <views:WorkflowSourceBadgeTextConverter x:Key="WorkflowSourceBadgeText" />
    <!-- v0.6.20 T7:模型卡片 NSFW + Kind badge pill — ModelNsfwKind → Brush/Text,ModelKind → Brush。 -->
    <views:ModelNsfwBadgeBrushConverter x:Key="ModelNsfwBadgeBrush" />
    <views:ModelNsfwBadgeTextConverter x:Key="ModelNsfwBadgeText" />
    <views:ModelKindBadgeBrushConverter x:Key="ModelKindBadgeBrush" />

    <!-- Palette 资源现在由 Themes/Palette.Light.xaml 或 Themes/Palette.Dark.xaml 提供(经 App.xaml 槽位合并)。
         本文件只保留 converters / font sizes / paddings / styles / data templates。
         v0.6.9 T1 改动:删 line 13-39 的 8 colors + 8 brushes,迁移到 Themes/ 目录的 palette dict。
         styles 仍引用 {StaticResource PrimaryBrush} 等,资源查找会跨 merged dictionaries 命中 palette 槽位。-->

    <!-- 字号 -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeTitle">18</sys:Double>

    <!-- 间距 -->
    <Thickness x:Key="PaddingSmall">4</Thickness>
    <Thickness x:Key="PaddingMedium">8</Thickness>
    <Thickness x:Key="PaddingLarge">16</Thickness>

    <!-- v0.6.9 T8:动效时长(统一从 MotionSettings 读,但 Theme.xaml 也暴露给 XAML binding)。
         Storyboard 用 ms,后续可在 XAML 里直接 {StaticResource MotionDurationRippleMs} 复用。 -->
    <sys:Double x:Key="MotionDurationRippleMs">50</sys:Double>
    <sys:Double x:Key="MotionDurationFadeViewMs">200</sys:Double>
    <sys:Double x:Key="MotionDurationSlideBannerMs">250</sys:Double>
    <sys:Double x:Key="MotionDurationStaggerDashboardMs">100</sys:Double>
    <sys:Double x:Key="MotionDurationThemeCrossfadeMs">300</sys:Double>

    <!-- Button 样式(v0.6.9 T8:加 ControlTemplate 包裹 ContentPresenter + RippleOverlay Canvas,
         接 RippleBehavior attached property。保留所有原 setter/trigger 结构。
         v0.6.9.2 hotfix:Style Setter 改 property-element + StaticResource markup extension
         — attribute syntax 的 {StaticResource PrimaryBrush} 在 v0.6.9 T1 palette 拆分后,
         Setter apply 时 SetterBaseValueSource 解析失败,Button.Background 变 UnsetValue,
         模板加载时 Border 的 Background="{TemplateBinding Background}" 拿 UnsetValue → SetValue
         抛 "UnsetValue 不是 Background 的有效值"。原 v0.6.8 没事是因为 PrimaryBrush 在 Theme.xaml
         自身(解析时已 in-scope),palette 拆出去后 Setter 解析路径变了。DynamicResource 在
         Setter 里不受此影响 — 仍按 attribute 写法保留。 -->
    <Style x:Key="MaterialButton" TargetType="Button">
        <Setter Property="Background">
            <Setter.Value>
                <DynamicResource ResourceKey="PrimaryBrush" />
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground">
            <Setter.Value>
                <DynamicResource ResourceKey="OnPrimaryBrush" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding">
            <Setter.Value>
                <StaticResource ResourceKey="PaddingMedium" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                            <Canvas x:Name="RippleOverlay"
                                    Background="Transparent"
                                    IsHitTestVisible="False"
                                    ClipToBounds="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background"
                                    Value="{DynamicResource PrimaryVariantBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Background"
                                    Value="{DynamicResource PrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="behaviors:RippleBehavior.IsEnabled" Value="True" />
    </Style>

    <!-- 危险操作按钮:ErrorBrush 红色背景,用于卸载/删除等不可逆操作。
         跟 MaterialButton 同结构(Style Setter 必须 property-element + DynamicResource
         才能跨 merged dict 解析 — v0.6.9.2 hotfix 教训)。ControlTemplate.Triggers 内的
         Setter Value 用 DynamicResource attribute 是允许的(trigger 自己处理 lookup)。 -->
    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="Background">
            <Setter.Value>
                <DynamicResource ResourceKey="ErrorBrush" />
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground">
            <Setter.Value>
                <DynamicResource ResourceKey="OnPrimaryBrush" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding">
            <Setter.Value>
                <StaticResource ResourceKey="PaddingMedium" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                            <Canvas x:Name="RippleOverlay"
                                    Background="Transparent"
                                    IsHitTestVisible="False"
                                    ClipToBounds="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background"
                                    Value="{DynamicResource ErrorVariantBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Background"
                                    Value="{DynamicResource ErrorBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="behaviors:RippleBehavior.IsEnabled" Value="True" />
    </Style>

    <!-- v0.6.9.3 T3:透明图标按钮,hover/pressed 颜色随当前 palette 动态切换。 -->
    <Style x:Key="GearIconButtonStyle" TargetType="Button"
           BasedOn="{StaticResource MaterialButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background"
                                    Value="{DynamicResource PrimaryVariantBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Background"
                                    Value="{DynamicResource PrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- v0.6.9.3 T4:透明 ToggleButton 风格 — SunMoonIconButton 用。
         跟 GearIconButtonStyle 结构同款,只换 TargetType=ToggleButton(ToggleButton
         不是 Button 子类,所以 BasedOn={MaterialButton TargetType=Button} 不行 —
         必须独立定义。ControlTemplate 内部跟 Button 版一致。 -->
    <Style x:Key="SunMoonIconButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background"
                                    Value="{DynamicResource PrimaryVariantBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Background"
                                    Value="{DynamicResource PrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="RootBorder" Property="Background"
                                    Value="{DynamicResource PrimaryVariantBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource SurfaceBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource PrimaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox 样式(v0.6.9.2 hotfix:同 MaterialButton — Setter Value attribute 的
         {StaticResource SecondaryBrush} 跨 merged-dict 解析失败,BorderBrush 变 UnsetValue,
         模板加载时 Border 的 BorderBrush="{TemplateBinding BorderBrush}" 拿 UnsetValue →
         SetValue 抛 "UnsetValue 不是 BorderBrush 的有效值"。任何含 MaterialTextBox 的
         view(Settings / EnvironmentList / BaseEnvProfilePicker / CreateEnvDialog 等)
         在 UI 首次加载即崩。修法 = property-element + DynamicResource。PaddingSmall
         留 StaticResource(Thickness 在本 Theme.xaml 内同 dict,无跨 dict 问题)。 -->
    <Style x:Key="MaterialTextBox" TargetType="TextBox">
        <Setter Property="Padding" Value="{StaticResource PaddingSmall}" />
        <Setter Property="BorderBrush">
            <Setter.Value>
                <DynamicResource ResourceKey="SecondaryBrush" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Catalog 磁贴视图:WrapPanel + 详细卡片 -->
    <ItemsPanelTemplate x:Key="CatalogTileWrapPanel">
        <WrapPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <!-- ListBoxItem 容器:去掉默认蓝色高亮,改成细边框 hover/selected 反馈。
         用于 Catalog 磁贴视图,让 tile 可被点击并触发 selection。 -->
    <Style x:Key="CatalogTileItemContainerStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="2"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource PrimaryVariantBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource PrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="CatalogTileTemplate">
        <Border Width="320" Margin="8" Padding="12"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Package}" FontWeight="Bold" FontSize="16"
                               Foreground="{DynamicResource OnSurfaceBrush}"
                               VerticalAlignment="Center" />
                    <!-- v0.6.15: 已下载 badge — Source="download" sentinel 行存在时显示。 -->
                    <Border Grid.Column="1" Padding="6,2" CornerRadius="3"
                            Background="{DynamicResource SecondaryBrush}"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsInLocalNodeDb, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="已下载" FontSize="10"
                                   Foreground="{DynamicResource OnPrimaryBrush}" />
                    </Border>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                    <TextBlock Text="{Binding RawMetadata[author]}"
                               Foreground="{DynamicResource OutlineBrush}" />
                    <TextBlock Text=" · " Foreground="{DynamicResource OutlineBrush}" />
                    <TextBlock Text="⭐" />
                    <TextBlock Text="{Binding RawMetadata[stars]}" />
                </StackPanel>
                <TextBlock Text="{Binding RawMetadata[description]}"
                           TextWrapping="Wrap" MaxHeight="60"
                           TextTrimming="CharacterEllipsis"
                           FontSize="12" Margin="0,0,0,8"
                           Foreground="{DynamicResource OnSurfaceBrush}" />
                <Button Content="下载" HorizontalAlignment="Right"
                        Command="{Binding DataContext.DownloadCommand,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding IsInLocalNodeDb, Converter={StaticResource InverseBool}}"
                        Style="{StaticResource MaterialButton}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- v0.6.11+ Catalog polish:视图切换 segmented control。
         RadioButton 共用 GroupName,选中态 PrimaryBrush 背景。
         必须 property-element + DynamicResource 跨 merged dict 解析(v0.6.9.2 教训)。 -->
    <Style x:Key="CatalogSegmentedRadioButton" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground">
            <Setter.Value>
                <DynamicResource ResourceKey="OnSurfaceBrush" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinWidth" Value="60" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background"
                                    Value="{DynamicResource BackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="RootBorder" Property="Background"
                                    Value="{DynamicResource PrimaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- v0.6.11+ Catalog polish:install_type pill badge。
         SecondaryBrush 背景,OnPrimaryBrush 文字。 -->
    <Style x:Key="CatalogInstallTypeBadgeStyle" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <DynamicResource ResourceKey="SecondaryBrush" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- v0.6.11+ Catalog polish:详情面板版本下拉。
         自定义 Background( SurfaceBrush)/ BorderBrush( SecondaryBrush)/ BorderThickness(1px)/
         Padding / MinHeight / Foreground — 不重写 ControlTemplate(代价大),沿用 WPF 默认
         ToggleButton+Popup 视觉。Border 圆角需要 retemplating,brief 已 decline。
         Editable=False 简化路径 — SelectedVersion 用法不要求可编辑。 -->
    <Style x:Key="CatalogVersionComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background">
            <Setter.Value>
                <DynamicResource ResourceKey="SurfaceBrush" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
            <Setter.Value>
                <DynamicResource ResourceKey="SecondaryBrush" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Foreground">
            <Setter.Value>
                <DynamicResource ResourceKey="OnSurfaceBrush" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- v0.6.11+ Catalog polish:列表卡片容器。
         跟 EnvironmentListView.xaml:209-223 同款 pattern。
         Background=Transparent + 0 padding + 0,0,0,8 margin。
         Template 仅 ContentPresenter,去默认蓝色高亮。 -->
    <Style x:Key="CatalogCardItemContainerStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- v0.6.11+ Catalog polish:列表卡片内容模板。
         跟 EnvironmentListView.xaml:225-409 env-card 风格一致。
         选中态 BorderBrush=PrimaryBrush + BorderThickness=2 + Padding=11(抵消 1px 视觉偏移)。
         install_type pill badge 用 CatalogInstallTypeBadgeStyle。 -->
    <DataTemplate x:Key="CatalogRowCardTemplate">
        <Border Padding="12" CornerRadius="6"
                Background="{DynamicResource SurfaceBrush}"
                BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
                    <Style.Triggers>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <Binding Path="IsSelected"
                                         RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                            </DataTrigger.Binding>
                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            <Setter Property="BorderThickness" Value="2" />
                            <Setter Property="Padding" Value="11" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Row 0: Package + ⭐ -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Package}"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource OnSurfaceBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RawMetadata[stars]}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="⭐ " FontSize="12"
                                   Foreground="{DynamicResource OutlineBrush}" />
                        <TextBlock Text="{Binding RawMetadata[stars]}"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource OnSurfaceBrush}" />
                    </StackPanel>
                </Grid>
                <!-- Row 1: 作者 + install_type pill -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{Binding Author}"
                               FontSize="12"
                               Foreground="{DynamicResource OutlineBrush}" />
                    <Border Style="{StaticResource CatalogInstallTypeBadgeStyle}">
                        <TextBlock Text="{Binding InstallType}"
                                   FontSize="10"
                                   Foreground="{DynamicResource OnPrimaryBrush}" />
                    </Border>
                </StackPanel>
                <!-- Row 2: 描述摘要 -->
                <TextBlock Grid.Row="2" Text="{Binding Description}"
                           FontSize="12" Margin="0,6,0,0"
                           TextWrapping="Wrap" MaxHeight="40"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource OnSurfaceBrush}" />
                <!-- Row 3 (v0.6.11+ SDD A): latest 版本 + tooltip -->
                <TextBlock Grid.Row="3"
                           FontSize="12" Margin="0,6,0,0"
                           Foreground="{DynamicResource OnSurfaceBrush}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="非 GitHub 源或尚未刷新时无法自动获取版本">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <!-- 绑定放进 base Setter(property-element 形态),让 trigger 可以 override
                                 (v0.6.9.2 convention:本地 TextBlock.Text 在 DP 优先级中高于 Style trigger Setter) -->
                            <Setter Property="Text">
                                <Setter.Value>
                                    <Binding Path="LatestVersion"
                                             StringFormat="latest: {0}"
                                             TargetNullValue="latest: —" />
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <!-- 空串走同一 fallback 文本 -->
                                <DataTrigger Binding="{Binding LatestVersion}" Value="">
                                    <Setter Property="Text" Value="latest: —" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>