<UserControl x:Class="ComfyUI.Manager.Controls.SpotlightSearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ComfyUI.Manager.ViewModels"
             xmlns:search="clr-namespace:ComfyUI.Manager.Search"
             d:DataContext="{d:DesignInstance Type=vm:SpotlightSearchViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="300" Background="{DynamicResource SurfaceBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Compact search box (always visible) -->
        <Border Grid.Row="0" CornerRadius="4" Padding="8,4" Margin="8,8,8,4"
                Background="{DynamicResource BackgroundBrush}"
                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
            <DockPanel>
                <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="Gray" />
                <TextBox x:Name="QueryBox" BorderThickness="0" Background="Transparent"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnKeyDown" />
            </DockPanel>
        </Border>

        <!-- Popup -->
        <Popup x:Name="ResultsPopup" PlacementTarget="{Binding ElementName=QueryBox}"
               Placement="Bottom" StaysOpen="False" Width="600" Height="400"
               IsOpen="{Binding IsOpen}">
            <Border Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="8">
                <Grid>
                    <!-- "Loading..." -->
                    <TextBlock Text="加载中..." Foreground="Gray"
                               Visibility="{Binding IsBuilding, Converter={StaticResource BoolToVisibility}}" />
                    <!-- "Unavailable" -->
                    <TextBlock Text="⚠ 搜索不可用" Foreground="#FF6B6B"
                               Visibility="{Binding IsUnavailable, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Result ListBox -->
                    <ListBox x:Name="ResultsListBox"
                             ItemsSource="{Binding Results}"
                             SelectedIndex="{Binding SelectedIndex}"
                             Visibility="{Binding Results.Count, Converter={StaticResource ZeroCountToVisibility}}"
                             Background="Transparent" BorderThickness="0"
                             MouseDoubleClick="OnListDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="{Binding Entry.DisplayName}" FontWeight="Bold" MinWidth="200" />
                                    <TextBlock Text="{Binding Entry.Kind}" Foreground="{DynamicResource PrimaryBrush}" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding Score}" Foreground="Gray" Margin="8,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>