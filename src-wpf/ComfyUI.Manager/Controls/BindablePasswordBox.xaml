<!-- v0.6.21 T3 (R1):BindablePasswordBox 默认 ControlTemplate。
     PasswordBox 不暴露 Password DP,所以在模板里同时声明 PasswordBox(掩码态)+ TextBox(明文态),
     用 IsPasswordRevealed DP 切换 Visibility。template part 同步逻辑在 BindablePasswordBox.xaml.cs。
     显式在本 dict 注册 converters,不依赖 Theme.xaml 顺序 — WPF StaticResource 跨 merged dict
     解析在某些场景下(尤其 SettingsViewLoadTests 通过 Application.Current.Resources 增量
     加载 Theme.xaml)拿不到 sibling 资源,inline converter 是最稳的做法。

     R1 fix:模板右侧加 ToggleButton(👁 Path icon,不是 emoji — v0.6.17.1 lesson 字体可能
     落不到 emoji glyph),TwoWay 绑 IsPasswordRevealed DP,所以 BindablePasswordBox
     默认就会有 reveal toggle,SettingsView.xaml.cs 不需要 hook RevealPassword/HidePassword。
     ⚠ ToggleButton 不显式引用 Style="{StaticResource MaterialButton}" — 同上 SR 跨 merged
     dict 不能解析 Theme.xaml 资源(tests fail: "无法找到名为 MaterialButton 的资源")。
     用默认 ToggleButton 外观 + 紧凑 Padding(6,2) + 16x16 Viewbox Path icon 就够清晰。
     30s auto-rehide(spec line 334)YAGNI v0.6.21 — explicit click-to-hide 够用。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ComfyUI.Manager.Controls"
                    xmlns:views="clr-namespace:ComfyUI.Manager.Views">

    <BooleanToVisibilityConverter x:Key="LocalBoolToVisibility" />
    <views:InverseBoolToVisibilityConverter x:Key="LocalInverseBoolToVisibility" />

    <Style TargetType="{x:Type local:BindablePasswordBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:BindablePasswordBox}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <PasswordBox x:Name="InnerPasswordBox"
                                         Visibility="{Binding IsPasswordRevealed, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LocalInverseBoolToVisibility}}"
                                         FontFamily="Consolas" />
                            <TextBox x:Name="InnerTextBox"
                                     Text="{Binding Password, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas"
                                     Visibility="{Binding IsPasswordRevealed, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LocalBoolToVisibility}}" />
                        </Grid>
                        <ToggleButton Grid.Column="1" x:Name="RevealToggle"
                                      IsChecked="{Binding IsPasswordRevealed, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      ToolTip="显示/隐藏 token"
                                      Padding="6,2" Margin="4,0,0,0" MinWidth="0" MinHeight="0">
                            <Viewbox Width="16" Height="16">
                                <Path Fill="{DynamicResource OnSurfaceBrush}"
                                      Data="M12,5 c-3.5,0 -6.4,2.7 -8,7 c1.6,4.3 4.5,7 8,7 c3.5,0 6.4,-2.7 8,-7 c-1.6,-4.3 -4.5,-7 -8,-7 Z M12,9 c1.7,0 3,1.3 3,3 c0,1.7 -1.3,3 -3,3 c-1.7,0 -3,-1.3 -3,-3 c0,-1.7 1.3,-3 3,-3 Z" />
                            </Viewbox>
                        </ToggleButton>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>