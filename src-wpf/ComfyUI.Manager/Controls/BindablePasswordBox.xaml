<!-- v0.6.21 T3:BindablePasswordBox 默认 ControlTemplate。
     PasswordBox 不暴露 Password DP,所以在模板里同时声明 PasswordBox(掩码态)+ TextBox(明文态),
     用 IsPasswordRevealed DP 切换 Visibility。template part 同步逻辑在 BindablePasswordBox.xaml.cs。
     显式在本 dict 注册 converters,不依赖 Theme.xaml 顺序 — WPF StaticResource 跨 merged dict
     解析在某些场景下(尤其 SettingsViewLoadTests 通过 Application.Current.Resources 增量
     加载 Theme.xaml)拿不到 sibling 资源,inline converter 是最稳的做法。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ComfyUI.Manager.Controls"
                    xmlns:views="clr-namespace:ComfyUI.Manager.Views">

    <BooleanToVisibilityConverter x:Key="LocalBoolToVisibility" />
    <views:InverseBoolToVisibilityConverter x:Key="LocalInverseBoolToVisibility" />

    <Style TargetType="{x:Type local:BindablePasswordBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:BindablePasswordBox}">
                    <Grid>
                        <PasswordBox x:Name="InnerPasswordBox"
                                     Visibility="{Binding IsPasswordRevealed, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LocalInverseBoolToVisibility}}"
                                     FontFamily="Consolas" />
                        <TextBox x:Name="InnerTextBox"
                                 Text="{Binding Password, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas"
                                 Visibility="{Binding IsPasswordRevealed, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LocalBoolToVisibility}}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>