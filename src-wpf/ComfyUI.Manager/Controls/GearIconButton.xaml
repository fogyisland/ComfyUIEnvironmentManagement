<!-- v0.6.9.3 T3:可复用的透明齿轮设置按钮。 -->
<UserControl x:Class="ComfyUI.Manager.Controls.GearIconButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="32" Height="32">
    <Button Command="{Binding Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
            ToolTip="{Binding ToolTip, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Style="{StaticResource GearIconButtonStyle}">
        <Viewbox Width="20" Height="20">
            <Grid Width="24" Height="24">
                <Path Fill="{DynamicResource OnSurfaceBrush}"
                      Data="M12,8 L16,8 L17,11 L20,12 L17,13 L16,16 L12,16 L11,13 L8,12 L11,11 Z" />
                <Ellipse Width="6" Height="6"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Fill="{DynamicResource SurfaceBrush}" />
            </Grid>
        </Viewbox>
    </Button>
</UserControl>
