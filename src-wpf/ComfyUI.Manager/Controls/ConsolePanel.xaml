<UserControl x:Class="ComfyUI.Manager.Controls.ConsolePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
    v1.0.0.x #590:5 处复制粘贴 console 面板抽取到一处。terminal 风格:
    - Dark/Light 都用 ConsoleBackgroundBrush 深灰底 + ConsoleHeaderBrush header strip +
      ConsoleForegroundBrush 浅字(模仿 cmd / PowerShell 终端)。
    - Title DP 默认 "Console",可改用于 "Console (model)" / "Console (workflow)" 等场景。
    - ConsoleCloseRequested RoutedEvent:用户点 ✕ → parent view code-behind 调 VM.ClearConsoleLog。
    - Auto-scroll 自管:订阅 Lines.CollectionChanged → ScrollToEnd,parent 不再需要 hook/unhook。
    -->
    <Border Background="{DynamicResource ConsoleBackgroundBrush}"
            BorderBrush="{DynamicResource ConsoleHeaderBrush}" BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="12,8,8,4"
                       Background="{DynamicResource ConsoleHeaderBrush}">
                <Button DockPanel.Dock="Right" Content="✕"
                        Style="{StaticResource GearIconButtonStyle}"
                        Foreground="{DynamicResource ConsoleForegroundBrush}"
                        Click="OnCloseClicked"
                        ToolTip="关闭 Console(下次自动重新打开时再次显示)" />
                <TextBlock VerticalAlignment="Center" FontWeight="Bold" FontSize="13"
                           Foreground="{DynamicResource ConsoleForegroundBrush}"
                           FontFamily="Consolas, Cascadia Mono, monospace">
                    <Run Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" />
                    <Run Text="  " />
                    <Run Text="{Binding Lines.Count, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay, FallbackValue=0}" FontSize="11"
                         Foreground="{DynamicResource ConsoleAccentBrush}" />
                    <Run Text=" 行" FontSize="11" Foreground="{DynamicResource ConsoleAccentBrush}" />
                </TextBlock>
            </DockPanel>
            <ScrollViewer x:Name="ConsoleScrollViewer" Grid.Row="1"
                          Height="160" Margin="8,0,8,8"
                          Background="{DynamicResource ConsoleBackgroundBrush}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <ItemsControl x:Name="LinesItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas, Cascadia Mono, monospace"
                                       FontSize="11" TextWrapping="NoWrap"
                                       Foreground="{DynamicResource ConsoleForegroundBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>