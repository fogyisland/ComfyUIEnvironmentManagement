<Window x:Class="ComfyUI.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ComfyUI.Manager.Views"
        xmlns:controls="clr-namespace:ComfyUI.Manager.Controls"
        xmlns:behaviors="clr-namespace:ComfyUI.Manager.Behaviors"
        xmlns:models="clr-namespace:ComfyUI.Manager.Models"
        Title="ComfyUI 多环境管理系统" Height="700" Width="1100"
        Background="{DynamicResource BackgroundBrush}"
        Icon="pack://siteoforigin:,,,/asset/icon.png">
    <!-- v0.6.11+ T4:Window.Icon + 侧栏 header Image 同款 pack://siteoforigin scheme。
         asset/** 是 csproj <None> + CopyToOutputDirectory(松散文件),不是编译进
         assembly 的 <Resource>,application: scheme 会抛 IOException 找不到资源。
         Window.Icon 解析失败 XAML parse 立刻抛(不像 Image.Source 走 ImageFailed 静默),
         所以必须指向真实存在的文件。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 顶部菜单条 + 设置/主题快捷入口(v0.6.9.3 T3+T4)。
             v0.6.9.3 T4:删 _设置(_S) MenuItem — 齿轮按钮已独占设置入口,
             保留一个空 Menu 没必要(mnemonic 跟着菜单项走)。同时把 ThemeToggleButton 跟
             GearIconButton 并排右侧,ThemeToggleButton 在左(更显眼),GearIconButton 在右。 -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Menu Grid.Column="0">
                <MenuItem Header="_文件(_F)">
                    <MenuItem Header="_保存环境..."
                              Command="{Binding SaveUiPreferencesCommand}" />
                    <MenuItem Header="_加载环境..."
                              Command="{Binding LoadUiPreferencesCommand}" />
                    <Separator />
                    <MenuItem Header="打开项目文件夹"
                              Command="{Binding OpenProjectFolderCommand}" />
                    <MenuItem Header="赞助作者..."
                              Command="{Binding ShowDonateQrCommand}" />
                    <Separator />
                    <MenuItem Header="_退出"
                              Command="{Binding ExitAppCommand}" />
                </MenuItem>
                <!-- TODO(resx): 工具菜单硬编码中文,后续 spec 应统一抽 resx。 -->
                <MenuItem Header="_工具(_T)">
                    <MenuItem Header="_打开 ComfyUI 设置..."
                              Command="{Binding OpenComfySettingsJsonCommand}"
                              InputGestureText="comfy.settings.json" />
                    <MenuItem Header="_打开 Models 配置..."
                              Command="{Binding OpenExtraModelPathsYamlCommand}"
                              InputGestureText="extra_model_paths.yaml" />
                    <Separator />
                    <MenuItem Header="打开日志目录"
                              Command="{Binding OpenLogFolderCommand}" />
                </MenuItem>
                <MenuItem Header="_关于(_H)">
                    <MenuItem Header="关于..."
                              Command="{Binding ShowAboutCommand}" />
                </MenuItem>
            </Menu>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <controls:ThemeToggleButton Margin="0,0,4,0" />
                <controls:GearIconButton Command="{Binding ShowSettingsCommand}"
                                         ToolTip="{x:Static models:MainWindowLocalizable.GearButtonTooltip}" />
            </StackPanel>
        </Grid>

        <!-- 侧边栏 -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                Padding="12">
            <StackPanel>
                <!-- v0.6.12+:删侧栏 header (24×24 icon + "ComfyUI 多环境管理系统" 标题)。
                     asset/icon.png 是 ComfyUI 官方"4 个 logo 集合参考图",24×24 看着像被
                     清除;TextBlock 标题跟 Window.Title + 顶部状态栏重复。Logo 仅保留
                     Window.Icon(任务栏 EXE icon)。 -->
                <!-- v0.6.9 T7:替换 T3 加的 SearchBoxPlaceholder 为可用的 SpotlightSearchBox。
                     DataContext 绑 MainViewModel.Spotlight(懒构造 VM)。Ctrl+K 由 MainWindow.OnLoaded
                     在 Loaded 后注入 KeyBinding,直接触发 MainViewModel.OpenSpotlightCommand。 -->
                <controls:SpotlightSearchBox
                    DataContext="{Binding Spotlight}"
                    Margin="0,0,0,12" />
                <RadioButton Content="主页" GroupName="SidebarNav"
                             Command="{Binding ShowDashboardCommand}"
                             IsChecked="{Binding CurrentSection, Converter={StaticResource SectionEquality}, ConverterParameter=Dashboard, Mode=OneWay}"
                             Style="{StaticResource SidebarRadioButtonStyle}" />
                <RadioButton Content="环境" GroupName="SidebarNav"
                             Command="{Binding ShowEnvironmentsCommand}"
                             IsChecked="{Binding CurrentSection, Converter={StaticResource SectionEquality}, ConverterParameter=Environments, Mode=OneWay}"
                             Style="{StaticResource SidebarRadioButtonStyle}" />
                <RadioButton Content="节点目录" GroupName="SidebarNav"
                             Command="{Binding ShowCatalogCommand}"
                             IsChecked="{Binding CurrentSection, Converter={StaticResource SectionEquality}, ConverterParameter=Catalog, Mode=OneWay}"
                             Style="{StaticResource SidebarRadioButtonStyle}" />
                <RadioButton Content="设置" GroupName="SidebarNav"
                             Command="{Binding ShowSettingsCommand}"
                             IsChecked="{Binding CurrentSection, Converter={StaticResource SectionEquality}, ConverterParameter=Settings, Mode=OneWay}"
                             Style="{StaticResource SidebarRadioButtonStyle}" />
                <RadioButton Content="批量更新" GroupName="SidebarNav"
                             Command="{Binding OpenBulkUpdateCommand}"
                             IsChecked="{Binding CurrentSection, Converter={StaticResource SectionEquality}, ConverterParameter=BulkUpdate, Mode=OneWay}"
                             Style="{StaticResource SidebarRadioButtonStyle}" />
                <RadioButton Content="系统状态" GroupName="SidebarNav"
                             Command="{Binding ShowSystemStatusCommand}"
                             IsChecked="{Binding CurrentSection, Converter={StaticResource SectionEquality}, ConverterParameter=SystemStatus, Mode=OneWay}"
                             Style="{StaticResource SidebarRadioButtonStyle}" />
                <controls:GearIconButton Command="{Binding ShowSettingsCommand}"
                                         ToolTip="{x:Static models:MainWindowLocalizable.GearButtonTooltip}"
                                         Margin="0,16,0,0"
                                         HorizontalAlignment="Right" />
            </StackPanel>
        </Border>

        <!-- 内容区(v0.6.9 T8:加 ViewFadeTransitionBehavior,CurrentView 切换时 200ms fade) -->
        <ContentControl Grid.Row="1" Grid.Column="1"
                        Content="{Binding CurrentView}"
                        behaviors:ViewFadeTransitionBehavior.IsEnabled="True" />

        <!-- 底部 ErrorBanner -->
        <views:ErrorBanner Grid.Row="2" Grid.ColumnSpan="2"
                           DataContext="{Binding ErrorBanner}"
                           MaxHeight="120" />

        <!-- v0.6.9.3 T2:底部状态栏显示当前页面与版本号。 -->
        <views:StatusBar Grid.Row="3" Grid.ColumnSpan="2"
                         DataContext="{Binding StatusBar}" />

        <!-- v0.6.9 T9:主题切换 cross-fade overlay(z-order 顶层,初始 IsHitTestVisible=False + Opacity=0)。
             MainWindow.xaml.cs 订阅 ThemeService.ThemeChanging 触发 fade-out → ThemeService
             内部 swap palette → fade-in。Rectangle 而非 Grid:不需要布局。Panel.ZIndex=999
             保证在 menu/sidebar/content/error banner 之上。 -->
        <Rectangle x:Name="ThemeCrossfadeOverlay"
                   Fill="{DynamicResource SurfaceBrush}"
                   Opacity="0" IsHitTestVisible="False"
                   Panel.ZIndex="999" />
    </Grid>
</Window>